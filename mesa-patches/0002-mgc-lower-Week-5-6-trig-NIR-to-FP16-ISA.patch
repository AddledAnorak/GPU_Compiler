new file mode 100644
index 0000000..c6bcdae
--- /dev/null
+++ b/src/gallium/drivers/mgc/mgc_test_trig.c
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: MIT
+ * Build a single non-folded NIR expression for each Week 5-6 function.
+ * A literal is deliberately fed directly to mgc_compile_nir: this tests
+ * the backend without requiring the still-missing uniform/attribute path.
+ * The compiler's algebraic lowering expands fsin/fcos; nir_atan is the
+ * exact Mesa builder used by the GLSL frontend.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+#include "compiler/nir/nir_builtin_builder.h"
+#include "compiler/shader_enums.h"
+#include "mgc_compiler.h"
+
+int
+main(int argc, char **argv)
+{
+   if (argc != 3) {
+      fprintf(stderr, "usage: %s <sin|cos|atan|all> <input>\n", argv[0]);
+      return 2;
+   }
+   char *end;
+   float x = strtof(argv[2], &end);
+   if (!*argv[2] || *end) {
+      fprintf(stderr, "invalid float input: %s\n", argv[2]);
+      return 2;
+   }
+
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_FRAGMENT, mgc_test_get_compiler_options(), "mgc_trig_test");
+   nir_def *input = nir_imm_float(&b, x);
+   nir_def *offset = nir_imm_int(&b, 0);
+   if (!strcmp(argv[1], "sin") || !strcmp(argv[1], "all"))
+      nir_store_output(&b, nir_fsin(&b, input), offset, .component = 0);
+   if (!strcmp(argv[1], "cos") || !strcmp(argv[1], "all"))
+      nir_store_output(&b, nir_fcos(&b, input), offset, .component = 1);
+   if (!strcmp(argv[1], "atan") || !strcmp(argv[1], "all"))
+      nir_store_output(&b, nir_atan(&b, input), offset, .component = 2);
+   if (strcmp(argv[1], "sin") && strcmp(argv[1], "cos") &&
+       strcmp(argv[1], "atan") && strcmp(argv[1], "all")) {
+      fprintf(stderr, "unknown operation: %s\n", argv[1]);
+      ralloc_free(b.shader);
+      return 2;
+   }
+
+   struct mgc_shader *shader = mgc_compile_nir(b.shader);
+   if (shader->error) {
+      fprintf(stderr, "%s\n", shader->error);
+      mgc_shader_destroy(shader);
+      return 1;
+   }
+   fputs(shader->asm_text, stdout);
+   mgc_shader_destroy(shader);
+   return 0;
+}
