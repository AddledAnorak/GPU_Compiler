+static bool
+mgc_count_use(nir_src *src, void *data)
+{
+   struct mgc_ctx *ctx = data;
+   if (src->ssa)
+      ctx->uses[src->ssa->index]++;
+   return true;
+}
+
+static bool
+mgc_release_use(nir_src *src, void *data)
+{
+   struct mgc_ctx *ctx = data;
+   if (src->ssa && --ctx->uses[src->ssa->index] == 0) {
+      struct mgc_val v = ctx->vals[src->ssa->index];
+      if (v.kind == MGC_VAL_REG)
+         mgc_free_reg(ctx, v.index);
+   }
+   return true;
 }
 
