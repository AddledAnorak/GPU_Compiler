             goto done;
+         nir_foreach_src(instr, mgc_release_use, &ctx);
+         nir_def *def = nir_instr_def(instr);
+         if (def && ctx.uses[def->index] == 0 &&
+             ctx.vals[def->index].kind == MGC_VAL_REG)
+            mgc_free_reg(&ctx, ctx.vals[def->index].index);
       }
    }
 
