+)
diff --git a/src/gallium/drivers/mgc/mgc_compiler.c b/src/gallium/drivers/mgc/mgc_compiler.c
new file mode 100644
index 0000000..04b12ae
--- /dev/null
+++ b/src/gallium/drivers/mgc/mgc_compiler.c
@@ -0,0 +1,391 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * mgc_compiler.c -- NIR -> MGC-FP16-v1 assembly text. See mgc_compiler.h.
+ *
+ * Scope (Weeks 1-4 plan, Phase 4): the "Direct" arithmetic subset from
+ * docs/isa/nir_opcode_triage.md -- fadd/fsub/fmul/fdiv/fneg/fabs/fmin/fmax/
+ * mov, scalar constants (inlined against the 8-entry constant bank where
+ * they match, docs/isa/isa.yaml lines ~64-77, else a movi_f16 pseudo-op),
+ * and a store_output epilogue writing FP16 pixel channels to the
+ * placeholder framebuffer region (tools/mgcsim/memory.py FRAMEBUFFER_BASE
+ * -- keep these two in sync; see that file's own placeholder-address
+ * disclaimer). Anything else records an error rather than emitting wrong
+ * code.
+ *
+ * Register allocation is deliberately the simplest thing that works: one
+ * MGC scalar register per NIR SSA def, allocated upward from r0, never
+ * freed or reused, hard error past r31 (so the prototype never has to
+ * emit the regbank hi-register prefix). A real allocator is a Week 7-8
+ * concern -- see the plan. Because nir_lower_alu_to_scalar/
+ * nir_lower_load_const_to_scalar already ran (mgc_screen.c's
+ * lower_to_scalar option), and every one of the 8 captured shader traces
+ * fully flattens to a single basic block (see docs/glsl-to-nir/
+ * dictionary.md's 04_conditional/05_loop findings), a straight-line
+ * single-pass walk in source order is sufficient: every SSA def is
+ * produced before it's read.
+ *
+ * wait_* policy: emit the matching wait immediately after every producer
+ * that has a latency class (docs/isa/isa.yaml's latency_classes table).
+ * Trivially correct and a strict superset of what's needed -- mgcsim's
+ * hazard detector (tools/mgcsim/cpu.py) independently validates this by
+ * raising LatencyViolation on anything under-scheduled. The real
+ * scheduler (union wait classes across an instruction's sources, one
+ * wait per distinct class) is Week 5+.
+ */
+
+#include <errno.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "compiler/nir/nir.h"
+#include "compiler/shader_enums.h"
+#include "util/half_float.h"
+#include "util/ralloc.h"
+#include "util/u_debug.h"
+
+#include "mgc_compiler.h"
+
+/* tools/mgcsim/memory.py: FRAMEBUFFER_BASE = 0x100000. Single point of
+ * change if that placeholder ever moves -- see this file's header. */
+#define MGC_FRAMEBUFFER_BASE 0x100000
+
+#define MGC_MAX_REGISTER 31
+
+enum mgc_val_kind {
+   MGC_VAL_REG,
+   MGC_VAL_CONST,
+};
+
+struct mgc_val {
+   enum mgc_val_kind kind;
+   int index; /* register number, or constant-bank index */
+};
+
+struct mgc_ctx {
+   void *mem_ctx;
+   char *asm_text;
+   char *error;
+   int next_reg;
+   struct mgc_val *vals; /* indexed by nir_def::index, size ssa_alloc */
+};
+
+/* The 8 documented constant-bank entries (docs/isa/isa.yaml lines
+ * ~64-77 / FP16_ISA_V1.pdf Table 4), by FP16 bit pattern. */
+static const uint16_t mgc_const_bank[8] = {
+   0xFC00, /* 0: -inf */
+   0xBC00, /* 1: -1.0 */
+   0x0000, /* 2: 0.0  */
+   0x3C00, /* 3: 1.0  */
+   0x3800, /* 4: 0.5  */
+   0x4248, /* 5: pi approximation */
+   0x7C00, /* 6: +inf */
+   0x7E00, /* 7: quiet NaN */
+};
+
+static void
+mgc_error(struct mgc_ctx *ctx, const char *fmt, ...)
+{
+   if (ctx->error)
+      return; /* keep the first error */
+
+   va_list ap;
+   va_start(ap, fmt);
+   ctx->error = ralloc_vasprintf(ctx->mem_ctx, fmt, ap);
+   va_end(ap);
+}
+
+static int
+mgc_alloc_reg(struct mgc_ctx *ctx)
+{
+   if (ctx->next_reg > MGC_MAX_REGISTER) {
+      mgc_error(ctx, "mgc: out of registers (>32 SSA values); register "
+                     "allocation is a Week 7-8 deliverable, see the plan");
+      return 0;
+   }
+   return ctx->next_reg++;
+}
+
+static void
+mgc_val_str(struct mgc_val v, char buf[8])
+{
+   if (v.kind == MGC_VAL_CONST)
+      snprintf(buf, 8, "#%d", v.index);
+   else
+      snprintf(buf, 8, "r%d", v.index);
+}
+
+/* Formats a float the way tools/mgcasm's operand parser expects a literal
+ * immediate: a '.' or exponent must be present, or it parses as an
+ * integer operand instead (assembler.py::_parse_operand). */
+static char *
+mgc_float_literal(void *mem_ctx, float f)
+{
+   char *s = ralloc_asprintf(mem_ctx, "%.9g", f);
+   if (!strpbrk(s, ".eE"))
+      s = ralloc_asprintf(mem_ctx, "%s.0", s);
+   return s;
+}
+
+/* Materializes a float value into a fresh register via the movi_f16
+ * pseudo-op (docs/isa/isa.yaml: no latency_class -- it's a multi-
+ * instruction pseudo-op the assembler expands, not a single hardware op
+ * with a hazard to wait on). */
+static struct mgc_val
+mgc_materialize_f16(struct mgc_ctx *ctx, float f)
+{
+   int reg = mgc_alloc_reg(ctx);
+   char *lit = mgc_float_literal(ctx->mem_ctx, f);
+   ralloc_asprintf_append(&ctx->asm_text, "movi_f16 %s, r%d\n", lit, reg);
+   return (struct mgc_val){ .kind = MGC_VAL_REG, .index = reg };
+}
+
+static void
+mgc_emit_load_const(struct mgc_ctx *ctx, nir_load_const_instr *load)
+{
+   if (load->def.num_components != 1) {
+      mgc_error(ctx, "mgc: load_const with %d components reached the "
+                     "backend -- nir_lower_load_const_to_scalar should "
+                     "have prevented this", load->def.num_components);
+      return;
+   }
+
+   double d = nir_const_value_as_float(load->value[0], load->def.bit_size);
+   float f = (float)d;
+   uint16_t bits = _mesa_float_to_half(f);
+
+   for (int i = 0; i < 8; i++) {
+      if (mgc_const_bank[i] == bits) {
+         ctx->vals[load->def.index] = (struct mgc_val){ .kind = MGC_VAL_CONST, .index = i };
+         return;
+      }
+   }
+
+   ctx->vals[load->def.index] = mgc_materialize_f16(ctx, f);
+}
+
+struct mgc_alu_op_info {
+   nir_op op;
+   const char *mnem;   /* NULL if unsupported */
+   const char *wait;   /* NULL if the op has no latency class */
+   bool commutative;
+};
+
+/* The "Direct" table from docs/isa/nir_opcode_triage.md, restricted to
+ * the arithmetic subset this phase targets. Wait mnemonics transcribed
+ * from docs/isa/isa.yaml's latency_classes (lines ~285-292). */
+static const struct mgc_alu_op_info mgc_alu_ops[] = {
+   { nir_op_fadd, "fadd16", "wait_fadd", true },
+   { nir_op_fsub, "fsub16", "wait_fadd", false },
+   { nir_op_fmul, "fmul16", "wait_fmul", true },
+   { nir_op_fdiv, "fdiv16", "wait_fdiv", false },
+   { nir_op_fmin, "fmin16", "wait_short", true },
+   { nir_op_fmax, "fmax16", "wait_short", true },
+   { nir_op_fneg, "fneg16", NULL, false },
+   { nir_op_fabs, "fabs16", NULL, false },
+   { nir_op_mov,  "copy",   NULL, false },
+};
+
+static const struct mgc_alu_op_info *
+mgc_find_alu_op(nir_op op)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(mgc_alu_ops); i++)
+      if (mgc_alu_ops[i].op == op)
+         return &mgc_alu_ops[i];
+   return NULL;
+}
+
+static void
+mgc_emit_alu(struct mgc_ctx *ctx, nir_alu_instr *alu)
+{
+   const struct mgc_alu_op_info *info = mgc_find_alu_op(alu->op);
+   unsigned num_inputs = nir_op_infos[alu->op].num_inputs;
+
+   if (!info) {
+      mgc_error(ctx, "mgc: unsupported NIR ALU op '%s' -- see "
+                     "docs/isa/nir_opcode_triage.md for which bucket it "
+                     "falls in and what Week it's scoped for",
+                nir_op_infos[alu->op].name);
+      return;
+   }
+   if (alu->def.num_components != 1) {
+      mgc_error(ctx, "mgc: '%s' with %d components reached the backend -- "
+                     "nir_lower_alu_to_scalar should have prevented this",
+                info->mnem, alu->def.num_components);
+      return;
+   }
+
+   int dst = mgc_alloc_reg(ctx);
+
+   if (num_inputs == 1) {
+      /* copy/fabs16/fneg16 all accept a const-bank srcA directly
+       * (isa.yaml: operands: [srcA, dst]), so no swap/materialize logic
+       * is needed here the way the two-operand case below needs it. */
+      struct mgc_val a = ctx->vals[alu->src[0].src.ssa->index];
+      char abuf[8];
+      mgc_val_str(a, abuf);
+      ralloc_asprintf_append(&ctx->asm_text, "%s %s, r%d\n", info->mnem, abuf, dst);
+   } else {
+      struct mgc_val a = ctx->vals[alu->src[0].src.ssa->index];
+      struct mgc_val b = ctx->vals[alu->src[1].src.ssa->index];
+
+      /* Only srcA can be a constant-bank operand (isa.yaml bit 21,
+       * srcA_select). For a commutative op, swap operands so any
+       * constant lands in srcA. For a non-commutative op with the
+       * constant in srcB, materialize it into a register instead. */
+      if (b.kind == MGC_VAL_CONST) {
+         if (info->commutative) {
+            struct mgc_val t = a;
+            a = b;
+            b = t;
+         } else {
+            char lit[8];
+            mgc_val_str(b, lit);
+            /* lit here is "#N"; re-derive the float from the bank table
+             * to materialize it as a real register value. */
+            float f = _mesa_half_to_float(mgc_const_bank[b.index]);
+            b = mgc_materialize_f16(ctx, f);
+         }
+      }
+
+      char abuf[8], bbuf[8];
+      mgc_val_str(a, abuf);
+      mgc_val_str(b, bbuf);
+      ralloc_asprintf_append(&ctx->asm_text, "%s %s, %s, r%d\n",
+                              info->mnem, abuf, bbuf, dst);
+   }
+
+   if (info->wait)
+      ralloc_asprintf_append(&ctx->asm_text, "%s\n", info->wait);
+
+   ctx->vals[alu->def.index] = (struct mgc_val){ .kind = MGC_VAL_REG, .index = dst };
+}
+
+static void
+mgc_emit_store_output(struct mgc_ctx *ctx, nir_intrinsic_instr *intr)
+{
+   if (intr->num_components != 1) {
+      mgc_error(ctx, "mgc: store_output with %d components reached the "
+                     "backend -- nir_lower_io_to_scalar should have "
+                     "prevented this", intr->num_components);
+      return;
+   }
+
+   unsigned component = nir_intrinsic_component(intr);
+   struct mgc_val val = ctx->vals[intr->src[0].ssa->index];
+   char valbuf[8];
+   mgc_val_str(val, valbuf);
+
+   /* One fresh address register per output channel via movi_i32 -- see
+    * this file's header for why FRAMEBUFFER_BASE is hardcoded here.
+    * Simpler and just as correct as sharing one base register plus an
+    * add, and the ISA's 'add' has no immediate form to step by 1
+    * anyway. */
+   int addr_reg = mgc_alloc_reg(ctx);
+   ralloc_asprintf_append(&ctx->asm_text, "movi_i32 %u, r%d\n",
+                           MGC_FRAMEBUFFER_BASE + component, addr_reg);
+   ralloc_asprintf_append(&ctx->asm_text, "store %s, r%d\n", valbuf, addr_reg);
+}
+
+struct mgc_shader *
+mgc_compile_nir(struct nir_shader *nir)
+{
+   struct mgc_shader *shader = rzalloc(NULL, struct mgc_shader);
+   struct mgc_ctx ctx = {
+      .mem_ctx = shader,
+      .asm_text = ralloc_strdup(shader, ""),
+   };
+
+   ralloc_asprintf_append(&ctx.asm_text, "; mgc backend, MGC-FP16-v1, stage=%s\n",
+                           gl_shader_stage_name(nir->info.stage));
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   ctx.vals = rzalloc_array(shader, struct mgc_val, MAX2(impl->ssa_alloc, 1));
+
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr (instr, block) {
+         switch (instr->type) {
+         case nir_instr_type_load_const:
+            mgc_emit_load_const(&ctx, nir_instr_as_load_const(instr));
+            break;
+         case nir_instr_type_alu:
+            mgc_emit_alu(&ctx, nir_instr_as_alu(instr));
+            break;
+         case nir_instr_type_intrinsic: {
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic == nir_intrinsic_store_output &&
+                nir->info.stage == MESA_SHADER_FRAGMENT) {
+               mgc_emit_store_output(&ctx, intr);
+            } else if (intr->intrinsic == nir_intrinsic_store_output) {
+               /* Vertex (or other non-fragment stage) output storage has
+                * no defined destination in this ISA at all -- no memory
+                * map entry, no convention, nothing (OPEN_QUESTIONS.md
+                * item 8). Rather than reject outright and make every
+                * vertex shader unlinkable (gl_Position always needs a
+                * store_output), discard it: a genuine no-op is more
+                * honest than guessing a destination address with no
+                * documentation basis, and it's not the point of interest
+                * for the Weeks 1-4 checkpoint, which is the fragment
+                * arithmetic path. Revisit once Week 5+ defines where
+                * vertex output actually goes. */
+            } else {
+               mgc_error(&ctx, "mgc: unsupported NIR intrinsic '%s' -- "
+                                "out of scope for Weeks 1-4, see the plan",
+                         nir_intrinsic_infos[intr->intrinsic].name);
+            }
+            break;
+         }
+         default:
+            mgc_error(&ctx, "mgc: unsupported NIR instruction type %d",
+                      instr->type);
+            break;
+         }
+         if (ctx.error)
+            goto done;
+      }
+   }
+
+   ralloc_asprintf_append(&ctx.asm_text, "stop_core\n");
+
+done:
+   ralloc_free(nir);
+   shader->nir = NULL;
+
+   if (ctx.error) {
+      shader->error = ctx.error;
+      shader->asm_text = NULL;
+   } else {
+      shader->asm_text = ctx.asm_text;
+   }
+   return shader;
+}
+
+void
+mgc_shader_destroy(struct mgc_shader *shader)
+{
+   ralloc_free(shader);
+}
+
+void
+mgc_maybe_dump_asm(struct mgc_shader *shader, const char *stage_name)
+{
+   const char *dir = getenv("MGC_ASM_DUMP");
+
+   if (!dir || !shader->asm_text)
+      return;
+
+   if (strcmp(dir, "-") == 0) {
+      fprintf(stderr, "%s", shader->asm_text);
+      return;
+   }
+
+   char *path = ralloc_asprintf(NULL, "%s/%s.asm", dir, stage_name);
+   FILE *f = fopen(path, "w");
+   if (f) {
+      fputs(shader->asm_text, f);
+      fclose(f);
+   } else {
+      fprintf(stderr, "mgc: could not write %s: %s\n", path, strerror(errno));
+   }
+   ralloc_free(path);
+}
diff --git a/src/gallium/drivers/mgc/mgc_compiler.h b/src/gallium/drivers/mgc/mgc_compiler.h
new file mode 100644
index 0000000..9799da9
--- /dev/null
+++ b/src/gallium/drivers/mgc/mgc_compiler.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * mgc_compiler.h -- NIR -> MGC-FP16-v1 assembly text translation.
+ * Student B's Week 3-4 deliverable. Scope: the "Direct" arithmetic subset
+ * from docs/isa/nir_opcode_triage.md (fadd/fsub/fmul/fdiv/fneg/fabs/
+ * fmin/fmax/mov, plus scalar constants and a store_output epilogue) --
+ * see the Weeks 1-4 plan, Phase 4.
+ */
+#ifndef MGC_COMPILER_H
+#define MGC_COMPILER_H
+
+struct nir_shader;
+struct nir_shader_compiler_options;
+
+/* mgc_screen.c -- see mgc_test_arith.c for why this is exposed. */
+const struct nir_shader_compiler_options *mgc_test_get_compiler_options(void);
+
+struct mgc_shader {
+   struct nir_shader *nir; /* NULL once compiled -- freed in mgc_compile_nir */
+   char *asm_text;         /* ralloc'd against this struct; NULL on error */
+   char *error;            /* ralloc'd against this struct; NULL on success */
+};
+
+/* Consumes (ralloc_free()s) `nir`. Always returns a valid struct -- check
+ * ->error to see whether ->asm_text is usable. */
+struct mgc_shader *mgc_compile_nir(struct nir_shader *nir);
+
+void mgc_shader_destroy(struct mgc_shader *shader);
+
+/* Writes shader->asm_text to $MGC_ASM_DUMP/<stage>_<name>.asm (or stderr
+ * if MGC_ASM_DUMP=-) when that env var is set. No-op otherwise. */
+void mgc_maybe_dump_asm(struct mgc_shader *shader, const char *stage_name);
+
+#endif
diff --git a/src/gallium/drivers/mgc/mgc_context.c b/src/gallium/drivers/mgc/mgc_context.c
new file mode 100644
index 0000000..1f210a7
--- /dev/null
+++ b/src/gallium/drivers/mgc/mgc_context.c
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * mgc_context.c -- pipe_context creation and the create_fs_state/
+ * create_vs_state hooks where NIR actually reaches the backend. See
+ * docs/driver/gallium-integration.md and the Weeks 1-4 plan, Phase 3/4.
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+#include "compiler/nir/nir.h"
+#include "compiler/glsl_types.h"
+#include "util/u_debug_cb.h"
+#include "util/u_memory.h"
+#include "util/u_upload_mgr.h"
+#include "pipe/p_context.h"
+
+#include "mgc_context.h"
+#include "mgc_compiler.h"
+#include "mgc_resource.h"
+#include "mgc_screen.h"
+
+static int
+mgc_type_size(const struct glsl_type *type, bool bindless)
+{
+   return glsl_count_attribute_slots(type, false);
+}
+
+/* Re-lowers I/O from the deref/variable form st_nir_unlower_io_to_vars
+ * left it in (mgc_screen.c's compiler options leave io_options = 0,
+ * which is what triggers that unlowering) back into the load_input/
+ * store_output intrinsic form mgc_compiler.c walks -- the same path
+ * lima/vc4/etnaviv take. Then scalarizes so mgc_compiler.c never has to
+ * deal with a multi-component value. */
+static struct nir_shader *
+mgc_lower_shader(struct nir_shader *nir)
+{
+   NIR_PASS(_, nir, nir_lower_io,
+            nir_var_shader_in | nir_var_shader_out, mgc_type_size, 0);
+   NIR_PASS(_, nir, nir_lower_io_to_scalar,
+            nir_var_shader_in | nir_var_shader_out, NULL, NULL);
+   NIR_PASS(_, nir, nir_lower_alu_to_scalar, NULL, NULL);
+   NIR_PASS(_, nir, nir_lower_load_const_to_scalar);
+   NIR_PASS(_, nir, nir_copy_prop);
+   NIR_PASS(_, nir, nir_opt_dce);
+   return nir;
+}
+
+static void *
+mgc_create_shader_state(struct pipe_context *pipe,
+                         const struct pipe_shader_state *cso)
+{
+   assert(cso->type == PIPE_SHADER_IR_NIR);
+
+   struct nir_shader *nir = mgc_lower_shader(cso->ir.nir);
+   const char *stage_name =
+      nir->info.stage == MESA_SHADER_FRAGMENT ? "fs" : "vs";
+
+   /* mgc_compile_nir takes ownership of (frees) nir. */
+   struct mgc_shader *shader = mgc_compile_nir(nir);
+
+   if (shader->error) {
+      fprintf(stderr, "mgc: %s\n", shader->error);
+      /* Propagate the failure through the documented pipe_shader_state
+       * contract (p_state.h: "the driver can fail compilation ... store
+       * [the message] in the pointer below") so glLinkProgram actually
+       * fails instead of silently proceeding to a later draw call with
+       * no usable shader -- see i915_state.c/r300_state.c for the same
+       * cast-away-const pattern. Without this, an out-of-scope shader
+       * (e.g. one needing load_input, which Weeks 1-4 doesn't implement)
+       * would report link success and crash on the first draw instead of
+       * failing cleanly at compile time. */
+      struct pipe_shader_state *mut_cso = (struct pipe_shader_state *)cso;
+      if (mut_cso->report_compile_error)
+         mut_cso->error_message = strdup(shader->error);
+   } else {
+      mgc_maybe_dump_asm(shader, stage_name);
+   }
+
+   return shader;
+}
+
+static void
+mgc_bind_shader_state(struct pipe_context *pipe, void *state)
+{
+}
+
+static void
+mgc_delete_shader_state(struct pipe_context *pipe, void *state)
+{
+   mgc_shader_destroy((struct mgc_shader *)state);
+}
+
+static void
+mgc_destroy_context(struct pipe_context *pipe)
+{
+   struct mgc_context *ctx = mgc_context(pipe);
+
+   if (ctx->base.stream_uploader)
+      u_upload_destroy(ctx->base.stream_uploader);
+
+   FREE(ctx);
+}
+
+struct pipe_context *
+mgc_create_context(struct pipe_screen *screen, void *priv, unsigned flags)
+{
+   struct mgc_context *ctx = CALLOC_STRUCT(mgc_context);
+
+   if (!ctx)
+      return NULL;
+
+   ctx->screen = mgc_screen(screen);
+   ctx->base.screen = screen;
+   ctx->base.priv = priv;
+   ctx->base.destroy = mgc_destroy_context;
+
+   ctx->base.create_fs_state = mgc_create_shader_state;
+   ctx->base.bind_fs_state = mgc_bind_shader_state;
+   ctx->base.delete_fs_state = mgc_delete_shader_state;
+   ctx->base.create_vs_state = mgc_create_shader_state;
+   ctx->base.bind_vs_state = mgc_bind_shader_state;
+   ctx->base.delete_vs_state = mgc_delete_shader_state;
+
+   mgc_init_state_funcs(&ctx->base);
+   mgc_init_context_resource_funcs(&ctx->base);
+
+   ctx->base.stream_uploader = u_upload_create_default(&ctx->base);
+   if (!ctx->base.stream_uploader) {
+      FREE(ctx);
+      return NULL;
+   }
+   ctx->base.const_uploader = ctx->base.stream_uploader;
+
+   return &ctx->base;
+}
