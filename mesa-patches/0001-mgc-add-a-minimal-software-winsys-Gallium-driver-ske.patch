index 0000000..4dcd45a
--- /dev/null
+++ b/src/gallium/drivers/mgc/mgc_state.c
@@ -0,0 +1,296 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * mgc_state.c -- trivial state-object plumbing. None of this state is
+ * ever consulted (there is no rasterizer, no blend unit, nothing that
+ * draws) -- it exists purely so cso_context has non-NULL hooks to call.
+ * See src/gallium/auxiliary/cso_cache/cso_context.c: cso_release_all()
+ * calls the bind_* hooks below unconditionally at context teardown with
+ * no NULL checks, which is what makes stubbing "just the ones we use"
+ * unsafe -- this file implements the full required set up front instead.
+ */
+
+#include "util/u_debug_cb.h"
+#include "util/u_inlines.h"
+#include "util/u_memory.h"
+#include "util/u_sampler.h"
+#include "pipe/p_context.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+
+#include "mgc_context.h"
+
+/* ---- Trivial CALLOC/FREE state objects: contents are never read. ---- */
+
+static void
+mgc_bind_dummy_state(struct pipe_context *pipe, void *state)
+{
+}
+
+static void
+mgc_delete_dummy_state(struct pipe_context *pipe, void *state)
+{
+   FREE(state);
+}
+
+static void
+mgc_bind_sampler_states(struct pipe_context *pipe,
+                         enum pipe_shader_type shader,
+                         unsigned start_slot, unsigned num_samplers,
+                         void **samplers)
+{
+}
+
+static void *
+mgc_create_blend_state(struct pipe_context *pipe,
+                        const struct pipe_blend_state *state)
+{
+   return CALLOC(1, 1);
+}
+
+static void *
+mgc_create_sampler_state(struct pipe_context *pipe,
+                          const struct pipe_sampler_state *state)
+{
+   return CALLOC(1, 1);
+}
+
+static void *
+mgc_create_rasterizer_state(struct pipe_context *pipe,
+                             const struct pipe_rasterizer_state *state)
+{
+   return CALLOC(1, 1);
+}
+
+static void *
+mgc_create_depth_stencil_alpha_state(struct pipe_context *pipe,
+                                      const struct pipe_depth_stencil_alpha_state *state)
+{
+   return CALLOC(1, 1);
+}
+
+static void *
+mgc_create_vertex_elements_state(struct pipe_context *pipe,
+                                  unsigned num_elements,
+                                  const struct pipe_vertex_element *elements)
+{
+   return CALLOC(1, 1);
+}
+
+/* ---- Sampler views: minimal, never actually sampled from. ---- */
+
+static struct pipe_sampler_view *
+mgc_create_sampler_view(struct pipe_context *pipe,
+                         struct pipe_resource *texture,
+                         const struct pipe_sampler_view *templat)
+{
+   struct pipe_sampler_view *view = CALLOC_STRUCT(pipe_sampler_view);
+
+   if (!view)
+      return NULL;
+
+   *view = *templat;
+   view->reference.count = 1;
+   view->texture = NULL;
+   pipe_resource_reference(&view->texture, texture);
+   view->context = pipe;
+   return view;
+}
+
+static void
+mgc_sampler_view_destroy(struct pipe_context *pipe,
+                          struct pipe_sampler_view *view)
+{
+   pipe_resource_reference(&view->texture, NULL);
+   FREE(view);
+}
+
+
+/* ---- set_* parameter state: nothing consumes these yet. ---- */
+
+static void
+mgc_set_stencil_ref(struct pipe_context *pipe,
+                     const struct pipe_stencil_ref ref)
+{
+}
+
+static void
+mgc_set_sample_mask(struct pipe_context *pipe, unsigned sample_mask)
+{
+}
+
+static void
+mgc_set_clip_state(struct pipe_context *pipe,
+                    const struct pipe_clip_state *state)
+{
+}
+
+static void
+mgc_set_constant_buffer(struct pipe_context *pipe,
+                         enum pipe_shader_type shader, unsigned index,
+                         bool take_ownership,
+                         const struct pipe_constant_buffer *buf)
+{
+   /* Nothing downstream consumes constant buffers yet, so nothing is
+    * stored per-slot. If the caller transferred ownership of a reference
+    * to us (take_ownership), we must still drop it here or it leaks. */
+   if (take_ownership && buf && buf->buffer) {
+      struct pipe_resource *res = buf->buffer;
+      pipe_resource_reference(&res, NULL);
+   }
+}
+
+static void
+mgc_set_framebuffer_state(struct pipe_context *pipe,
+                           const struct pipe_framebuffer_state *state)
+{
+}
+
+static void
+mgc_set_polygon_stipple(struct pipe_context *pipe,
+                         const struct pipe_poly_stipple *state)
+{
+}
+
+static void
+mgc_set_scissor_states(struct pipe_context *pipe,
+                        unsigned start_slot, unsigned num_scissors,
+                        const struct pipe_scissor_state *state)
+{
+}
+
+static void
+mgc_set_viewport_states(struct pipe_context *pipe,
+                         unsigned start_slot, unsigned num_viewports,
+                         const struct pipe_viewport_state *state)
+{
+}
+
+static void
+mgc_set_sampler_views(struct pipe_context *pipe,
+                       enum pipe_shader_type shader,
+                       unsigned start_slot, unsigned num_views,
+                       unsigned unbind_num_trailing_slots,
+                       struct pipe_sampler_view **views)
+{
+}
+
+static void
+mgc_set_shader_buffers(struct pipe_context *pipe,
+                        enum pipe_shader_type shader,
+                        unsigned start_slot, unsigned count,
+                        const struct pipe_shader_buffer *buffers,
+                        unsigned writable_bitmask)
+{
+}
+
+static void
+mgc_set_shader_images(struct pipe_context *pipe,
+                       enum pipe_shader_type shader,
+                       unsigned start_slot, unsigned count,
+                       unsigned unbind_num_trailing_slots,
+                       const struct pipe_image_view *images)
+{
+}
+
+static void
+mgc_set_vertex_buffers(struct pipe_context *pipe,
+                        unsigned count,
+                        const struct pipe_vertex_buffer *buffers)
+{
+}
+
+/* ---- Rendering entry points: never exercised (no draws in Weeks 1-4's
+ * surfaceless-EGL scope), but must be non-NULL. ---- */
+
+static void
+mgc_draw_vbo(struct pipe_context *pipe,
+             const struct pipe_draw_info *info,
+             unsigned drawid_offset,
+             const struct pipe_draw_indirect_info *indirect,
+             const struct pipe_draw_start_count_bias *draws,
+             unsigned num_draws)
+{
+}
+
+static void
+mgc_clear(struct pipe_context *pipe,
+          unsigned buffers,
+          const struct pipe_scissor_state *scissor_state,
+          const union pipe_color_union *color,
+          double depth,
+          unsigned stencil)
+{
+}
+
+static void
+mgc_flush(struct pipe_context *pipe,
+          struct pipe_fence_handle **fence,
+          unsigned flags)
+{
+   /* Nothing was ever batched -- there is no fence to hand back other
+    * than an always-signaled placeholder. */
+   if (fence)
+      pipe->screen->fence_reference(pipe->screen, fence, NULL);
+}
+
+static void
+mgc_texture_barrier(struct pipe_context *pipe, unsigned flags)
+{
+}
+
+static void
+mgc_memory_barrier(struct pipe_context *pipe, unsigned flags)
+{
+}
+
+void
+mgc_init_state_funcs(struct pipe_context *pipe)
+{
+   pipe->create_blend_state = mgc_create_blend_state;
+   pipe->bind_blend_state = mgc_bind_dummy_state;
+   pipe->delete_blend_state = mgc_delete_dummy_state;
+
+   pipe->create_sampler_state = mgc_create_sampler_state;
+   pipe->bind_sampler_states = mgc_bind_sampler_states;
+   pipe->delete_sampler_state = mgc_delete_dummy_state;
+
+   pipe->create_rasterizer_state = mgc_create_rasterizer_state;
+   pipe->bind_rasterizer_state = mgc_bind_dummy_state;
+   pipe->delete_rasterizer_state = mgc_delete_dummy_state;
+
+   pipe->create_depth_stencil_alpha_state = mgc_create_depth_stencil_alpha_state;
+   pipe->bind_depth_stencil_alpha_state = mgc_bind_dummy_state;
+   pipe->delete_depth_stencil_alpha_state = mgc_delete_dummy_state;
+
+   pipe->create_vertex_elements_state = mgc_create_vertex_elements_state;
+   pipe->bind_vertex_elements_state = mgc_bind_dummy_state;
+   pipe->delete_vertex_elements_state = mgc_delete_dummy_state;
+
+   pipe->create_sampler_view = mgc_create_sampler_view;
+   pipe->sampler_view_destroy = mgc_sampler_view_destroy;
+   /* Matches softpipe (sp_state_sampler.c): must tolerate a NULL view --
+    * st_destroy_context() calls it unconditionally on a handful of
+    * st-internal cached views (e.g. st->pixel_xfer.pixelmap_sampler_view)
+    * that are NULL whenever the corresponding feature was never used. */
+   pipe->sampler_view_release = u_default_sampler_view_release;
+
+   pipe->set_stencil_ref = mgc_set_stencil_ref;
+   pipe->set_sample_mask = mgc_set_sample_mask;
+   pipe->set_clip_state = mgc_set_clip_state;
+   pipe->set_constant_buffer = mgc_set_constant_buffer;
+   pipe->set_framebuffer_state = mgc_set_framebuffer_state;
+   pipe->set_polygon_stipple = mgc_set_polygon_stipple;
+   pipe->set_scissor_states = mgc_set_scissor_states;
+   pipe->set_viewport_states = mgc_set_viewport_states;
+   pipe->set_sampler_views = mgc_set_sampler_views;
+   pipe->set_shader_buffers = mgc_set_shader_buffers;
+   pipe->set_shader_images = mgc_set_shader_images;
+   pipe->set_vertex_buffers = mgc_set_vertex_buffers;
+   pipe->set_debug_callback = u_default_set_debug_callback;
+
+   pipe->draw_vbo = mgc_draw_vbo;
+   pipe->clear = mgc_clear;
+   pipe->flush = mgc_flush;
+   pipe->texture_barrier = mgc_texture_barrier;
+   pipe->memory_barrier = mgc_memory_barrier;
+}
diff --git a/src/gallium/drivers/mgc/mgc_test_arith.c b/src/gallium/drivers/mgc/mgc_test_arith.c
new file mode 100644
index 0000000..92c34a9
--- /dev/null
+++ b/src/gallium/drivers/mgc/mgc_test_arith.c
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * mgc_test_arith.c -- standalone unit test for mgc_compile_nir(), driving
+ * it directly through nir_builder rather than through GLSL. This is
+ * deliberate, not a shortcut: GLSL constant-folds pure-literal arithmetic
+ * before it ever reaches a driver's create_fs_state (confirmed by
+ * shaders/05_loop's trace in docs/glsl-to-nir/dictionary.md, which
+ * collapsed a whole loop to one constant), and Weeks 1-4's backend has no
+ * uniform/attribute support to route a non-constant value through
+ * instead (those are load_ubo_vec4/load_input intrinsics, explicitly out
+ * of scope -- see docs/isa/nir_opcode_triage.md). Building the NIR by
+ * hand is the standard way to unit-test a compiler backend in isolation,
+ * and it's the only way to exercise a real multi-instruction fadd16/
+ * fmul16/fdiv16 chain (plus the wait_* insertion between them) for this
+ * phase. See the Weeks 1-4 plan, Phase 4 verification.
+ *
+ * Computes (2.0 * 3.0 + 0.5) / 2.0 = 3.25 and stores it to
+ * gl_FragColor.r, matching the numeric check in tests/test_backend_e2e.py.
+ */
+
+#include <stdio.h>
+
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+#include "compiler/shader_enums.h"
+
+#include "mgc_compiler.h"
+
+int
+main(void)
+{
+   const struct nir_shader_compiler_options *options =
+      mgc_test_get_compiler_options();
+
+   nir_builder b =
+      nir_builder_init_simple_shader(MESA_SHADER_FRAGMENT, options, "mgc_arith_test");
+
+   nir_def *two_a = nir_imm_float(&b, 2.0f);
+   nir_def *three = nir_imm_float(&b, 3.0f);
+   nir_def *product = nir_fmul(&b, two_a, three); /* 6.0 */
+
+   nir_def *half = nir_imm_float(&b, 0.5f);
+   nir_def *sum = nir_fadd(&b, product, half); /* 6.5 */
+
+   nir_def *two_b = nir_imm_float(&b, 2.0f);
+   nir_def *quotient = nir_fdiv(&b, sum, two_b); /* 3.25 */
+
+   nir_def *offset = nir_imm_int(&b, 0);
+   nir_store_output(&b, quotient, offset, .component = 0);
+
+   struct mgc_shader *shader = mgc_compile_nir(b.shader);
+
+   if (shader->error) {
+      fprintf(stderr, "mgc_test_arith: %s\n", shader->error);
+      mgc_shader_destroy(shader);
+      return 1;
+   }
+
+   fputs(shader->asm_text, stdout);
+   mgc_shader_destroy(shader);
+   return 0;
+}
