diff --git a/src/gallium/drivers/mgc/mgc_resource.c b/src/gallium/drivers/mgc/mgc_resource.c
new file mode 100644
index 0000000..ee45a0d
--- /dev/null
+++ b/src/gallium/drivers/mgc/mgc_resource.c
@@ -0,0 +1,174 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * mgc_resource.c -- malloc-backed pipe_resource. There is no GPU-visible
+ * memory to allocate from (no FPGA, no DRM device yet) -- see
+ * docs/driver/gallium-integration.md section 3. This exists only so the
+ * cso layer and transfer machinery have something non-NULL to operate on;
+ * nothing here is ever actually rendered into for the Weeks 1-4 scope
+ * (surfaceless EGL, no draw calls).
+ */
+
+#include "util/format/u_format.h"
+#include "util/u_inlines.h"
+#include "util/u_memory.h"
+#include "util/u_transfer.h"
+#include "pipe/p_context.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+
+#include "mgc_resource.h"
+
+static uint64_t
+mgc_resource_size(const struct pipe_resource *templat)
+{
+   uint64_t size = (uint64_t)templat->width0 *
+                    MAX2(templat->height0, 1) *
+                    MAX2(templat->depth0, 1) *
+                    MAX2(templat->array_size, 1);
+   if (templat->target != PIPE_BUFFER)
+      size *= util_format_get_blocksize(templat->format);
+   return size;
+}
+
+static struct pipe_resource *
+mgc_resource_create(struct pipe_screen *screen,
+                     const struct pipe_resource *templat)
+{
+   struct mgc_resource *res = CALLOC_STRUCT(mgc_resource);
+
+   if (!res)
+      return NULL;
+
+   res->base = *templat;
+   res->base.screen = screen;
+   pipe_reference_init(&res->base.reference, 1);
+
+   uint64_t size = mgc_resource_size(templat);
+   res->data = align_malloc(size ? size : 1, 64);
+   if (!res->data) {
+      FREE(res);
+      return NULL;
+   }
+
+   return &res->base;
+}
+
+static void
+mgc_resource_destroy(struct pipe_screen *screen, struct pipe_resource *pt)
+{
+   struct mgc_resource *res = mgc_resource(pt);
+
+   align_free(res->data);
+   FREE(res);
+}
+
+static bool
+mgc_can_create_resource(struct pipe_screen *screen,
+                         const struct pipe_resource *templat)
+{
+   return true;
+}
+
+static bool
+mgc_resource_get_handle(struct pipe_screen *screen,
+                         struct pipe_context *context,
+                         struct pipe_resource *resource,
+                         struct winsys_handle *handle,
+                         unsigned usage)
+{
+   /* No external sharing -- nothing to hand out a dmabuf/GEM handle for
+    * yet. */
+   return false;
+}
+
+void
+mgc_init_screen_resource_funcs(struct pipe_screen *screen)
+{
+   screen->resource_create = mgc_resource_create;
+   screen->resource_destroy = mgc_resource_destroy;
+   screen->can_create_resource = mgc_can_create_resource;
+   screen->resource_get_handle = mgc_resource_get_handle;
+}
+
+/* Used for both buffer_map and texture_map -- same signature, same
+ * backing store (a flat malloc'd allocation), so one implementation
+ * covers both. */
+static void *
+mgc_transfer_map(struct pipe_context *pipe,
+                  struct pipe_resource *resource,
+                  unsigned level,
+                  unsigned usage,
+                  const struct pipe_box *box,
+                  struct pipe_transfer **out_transfer)
+{
+   struct mgc_resource *res = mgc_resource(resource);
+   struct pipe_transfer *transfer = CALLOC_STRUCT(pipe_transfer);
+
+   if (!transfer)
+      return NULL;
+
+   transfer->resource = resource;
+   transfer->level = level;
+   transfer->usage = usage;
+   transfer->box = *box;
+
+   if (resource->target == PIPE_BUFFER) {
+      transfer->stride = 0;
+      transfer->layer_stride = 0;
+      *out_transfer = transfer;
+      return (uint8_t *)res->data + box->x;
+   }
+
+   unsigned blocksize = util_format_get_blocksize(resource->format);
+   transfer->stride = resource->width0 * blocksize;
+   transfer->layer_stride = (uintptr_t)transfer->stride * resource->height0;
+   *out_transfer = transfer;
+   return (uint8_t *)res->data +
+          box->z * transfer->layer_stride +
+          box->y * transfer->stride +
+          box->x * blocksize;
+}
+
+static void
+mgc_transfer_unmap(struct pipe_context *pipe, struct pipe_transfer *transfer)
+{
+   FREE(transfer);
+}
+
+static struct pipe_surface *
+mgc_create_surface(struct pipe_context *pipe,
+                    struct pipe_resource *resource,
+                    const struct pipe_surface *templat)
+{
+   struct pipe_surface *surf = CALLOC_STRUCT(pipe_surface);
+
+   if (!surf)
+      return NULL;
+
+   pipe_surface_init(pipe, surf, resource, templat->level, templat->first_layer);
+   surf->format = templat->format;
+   surf->nr_samples = templat->nr_samples;
+   surf->last_layer = templat->last_layer;
+   return surf;
+}
+
+static void
+mgc_surface_destroy(struct pipe_context *pipe, struct pipe_surface *surf)
+{
+   pipe_resource_reference(&surf->texture, NULL);
+   FREE(surf);
+}
+
+void
+mgc_init_context_resource_funcs(struct pipe_context *pipe)
+{
+   pipe->buffer_map = mgc_transfer_map;
+   pipe->texture_map = mgc_transfer_map;
+   pipe->buffer_unmap = mgc_transfer_unmap;
+   pipe->texture_unmap = mgc_transfer_unmap;
+   pipe->transfer_flush_region = u_default_transfer_flush_region;
+   pipe->buffer_subdata = u_default_buffer_subdata;
+   pipe->texture_subdata = u_default_texture_subdata;
+   pipe->create_surface = mgc_create_surface;
+   pipe->surface_destroy = mgc_surface_destroy;
+}
