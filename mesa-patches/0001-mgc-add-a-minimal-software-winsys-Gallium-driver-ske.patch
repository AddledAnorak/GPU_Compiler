--- /dev/null
+++ b/src/gallium/drivers/mgc/mgc_screen.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * mgc: a software-winsys Gallium driver skeleton for the MGC-FP16-v1
+ * micro-GPU (target FPGA, not yet fabricated -- see /docs/isa/isa.yaml).
+ * Modeled on softpipe (src/gallium/drivers/softpipe/) but stripped to the
+ * minimum needed to reach shader compilation: no rasterization, no real
+ * resource storage, no draw module. See docs/driver/gallium-integration.md
+ * and the Weeks 1-4 plan for scope.
+ */
+#ifndef MGC_SCREEN_H
+#define MGC_SCREEN_H
+
+#include "pipe/p_screen.h"
+
+struct sw_winsys;
+
+struct mgc_screen {
+   struct pipe_screen base;
+   struct sw_winsys *winsys;
+};
+
+static inline struct mgc_screen *
+mgc_screen(struct pipe_screen *pscreen)
+{
+   return (struct mgc_screen *)pscreen;
+}
+
+#endif
diff --git a/src/gallium/drivers/mgc/mgc_state.c b/src/gallium/drivers/mgc/mgc_state.c
