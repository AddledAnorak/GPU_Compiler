diff --git a/src/gallium/drivers/mgc/mgc_screen.c b/src/gallium/drivers/mgc/mgc_screen.c
new file mode 100644
index 0000000..61af62b
--- /dev/null
+++ b/src/gallium/drivers/mgc/mgc_screen.c
@@ -0,0 +1,318 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * mgc_screen.c -- pipe_screen implementation. See mgc_screen.h for the
+ * scope note. Caps are set to the minimum needed for a GLES2 context to
+ * come up over a surfaceless EGL device and reach glLinkProgram -- see
+ * docs/driver/gallium-integration.md and the Weeks 1-4 plan's Phase 3.
+ */
+
+#include "compiler/nir/nir.h"
+#include "util/format/u_format.h"
+#include "util/u_memory.h"
+#include "util/u_screen.h"
+#include "pipe/p_defines.h"
+#include "pipe/p_screen.h"
+
+#include "mgc_screen.h"
+#include "mgc_context.h"
+#include "mgc_compiler.h"
+#include "mgc_resource.h"
+#include "mgc_public.h"
+
+static const char *
+mgc_get_vendor(struct pipe_screen *screen)
+{
+   return "BTP";
+}
+
+static const char *
+mgc_get_name(struct pipe_screen *screen)
+{
+   return "mgc";
+}
+
+/* MGC-FP16-v1 compiler options: encodes the ISA gaps documented in
+ * docs/isa/isa.yaml and docs/isa/OPEN_QUESTIONS.md, and the corrected
+ * (against real Mesa 25.2.0 field names) recommendations in
+ * docs/isa/nir_opcode_triage.md. Boolean representation is left at its
+ * default (native 1-bit) -- nothing to set for that, see the triage doc.
+ */
+static const nir_shader_compiler_options mgc_compiler_options = {
+   /* Scalar ISA: the GLSL linker runs nir_lower_alu_to_scalar,
+    * nir_lower_phis_to_scalar, and nir_lower_load_const_to_scalar for us
+    * when this is set (gl_nir_linker.c). */
+   .lower_to_scalar = true,
+   .lower_vector_cmp = true,
+   .lower_fdph = true,
+
+   /* No hardware unit for any of these -- see isa.yaml's opcode map: no
+    * fsqrt/frsq, no sin/cos, no shifter, no FMA. */
+   .lower_fsqrt = true,
+   .lower_sincos = true,
+   .lower_fpow = true,
+   .lower_fmod = true,
+   .lower_ldexp = true,
+   .lower_bitops = true,
+   .lower_bitfield_extract = true,
+   .lower_bitfield_insert = true,
+   .lower_bitfield_reverse = true,
+   .lower_bit_count = true,
+   .lower_ifind_msb = true,
+   .lower_ufind_msb = true,
+   .lower_find_lsb = true,
+   .lower_uadd_carry = true,
+   .lower_usub_borrow = true,
+   .lower_mul_high = true,
+   .lower_extract_byte = true,
+   .lower_extract_word = true,
+   .lower_insert_byte = true,
+   .lower_insert_word = true,
+   .lower_fquantize2f16 = true,
+
+   .lower_flrp16 = true,
+   .lower_flrp32 = true,
+   .lower_flrp64 = true,
+   .lower_fdiv = false, /* we HAVE fdiv16 */
+   .lower_ffma16 = true, /* no FMA op -- confirmed live in shaders/06_builtin_math's `* 0.5 + 0.5` */
+   .lower_ffma32 = true,
+   .lower_ffma64 = true,
+   .lower_fsat = true, /* 2-instruction fmax16/fmin16 sequence, see nir_opcode_triage.md */
+   .lower_scmp = true,
+   .lower_fisnormal = true,
+
+   .lower_int64_options = ~0,
+   .lower_doubles_options = ~0,
+
+   .support_16bit_alu = true,
+
+   .max_unroll_iterations = 32,
+   .lower_uniforms_to_ubo = true,
+};
+
+static const struct nir_shader_compiler_options *
+mgc_get_compiler_options(struct pipe_screen *pscreen,
+                          enum pipe_shader_type shader)
+{
+   return &mgc_compiler_options;
+}
+
+/* Exposes the options struct above to mgc_test_arith.c (a standalone NIR-
+ * builder-based unit test for mgc_compile_nir, bypassing GLSL entirely --
+ * see that file for why: GLSL constant-folds pure-literal arithmetic
+ * before it ever reaches a driver). Not part of the pipe_screen vtable. */
+const struct nir_shader_compiler_options *
+mgc_test_get_compiler_options(void)
+{
+   return &mgc_compiler_options;
+}
+
+static bool
+mgc_is_format_supported(struct pipe_screen *screen,
+                         enum pipe_format format,
+                         enum pipe_texture_target target,
+                         unsigned sample_count,
+                         unsigned storage_sample_count,
+                         unsigned bind)
+{
+   const struct util_format_description *desc;
+
+   if (sample_count > 1)
+      return false;
+   if (MAX2(1, sample_count) != MAX2(1, storage_sample_count))
+      return false;
+
+   desc = util_format_description(format);
+   if (!desc)
+      return false;
+
+   /* No decode hardware for compressed formats. */
+   if (desc->layout == UTIL_FORMAT_LAYOUT_ASTC ||
+       desc->layout == UTIL_FORMAT_LAYOUT_ATC ||
+       desc->layout == UTIL_FORMAT_LAYOUT_ETC)
+      return false;
+
+   if ((bind & PIPE_BIND_DEPTH_STENCIL) &&
+       desc->colorspace != UTIL_FORMAT_COLORSPACE_ZS)
+      return false;
+
+   if ((bind & PIPE_BIND_RENDER_TARGET) &&
+       desc->colorspace == UTIL_FORMAT_COLORSPACE_ZS)
+      return false;
+
+   return true;
+}
+
+static void
+mgc_init_shader_caps(struct mgc_screen *screen)
+{
+   for (unsigned i = 0; i <= PIPE_SHADER_COMPUTE; i++) {
+      struct pipe_shader_caps *caps =
+         (struct pipe_shader_caps *)&screen->base.shader_caps[i];
+
+      /* Only vertex and fragment stages exist -- everything else stays
+       * zeroed, and max_instructions == 0 is the documented "stage
+       * unsupported" signal (p_defines.h), which also switches off the
+       * corresponding bind_*_state calls in cso_release_all. */
+      if (i != PIPE_SHADER_VERTEX && i != PIPE_SHADER_FRAGMENT)
+         continue;
+
+      caps->max_instructions =
+      caps->max_alu_instructions =
+      caps->max_tex_instructions =
+      caps->max_tex_indirections = 16384;
+      caps->max_control_flow_depth = 64;
+      caps->max_inputs = 16;
+      caps->max_outputs = 16;
+      caps->max_const_buffer0_size = 16384;
+      caps->max_const_buffers = 8;
+      caps->max_temps = 256;
+      caps->max_texture_samplers = 8;
+      caps->max_sampler_views = 8;
+      caps->max_shader_buffers = 0;
+      caps->max_shader_images = 0;
+      caps->max_hw_atomic_counters = 0;
+      caps->max_hw_atomic_counter_buffers = 0;
+      caps->integers = true;
+      caps->indirect_temp_addr = true;
+      caps->indirect_const_addr = true;
+      caps->cont_supported = true;
+      /* NIR only -- keeps nir_to_tgsi (and its nir_lower_bool_to_int32
+       * call) out of the picture entirely, per nir_opcode_triage.md. */
+      caps->supported_irs = 1 << PIPE_SHADER_IR_NIR;
+   }
+}
+
+static void
+mgc_init_compute_caps(struct mgc_screen *screen)
+{
+   /* No compute support in this ISA (no compute shader stage in
+    * isa.yaml). Leave struct pipe_compute_caps zeroed. */
+}
+
+static void
+mgc_init_screen_caps(struct mgc_screen *screen)
+{
+   struct pipe_caps *caps = (struct pipe_caps *)&screen->base.caps;
+
+   u_init_pipe_screen_caps(&screen->base, 0);
+
+   /* The two caps compute_version_es2() actually checks for beyond the
+    * two always-on extensions (src/mesa/main/version.c). Get these wrong
+    * and eglCreateContext fails silently with ctx->Version == 0. */
+   caps->npot_textures = true;
+   caps->blend_equation_separate = true;
+
+   caps->max_render_targets = 1;
+   caps->max_texture_2d_size = 2048;
+   caps->max_texture_3d_levels = 8;
+   caps->max_texture_cube_levels = 12;
+   caps->mixed_color_depth_bits = true;
+
+   /* Assumed true so cso_context doesn't layer u_vbuf on top of our
+    * resource stubs (st_context.c passes CSO_NO_64B_VERTEX_BUFFERS for
+    * GLES2, implying user vertex buffers). */
+   caps->user_vertex_buffers = true;
+
+   /* True so glLinkProgram compiles the default FS variant eagerly
+    * instead of deferring to first draw -- that's what makes
+    * create_fs_state actually run for these test shaders, which never
+    * draw. */
+   caps->shareable_shaders = true;
+
+   caps->glsl_feature_level = caps->glsl_feature_level_compatibility = 120;
+   caps->vendor_id = caps->device_id = 0xFFFFFFFF;
+
+   caps->compute = false;
+}
+
+static void
+mgc_destroy_screen(struct pipe_screen *screen)
+{
+   FREE(mgc_screen(screen));
+}
+
+static void
+mgc_flush_frontbuffer(struct pipe_screen *screen,
+                       struct pipe_context *pipe,
+                       struct pipe_resource *resource,
+                       unsigned level, unsigned layer,
+                       void *context_private,
+                       unsigned nboxes,
+                       struct pipe_box *sub_box)
+{
+   /* No presentation path -- see mgc_screen.h scope note. */
+}
+
+static int
+mgc_screen_get_fd(struct pipe_screen *screen)
+{
+   return -1;
+}
+
+static char *
+mgc_finalize_nir(struct pipe_screen *screen, struct nir_shader *nir)
+{
+   /* Returning NULL means "no error" -- a non-NULL ralloc'd string here
+    * makes glLinkProgram fail with our message instead of a crash. The
+    * real translation/validation work happens in mgc_compile_nir(),
+    * called from create_fs_state/create_vs_state (mgc_context.c), which
+    * runs after this hook. */
+   return NULL;
+}
+
+/* No real fence/sync object exists yet -- nothing is ever submitted to
+ * anything (see docs/driver/gallium-integration.md section 3), so there
+ * is nothing to refcount either. Matches softpipe's sw_winsys fence path
+ * (sp_fence.c) exactly: fences are untyped opaque pointers the driver
+ * never dereferences. */
+static void
+mgc_fence_reference(struct pipe_screen *screen,
+                     struct pipe_fence_handle **ptr,
+                     struct pipe_fence_handle *fence)
+{
+   *ptr = fence;
+}
+
+static bool
+mgc_fence_finish(struct pipe_screen *screen,
+                  struct pipe_context *ctx,
+                  struct pipe_fence_handle *fence,
+                  uint64_t timeout)
+{
+   /* Nothing is ever actually outstanding -- every op so far is
+    * synchronous (or a no-op). Always signaled. */
+   return true;
+}
+
+struct pipe_screen *
+mgc_create_screen(struct sw_winsys *winsys)
+{
+   struct mgc_screen *screen = CALLOC_STRUCT(mgc_screen);
+
+   if (!screen)
+      return NULL;
+
+   screen->winsys = winsys;
+
+   screen->base.destroy = mgc_destroy_screen;
+   screen->base.get_name = mgc_get_name;
+   screen->base.get_vendor = mgc_get_vendor;
+   screen->base.get_device_vendor = mgc_get_vendor;
+   screen->base.get_screen_fd = mgc_screen_get_fd;
+   screen->base.get_timestamp = u_default_get_timestamp;
+   screen->base.is_format_supported = mgc_is_format_supported;
+   screen->base.context_create = mgc_create_context;
+   screen->base.flush_frontbuffer = mgc_flush_frontbuffer;
+   screen->base.get_compiler_options = mgc_get_compiler_options;
+   screen->base.finalize_nir = mgc_finalize_nir;
+   screen->base.fence_reference = mgc_fence_reference;
+   screen->base.fence_finish = mgc_fence_finish;
+
+   mgc_init_screen_resource_funcs(&screen->base);
+
+   mgc_init_shader_caps(screen);
+   mgc_init_compute_caps(screen);
+   mgc_init_screen_caps(screen);
+
+   return &screen->base;
+}
diff --git a/src/gallium/drivers/mgc/mgc_screen.h b/src/gallium/drivers/mgc/mgc_screen.h
