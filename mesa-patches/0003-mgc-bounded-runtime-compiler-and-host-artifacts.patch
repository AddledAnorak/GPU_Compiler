+static void
+mgc_emit_host_builtin(struct mgc_ctx *ctx, nir_intrinsic_instr *intr, gl_shader_stage stage)
+{
+   unsigned builtin, word;
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_instance_id: builtin = 0; word = MGC_HOST_INSTANCE_ID_WORD; break;
+   case nir_intrinsic_load_vertex_id: builtin = 1; word = MGC_HOST_VERTEX_ID_WORD; break;
+   case nir_intrinsic_load_base_instance: builtin = 2; word = MGC_HOST_BASE_INSTANCE_WORD; break;
+   case nir_intrinsic_load_draw_id: builtin = 3; word = MGC_HOST_DRAW_ID_WORD; break;
+   case nir_intrinsic_load_front_face: builtin = 5; word = MGC_HOST_FRONT_FACING_WORD; break;
+   default: unreachable("unsupported ABI4 builtin");
+   }
+   if (!ctx->options.host_features_version || intr->def.num_components != 1 ||
+       (builtin < 4 ? (stage != MESA_SHADER_VERTEX || intr->def.bit_size != 32) :
+                      (stage != MESA_SHADER_FRAGMENT || intr->def.bit_size != 1))) {
+      mgc_error(ctx, "mgc: builtin requires ABI4 and the matching scalar shader stage/type");
+      return;
+   }
+   int address = mgc_alloc_reg(ctx);
+   int destination = builtin == 5 ? mgc_alloc_reg(ctx) : mgc_alloc_destination(ctx, &intr->def);
+   ralloc_asprintf_append(&ctx->asm_text, "movi_i32 %u, r%d\nload r%d, r%d\nwait_load\n",
+                           ctx->options.input_base + word, address, address, destination);
+   mgc_free_reg(ctx, address);
+   if (builtin == 5) {
+      unsigned predicate = mgc_alloc_predicate_destination(ctx, &intr->def);
+      int zero = mgc_alloc_reg(ctx);
+      ralloc_asprintf_append(&ctx->asm_text,
+         "movi_i32 0, r%d\nicmp_ne r%d, r%d, cr%u\nwait_short\n", zero, destination, zero, predicate);
+      mgc_free_reg(ctx, zero);
+      mgc_free_reg(ctx, destination);
+      ctx->vals[intr->def.index] = (struct mgc_val){.kind = MGC_VAL_PRED, .index = predicate};
+   } else {
+      ctx->vals[intr->def.index] = (struct mgc_val){.kind = MGC_VAL_REG, .index = destination, .integer = true};
+   }
+   ctx->host_builtin_mask |= 1u << builtin;
+}
