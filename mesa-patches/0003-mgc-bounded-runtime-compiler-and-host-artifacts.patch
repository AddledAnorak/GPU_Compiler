+      mgc_host_texture_wrap_for_axis(reader->abi, 1));
+   if (!wrap_s || !wrap_t)
+      return false;
+   char version_text[16], wrap_s_text[32], wrap_t_text[32], lod_text[16];
+   snprintf(version_text, sizeof(version_text), "%u", version);
+   snprintf(wrap_s_text, sizeof(wrap_s_text), "\"%s\"", wrap_s);
+   snprintf(wrap_t_text, sizeof(wrap_t_text), "\"%s\"", wrap_t);
+   snprintf(lod_text, sizeof(lod_text), "%u", reader->host_texture_lod);
+   const char *names[] = {
+      "\"version\"", "\"texture\"", "\"sampler\"", "\"storage_block\"",
+      "\"max_width\"", "\"max_height\"", "\"filter\"",
+      mixed ? "\"wrap_s\"" : "\"wrap\"", "\"wrap_t\"",
+      "\"lod\"", "\"mip_filter\"", "\"max_levels\"",
+   };
+   const char *values[] = {
+      version_text,
+      "0", "0", "15", "16", "16",
+      mgc_host_texture_is_linear(version) ? "\"linear\"" : "\"nearest\"",
+      wrap_s_text, wrap_t_text, lod_text, "\"nearest\"", "5",
+   };
+   unsigned count = mipmap ? ARRAY_SIZE(names) : mixed ? 9 : 8;
+   for (unsigned index = 0; index < count; index++) {
+      if (!mgc_json_text_equal(key, key_end, names[index]))
+         continue;
+      unsigned bit = 1u << index;
+      if ((reader->texture_metadata & bit) ||
+          !mgc_json_text_equal(value, value_end, values[index]))
+         return false;
+      reader->texture_metadata |= bit;
+      return true;
+   }
+   return false;
+}
