+static unsigned
+mgc_layout_type_mask(nir_alu_type type)
+{
+   switch (nir_alu_type_get_base_type(type)) {
+   case nir_type_float: return 1;
+   case nir_type_int: return 2;
+   case nir_type_uint: return 4;
+   case nir_type_bool: return 8;
+   default: return 0;
+   }
+}
