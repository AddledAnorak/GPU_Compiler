+         mgc_capture_printf(&json,
+            ",\"sampler_state\":{\"normalized_coords\":true,\"min_filter\":\"%s\",\"mag_filter\":\"%s\","
+            "\"mip_filter\":\"%s\",\"wrap_s\":\"%s\",\"wrap_t\":\"%s\"",
