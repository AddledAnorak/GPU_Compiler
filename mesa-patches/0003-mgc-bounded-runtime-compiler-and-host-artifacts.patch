+      bool object = character == '{';
+      char close = object ? '}' : ']';
+      reader->cursor++;
+      mgc_json_space(reader);
+      if (reader->cursor < reader->end && *reader->cursor == close) {
+         reader->cursor++;
+         return true;
+      }
+      for (;;) {
+         const char *key = reader->cursor;
+         const char *key_end = key;
+         if (object) {
+            if (!mgc_json_read_string(reader))
+               return false;
+            key_end = reader->cursor;
+            mgc_json_space(reader);
+            if (reader->cursor == reader->end || *reader->cursor++ != ':')
+               return false;
+         }
+         mgc_json_space(reader);
+         const char *value = reader->cursor;
+         unsigned next_domain = 0;
+         if (object && !depth) {
+            if (mgc_json_text_equal(key, key_end, "\"bases\""))
+               next_domain = 1;
+            else if (mgc_json_text_equal(key, key_end, "\"host_texture\""))
+               next_domain = reader->abi->host_features_version ? 5 : 2;
+            else if (mgc_json_text_equal(key, key_end, "\"fragment_status\""))
+               next_domain = 3;
+            else if (mgc_json_text_equal(key, key_end, "\"host_instancing\""))
+               next_domain = 4;
+         }
+         if (!mgc_json_read_value(reader, depth + 1, next_domain))
+            return false;
+         if (object && !depth &&
+             !mgc_json_metadata(reader, key, key_end, value, reader->cursor))
+            return false;
+         if (object && domain == 1 &&
+             !mgc_json_base_metadata(reader, key, key_end, value, reader->cursor))
+            return false;
+         if (object && domain == 2 &&
+             !mgc_json_texture_metadata(reader, key, key_end, value, reader->cursor))
+            return false;
+         if (object && domain == 3 &&
+             !mgc_json_status_metadata(reader, key, key_end, value, reader->cursor))
+            return false;
+         if (object && domain == 4 &&
+             !mgc_json_instancing_metadata(reader, key, key_end, value, reader->cursor))
+            return false;
+         mgc_json_space(reader);
+         if (reader->cursor == reader->end)
+            return false;
+         character = *reader->cursor++;
+         if (character == close)
+            return true;
+         if (character != ',')
+            return false;
+         mgc_json_space(reader);
+      }
+   }
+   const char *literal = character == 't' ? "true" :
+      character == 'f' ? "false" : character == 'n' ? "null" : NULL;
+   if (literal) {
+      size_t length = strlen(literal);
+      if ((size_t)(reader->end - reader->cursor) < length ||
+          memcmp(reader->cursor, literal, length))
+         return false;
+      reader->cursor += length;
+      return true;
+   }
+   if (character == '-')
+      reader->cursor++;
+   if (reader->cursor == reader->end)
+      return false;
+   if (*reader->cursor == '0') {
+      reader->cursor++;
+   } else {
+      if (*reader->cursor < '1' || *reader->cursor > '9')
+         return false;
+      do {
+         reader->cursor++;
+      } while (reader->cursor < reader->end &&
+               *reader->cursor >= '0' && *reader->cursor <= '9');
+   }
+   if (reader->cursor < reader->end && *reader->cursor == '.') {
+      reader->cursor++;
+      const char *digits = reader->cursor;
+      while (reader->cursor < reader->end &&
+             *reader->cursor >= '0' && *reader->cursor <= '9')
+         reader->cursor++;
+      if (reader->cursor == digits)
+         return false;
+   }
+   if (reader->cursor < reader->end &&
+       (*reader->cursor == 'e' || *reader->cursor == 'E')) {
+      reader->cursor++;
+      if (reader->cursor < reader->end &&
+          (*reader->cursor == '+' || *reader->cursor == '-'))
+         reader->cursor++;
+      const char *digits = reader->cursor;
+      while (reader->cursor < reader->end &&
+             *reader->cursor >= '0' && *reader->cursor <= '9')
+         reader->cursor++;
+      if (reader->cursor == digits)
+         return false;
+   }
+   return true;
+}
+
+static bool
+mgc_capture_texture_options_valid(const struct mgc_compile_options *abi)
+{
+   unsigned version = abi->host_texture_version;
+   if (abi->host_features_version)
+      return abi->host_features_version == MGC_HOST_FEATURES_VERSION &&
+         abi->target == MGC_TARGET_LEGACY && !abi->host_instancing_version &&
+         (!version || (version >= MGC_HOST_TEXTURE_DYNAMIC_VERSION &&
+                       version <= MGC_HOST_TEXTURE_ANISOTROPIC_VERSION)) &&
+         mgc_host_texture_wrap_name(abi->host_texture_wrap_s) &&
+         mgc_host_texture_wrap_name(abi->host_texture_wrap_t) &&
+         abi->input_base == MGC_INPUT_BASE && abi->uniform_base == MGC_UNIFORM_BASE &&
+         abi->vertex_output_base == MGC_VERTEX_OUTPUT_BASE &&
+         abi->fragment_output_base == MGC_FRAGMENT_OUTPUT_BASE &&
+         abi->texture_base == MGC_HOST_TEXTURE_BASE;
+   if (version > MGC_HOST_TEXTURE_LINEAR_MIPMAP_VERSION ||
+       (version && abi->target != MGC_TARGET_LEGACY))
+      return false;
+   if (version != MGC_HOST_TEXTURE_MIXED_VERSION &&
+       version != MGC_HOST_TEXTURE_LINEAR_MIXED_VERSION &&
+       version != MGC_HOST_TEXTURE_MIPMAP_VERSION &&
+       version != MGC_HOST_TEXTURE_LINEAR_MIPMAP_VERSION &&
+       (abi->host_texture_wrap_s != MGC_HOST_WRAP_CLAMP_TO_EDGE ||
+        abi->host_texture_wrap_t != MGC_HOST_WRAP_CLAMP_TO_EDGE))
+      return false;
+   return !version ||
+      (mgc_host_texture_wrap_name(mgc_host_texture_wrap_for_axis(abi, 0)) &&
+       mgc_host_texture_wrap_name(mgc_host_texture_wrap_for_axis(abi, 1)));
+}
+
+static bool
+mgc_capture_layout_valid(const char *layout, size_t length,
+                          const char *program_format, unsigned abi_version,
+                          unsigned stage, const struct mgc_compile_options *abi,
+                          unsigned host_texture_lod, bool uses_host_instance_id,
+                          bool *host_texture, const struct mgc_shader *shader)
+{
+   bool instancing = abi->host_instancing_version == MGC_HOST_INSTANCING_VERSION;
+   bool features = abi->host_features_version == MGC_HOST_FEATURES_VERSION;
+   bool mipmap = abi->host_texture_version == MGC_HOST_TEXTURE_MIPMAP_VERSION ||
+      abi->host_texture_version == MGC_HOST_TEXTURE_LINEAR_MIPMAP_VERSION;
+   if (!mgc_capture_texture_options_valid(abi) ||
+       (abi->host_instancing_version && !instancing) ||
+       (instancing && abi->target != MGC_TARGET_LEGACY) ||
+       (instancing != (abi_version == MGC_HOST_INSTANCING_ABI_VERSION)) ||
+       (features != (abi_version == MGC_HOST_FEATURES_ABI_VERSION)) ||
+       (uses_host_instance_id && ((!instancing && !features) || stage != 0)) ||
+       (mipmap ? host_texture_lod >= MGC_HOST_TEXTURE_MAX_LEVELS : host_texture_lod != 0) ||
+       (stage != 1 && host_texture_lod))
+      return false;
+   struct mgc_layout_reader reader = {
+      .cursor = layout, .end = layout + length,
+      .program_format = program_format, .abi_version = abi_version, .stage = stage,
+      .abi = abi,
+      .host_texture_lod = host_texture_lod,
+      .uses_host_instance_id = uses_host_instance_id,
+      .shader = shader,
+   };
+   mgc_json_space(&reader);
+   if (reader.cursor == reader.end || *reader.cursor != '{' ||
+       !mgc_json_read_value(&reader, 0, 0))
+      return false;
+   mgc_json_space(&reader);
+   bool texture = (reader.metadata & 2048) != 0;
+   bool fragment_status = (reader.metadata & 4096) != 0;
+   bool versioned_status = abi->fragment_status_version == MGC_FRAGMENT_STATUS_VERSION;
+   bool versioned_texture = abi->host_texture_version != 0;
+   bool host_abi = abi_version == MGC_ABI_VERSION ||
+      (instancing && abi_version == MGC_HOST_INSTANCING_ABI_VERSION) || features;
+   if (reader.cursor != reader.end ||
+       reader.metadata != ((texture ? 4095u : 2047u) | (fragment_status ? 4096u : 0u) |
+                           (instancing ? 8192u : 0u) | (features ? 49152u : 0u)) ||
+       reader.layout_version != (features ? 4u : instancing ? 3u : texture ? 2u : 1u) ||
+       (host_texture_lod && !texture) ||
+       (abi->host_texture_version && !versioned_texture) ||
+       (abi->host_texture_version && abi->target != MGC_TARGET_LEGACY) ||
+       (fragment_status && (stage != 1 || !host_abi ||
+                            abi->target != MGC_TARGET_LEGACY || !versioned_status)) ||
+       (texture && (stage != 1 || !host_abi ||
+                    !versioned_texture ||
+                    (abi->fragment_status_version && !versioned_status) ||
+                    fragment_status != versioned_status ||
+                    (reader.uses_discard && !fragment_status))))
+      return false;
+   if (host_texture)
+      *host_texture = texture;
+   return true;
+}
+
+static void
+mgc_capture_append(struct mgc_capture_json *json, const void *data, size_t size)
+{
+   if (json->failed)
+      return;
+   if (size > MGC_HOST_CAPTURE_MAX_FILE_BYTES - json->size) {
+      json->failed = true;
+      return;
+   }
+   size_t needed = json->size + size;
+   if (needed > json->capacity) {
+      size_t capacity = MAX2(json->capacity, 4096);
+      while (capacity < needed)
+         capacity = MIN2(capacity * 2, MGC_HOST_CAPTURE_MAX_FILE_BYTES);
+      char *next = realloc(json->data, capacity);
+      if (!next) {
+         json->failed = true;
+         return;
+      }
+      json->data = next;
+      json->capacity = capacity;
+   }
+   if (size)
+      memcpy(json->data + json->size, data, size);
+   json->size = needed;
+}
+
+static void
+mgc_capture_printf(struct mgc_capture_json *json, const char *format, ...)
+{
+   char text[512];
+   va_list arguments;
+   va_start(arguments, format);
+   int length = vsnprintf(text, sizeof(text), format, arguments);
+   va_end(arguments);
+   if (length < 0 || (size_t)length >= sizeof(text))
+      json->failed = true;
+   else
+      mgc_capture_append(json, text, length);
+}
+
+static void
+mgc_capture_string(struct mgc_capture_json *json, const char *text, size_t size)
+{
+   mgc_capture_append(json, "\"", 1);
+   for (size_t index = 0; index < size && !json->failed; index++) {
+      unsigned character = (unsigned char)text[index];
+      if (character == '"' || character == '\\') {
+         char escaped[] = {'\\', character};
+         mgc_capture_append(json, escaped, sizeof(escaped));
+      } else if (character < 0x20) {
+         mgc_capture_printf(json, "\\u%04x", character);
+      } else if (character < 0x80) {
+         mgc_capture_append(json, &text[index], 1);
+      } else {
+         json->failed = true;
+      }
+   }
+   mgc_capture_append(json, "\"", 1);
+}
+
+static void
+mgc_capture_hex(struct mgc_capture_json *json, const struct mgc_host_buffer *buffer)
+{
+   if (!buffer->data) {
+      mgc_capture_append(json, "null", 4);
+      return;
+   }
+   const char digits[] = "0123456789abcdef";
+   const uint8_t *bytes = buffer->data;
+   mgc_capture_append(json, "\"", 1);
+   for (size_t offset = 0; offset < buffer->size && !json->failed;) {
+      char text[1024];
+      size_t count = MIN2(buffer->size - offset, sizeof(text) / 2);
+      for (size_t index = 0; index < count; index++) {
+         text[index * 2] = digits[bytes[offset + index] >> 4];
+         text[index * 2 + 1] = digits[bytes[offset + index] & 15];
+      }
+      mgc_capture_append(json, text, count * 2);
+      offset += count;
+   }
+   mgc_capture_append(json, "\"", 1);
+}
+
+static bool
+mgc_capture_buffer_valid(const struct mgc_host_buffer *buffer,
+                          size_t maximum, size_t *total)
+{
+   if ((!buffer->data && buffer->size) || buffer->size > maximum ||
+       buffer->size > MGC_HOST_CAPTURE_MAX_DATA_BYTES - *total)
+      return false;
+   *total += buffer->size;
+   return true;
+}
+
+static bool
+mgc_json_contract_equal(const char *value, const char *end,
+                         const char *expected, const char *expected_end, unsigned depth)
+{
+   if (depth > 16)
+      return false;
+   while (value < end && strchr(" \t\r\n", *value)) value++;
+   while (expected < expected_end && strchr(" \t\r\n", *expected)) expected++;
+   while (end > value && strchr(" \t\r\n", end[-1])) end--;
+   while (expected_end > expected && strchr(" \t\r\n", expected_end[-1])) expected_end--;
+   if (value == end || expected == expected_end || *value != *expected)
+      return false;
+   if (*value != '{' && *value != '[')
+      return end - value == expected_end - expected && !memcmp(value, expected, end - value);
+   bool object = *value == '{';
+   struct mgc_layout_reader actual = {.cursor = value + 1, .end = end - 1};
+   struct mgc_layout_reader contract = {.cursor = expected + 1, .end = expected_end - 1};
+   const char *keys[32], *key_ends[32], *values[32], *ends[32];
+   unsigned count = 0;
+   mgc_json_space(&contract);
+   while (contract.cursor < contract.end) {
+      if (count == ARRAY_SIZE(keys))
+         return false;
+      keys[count] = contract.cursor;
+      if (object && !mgc_json_read_string(&contract))
+         return false;
+      key_ends[count] = contract.cursor;
+      mgc_json_space(&contract);
+      if (object && (contract.cursor == contract.end || *contract.cursor++ != ':'))
+         return false;
+      mgc_json_space(&contract);
+      values[count] = contract.cursor;
+      if (!mgc_json_read_value(&contract, 1, 0))
+         return false;
+      ends[count++] = contract.cursor;
+      mgc_json_space(&contract);
+      if (contract.cursor < contract.end && *contract.cursor++ != ',')
+         return false;
+      mgc_json_space(&contract);
+   }
+   uint32_t seen = 0;
+   unsigned index = 0;
+   mgc_json_space(&actual);
+   while (actual.cursor < actual.end) {
+      const char *key = actual.cursor;
+      if (object && !mgc_json_read_string(&actual))
+         return false;
+      const char *key_end = actual.cursor;
+      unsigned match = index;
+      if (object) {
+         for (match = 0; match < count; match++) {
+            if (key_end - key == key_ends[match] - keys[match] &&
+                !memcmp(key, keys[match], key_end - key))
+               break;
+         }
+      }
+      if (match >= count || (seen & (1u << match)))
+         return false;
+      seen |= 1u << match;
+      mgc_json_space(&actual);
+      if (object && (actual.cursor == actual.end || *actual.cursor++ != ':'))
+         return false;
+      mgc_json_space(&actual);
+      const char *child = actual.cursor;
+      if (!mgc_json_read_value(&actual, 1, 0) ||
+          !mgc_json_contract_equal(child, actual.cursor, values[match], ends[match], depth + 1))
+         return false;
+      index++;
+      mgc_json_space(&actual);
+      if (actual.cursor < actual.end && *actual.cursor++ != ',')
+         return false;
+      mgc_json_space(&actual);
+   }
+   return index == count;
+}
+
+static bool
+mgc_json_unsigned(const char *value, const char *end, unsigned maximum, unsigned *result)
+{
+   while (value < end && strchr(" \t\r\n", *value)) value++;
+   while (end > value && strchr(" \t\r\n", end[-1])) end--;
+   if (value == end)
+      return false;
+   uint64_t number = 0;
+   for (; value < end; value++) {
+      if (*value < '0' || *value > '9')
+         return false;
+      number = number * 10 + (*value - '0');
+      if (number > maximum)
+         return false;
+   }
+   *result = number;
+   return true;
+}
+
+static bool
+mgc_json_features_io(const char *value, const char *end, unsigned domain)
+{
+   while (value < end && strchr(" \t\r\n", *value)) value++;
+   while (end > value && strchr(" \t\r\n", end[-1])) end--;
+   if (end - value < 2 || *value != '[' || end[-1] != ']')
+      return false;
+   struct mgc_layout_reader array = {.cursor = value + 1, .end = end - 1};
+   uint8_t seen[MGC_ABI_REGION_WORDS / 8] = {0};
+   mgc_json_space(&array);
+   while (array.cursor < array.end) {
+      if (*array.cursor++ != '{')
+         return false;
+      unsigned metadata = 0, word = 0;
+      mgc_json_space(&array);
+      for (;;) {
+         const char *key = array.cursor;
+         if (!mgc_json_read_string(&array))
+            return false;
+         const char *key_end = array.cursor;
+         mgc_json_space(&array);
+         if (array.cursor == array.end || *array.cursor++ != ':')
+            return false;
+         mgc_json_space(&array);
+         const char *field = array.cursor;
+         if (!mgc_json_read_value(&array, 1, 0))
+            return false;
+         unsigned bit = 0, number;
+         bool valid = false;
+         if (mgc_json_text_equal(key, key_end, "\"word_offset\"")) {
+            bit = 1;
+            unsigned maximum = domain == 0 ? MGC_HOST_FEATURES_INPUT_RESERVED - 1 :
+               domain == 1 ? MGC_HOST_FEATURES_OUTPUT_RESERVED - 1 :
+               MGC_RUNTIME_CONST_BUFFERS * MGC_UBO_STRIDE_WORDS - 1;
+            valid = mgc_json_unsigned(field, array.cursor, maximum, &word) &&
+               (domain != 0 || word != MGC_HOST_DERIVATIVE_RESPONSE_WORD);
+         } else if (mgc_json_text_equal(key, key_end, "\"type\"")) {
+            bit = 2;
+            valid = mgc_json_text_equal(field, array.cursor, "\"float\"") ||
+               mgc_json_text_equal(field, array.cursor, "\"int\"") ||
+               mgc_json_text_equal(field, array.cursor, "\"uint\"");
+         } else if (mgc_json_text_equal(key, key_end, "\"bit_size\"")) {
+            bit = 4;
+            valid = mgc_json_unsigned(field, array.cursor, 32, &number) && (number == 16 || number == 32);
+         } else if (domain != 2 && mgc_json_text_equal(key, key_end, "\"location\"")) {
+            bit = 8;
+            valid = mgc_json_unsigned(field, array.cursor, 255, &number);
+         } else if (domain != 2 && mgc_json_text_equal(key, key_end, "\"component\"")) {
+            bit = 16;
+            valid = mgc_json_unsigned(field, array.cursor, 3, &number);
+         } else if (domain != 2 && mgc_json_text_equal(key, key_end, "\"interpolation\"")) {
+            bit = 32;
+            valid = mgc_json_text_equal(field, array.cursor, "\"smooth\"") ||
+               mgc_json_text_equal(field, array.cursor, "\"flat\"") ||
+               mgc_json_text_equal(field, array.cursor, "\"noperspective\"");
+         }
+         if (!valid || (metadata & bit))
+            return false;
+         metadata |= bit;
+         mgc_json_space(&array);
+         if (array.cursor == array.end)
+            return false;
+         char separator = *array.cursor++;
+         if (separator == '}')
+            break;
+         if (separator != ',')
+            return false;
+         mgc_json_space(&array);
+      }
+      if (metadata != (domain == 2 ? 7u : 63u) || (seen[word / 8] & (1u << (word % 8))))
+         return false;
+      seen[word / 8] |= 1u << (word % 8);
+      mgc_json_space(&array);
+      if (array.cursor < array.end && *array.cursor++ != ',')
+         return false;
+      mgc_json_space(&array);
+   }
+   return true;
+}
+
+static bool
+mgc_json_features_metadata(const struct mgc_layout_reader *reader,
+                            const char *value, const char *end, bool texture)
+{
+   const struct mgc_shader *shader = reader->shader;
+   if (!shader || shader->host_builtin_mask & ~63u ||
+       (reader->stage ? shader->host_builtin_mask & 15u : shader->host_builtin_mask & 48u) ||
+       shader->uses_host_instance_id != ((shader->host_builtin_mask & 1u) != 0) ||
+       shader->host_frag_coord_components & ~15u ||
+       ((shader->host_builtin_mask & 16u) != 0) != (shader->host_frag_coord_components != 0) ||
+       shader->stats.spill_words > MGC_HOST_FEATURES_SPILL_WORDS ||
+       (!reader->stage && (shader->uses_derivatives || shader->uses_host_texture)) ||
+       shader->host_texture_bindings > MGC_HOST_FEATURES_TEXTURE_MAX_BINDINGS ||
+       shader->uses_host_texture != (shader->host_texture_bindings != 0) ||
+       (shader->uses_host_texture ?
+          !shader->host_texture_lod_modes || shader->host_texture_lod_modes > 7 ||
+          shader->host_texture_samples < shader->host_texture_bindings ||
+          shader->host_texture_samples > MGC_HOST_FEATURES_TEXTURE_MAX_SAMPLES :
+          shader->host_texture_lod_modes || shader->host_texture_samples))
+      return false;
+   struct mgc_capture_json expected = {0};
+   if (texture) {
+      unsigned version = reader->abi->host_texture_version;
+      if (!shader->uses_host_texture || version < MGC_HOST_TEXTURE_DYNAMIC_VERSION ||
+          version > MGC_HOST_TEXTURE_ANISOTROPIC_VERSION)
+         return false;
+      mgc_capture_printf(&expected, "{\"version\":%u,\"bindings\":[", version);
+      for (unsigned index = 0; index < shader->host_texture_bindings; index++) {
+         const struct mgc_host_texture_binding *pair = &shader->host_texture_binding[index];
+         if (pair->texture >= 4 || pair->sampler >= 4) {
+            expected.failed = true;
+            break;
+         }
+         for (unsigned previous = 0; previous < index; previous++) {
+            if (pair->texture == shader->host_texture_binding[previous].texture &&
+                pair->sampler == shader->host_texture_binding[previous].sampler)
+               expected.failed = true;
+         }
+         mgc_capture_printf(&expected, "%s{\"texture\":%u,\"sampler\":%u}",
+                            index ? "," : "", pair->texture, pair->sampler);
+      }
+      unsigned modes = shader->host_texture_lod_modes;
+      mgc_capture_printf(&expected,
+         "],\"max_bindings\":4,\"max_samples\":32,\"max_size\":32,\"max_levels\":6,"
+         "\"per_binding_stride\":16384,\"header_words\":32,\"lod_mode\":\"%s\","
+         "\"wrap_s\":\"%s\",\"wrap_t\":\"%s\",\"filter\":\"%s\",\"mip_filter\":\"%s\"",
+         modes == 1 ? "explicit" : modes == 2 ? "implicit" : modes == 4 ? "gradients" : "mixed",
+         mgc_host_texture_wrap_name(reader->abi->host_texture_wrap_s),
+         mgc_host_texture_wrap_name(reader->abi->host_texture_wrap_t),
+         version == MGC_HOST_TEXTURE_DYNAMIC_VERSION ? "nearest" : "linear",
+         version >= MGC_HOST_TEXTURE_TRILINEAR_VERSION ? "linear" : "nearest");
+      if (version == MGC_HOST_TEXTURE_ANISOTROPIC_VERSION)
+         mgc_capture_printf(&expected, ",\"max_anisotropy\":%u", MGC_HOST_FEATURES_TEXTURE_MAX_ANISOTROPY);
+      mgc_capture_printf(&expected, "}");
+   } else {
+      mgc_capture_printf(&expected,
+         "{\"version\":1,\"max_instances\":256,\"max_expanded_vertices\":65536,"
+         "\"reserved_input_words\":[65504,65535],\"reserved_output_words\":[57344,65534],\"builtins\":[");
+      const char *names[] = {"gl_InstanceID", "gl_VertexID", "gl_BaseInstance", "gl_DrawID", "gl_FragCoord", "gl_FrontFacing"};
+      const unsigned words[] = {65535, 65520, 65521, 65522, 65524, 65528};
+      const char *types[] = {"int", "int", "uint", "int", "float", "bool"};
+      bool first = true;
+      for (unsigned builtin = 0; builtin < ARRAY_SIZE(names); builtin++) {
+         if (!(shader->host_builtin_mask & (1u << builtin)))
+            continue;
+         mgc_capture_printf(&expected, "%s{\"name\":\"%s\",\"word_offsets\":[", first ? "" : ",", names[builtin]);
+         if (builtin == 4) {
+            bool first_component = true;
+            for (unsigned component = 0; component < 4; component++) {
+               if (!(shader->host_frag_coord_components & (1u << component)))
+                  continue;
+               mgc_capture_printf(&expected, "%s%u", first_component ? "" : ",", words[builtin] + component);
+               first_component = false;
+            }
+         } else {
+            mgc_capture_printf(&expected, "%u", words[builtin]);
+         }
+         mgc_capture_printf(&expected, "],\"type\":\"%s\",\"bit_size\":%u,\"storage\":\"%s\"}",
+                            types[builtin], builtin == 5 ? 1 : 32, builtin == 4 ? "low_fp16" : "raw32");
+         first = false;
+      }
+      mgc_capture_printf(&expected, "],\"uses_derivatives\":%s,\"derivative_mailbox\":", shader->uses_derivatives ? "true" : "false");
+      if (shader->uses_derivatives)
+         mgc_capture_printf(&expected,
+            "{\"request_word_offset\":65496,\"operand_word_offset\":65497,\"response_word_offset\":65498,"
+            "\"operation_ids\":{\"dx\":1,\"dy\":2},\"semantics\":\"fine-quad\"}");
+      else
+         mgc_capture_printf(&expected, "null");
+      mgc_capture_printf(&expected,
+         ",\"spill\":{\"word_offset\":57344,\"max_words\":4096,\"words\":%u},\"fault_word_offset\":65499}", shader->stats.spill_words);
+   }
+   bool valid = !expected.failed &&
+      mgc_json_contract_equal(value, end, expected.data, expected.data + expected.size, 0);
+   free(expected.data);
+   return valid;
+}
+
+struct mgc_capture_texture_level {
+   unsigned width;
+   unsigned height;
+   size_t size;
+   uint8_t data[MGC_HOST_TEXTURE_MAX_SIZE * MGC_HOST_TEXTURE_MAX_SIZE * 4];
+};
+
+struct mgc_capture_texture {
+   unsigned width;
+   unsigned height;
+   size_t size;
+   const char *filter;
+   const char *mip_filter;
+   const char *wrap_s;
+   const char *wrap_t;
+   bool mipmapped;
+   unsigned last_level;
+   uint8_t data[MGC_HOST_TEXTURE_MAX_SIZE * MGC_HOST_TEXTURE_MAX_SIZE * 4];
+   struct mgc_capture_texture_level mipmaps[MGC_HOST_TEXTURE_MAX_LEVELS - 1];
+};
+
+static const char *
+mgc_capture_sampler_wrap_name(unsigned wrap)
+{
+   switch (wrap) {
+   case PIPE_TEX_WRAP_CLAMP_TO_EDGE:
+      return mgc_host_texture_wrap_name(MGC_HOST_WRAP_CLAMP_TO_EDGE);
+   case PIPE_TEX_WRAP_REPEAT:
+      return mgc_host_texture_wrap_name(MGC_HOST_WRAP_REPEAT);
+   case PIPE_TEX_WRAP_MIRROR_REPEAT:
+      return mgc_host_texture_wrap_name(MGC_HOST_WRAP_MIRRORED_REPEAT);
+   default:
+      return NULL;
+   }
+}
+
+static bool
+mgc_capture_texture_snapshot(struct mgc_context *ctx,
+                              struct mgc_capture_texture *texture)
+{
+   const struct mgc_compile_options *abi = &ctx->shaders[1]->shader->abi;
+   if (!abi->host_texture_version || !mgc_capture_texture_options_valid(abi))
+      return false;
+   bool mipmap = abi->host_texture_version == MGC_HOST_TEXTURE_MIPMAP_VERSION ||
+      abi->host_texture_version == MGC_HOST_TEXTURE_LINEAR_MIPMAP_VERSION;
+   unsigned lod = ctx->shaders[1]->shader->host_texture_lod;
+   if (mipmap ? lod >= MGC_HOST_TEXTURE_MAX_LEVELS : lod != 0)
+      return false;
+   unsigned filter = mgc_host_texture_is_linear(abi->host_texture_version) ?
+      PIPE_TEX_FILTER_LINEAR : PIPE_TEX_FILTER_NEAREST;
+   const unsigned wraps[] = {
+      [MGC_HOST_WRAP_CLAMP_TO_EDGE] = PIPE_TEX_WRAP_CLAMP_TO_EDGE,
+      [MGC_HOST_WRAP_REPEAT] = PIPE_TEX_WRAP_REPEAT,
+      [MGC_HOST_WRAP_MIRRORED_REPEAT] = PIPE_TEX_WRAP_MIRROR_REPEAT,
+   };
+   unsigned wrap_s = wraps[mgc_host_texture_wrap_for_axis(abi, 0)];
+   unsigned wrap_t = wraps[mgc_host_texture_wrap_for_axis(abi, 1)];
+   for (unsigned stage = 0; stage < MGC_RUNTIME_STAGES; stage++) {
+      for (unsigned slot = 0; slot < 8; slot++) {
+         if ((stage != 1 || slot != 0) &&
+             (ctx->sampler_views[stage][slot] || ctx->sampler_state_valid[stage][slot]))
+            return false;
+      }
+   }
+   const struct pipe_sampler_view *view = ctx->sampler_views[1][0];
+   const struct pipe_sampler_state *sampler = &ctx->sampler_states[1][0];
+   if (!view || !ctx->sampler_state_valid[1][0] ||
+       view->context != &ctx->base || !view->texture ||
+       view->texture->screen != &ctx->screen->base ||
+       view->target != PIPE_TEXTURE_2D || view->is_tex2d_from_buf ||
+       view->format != PIPE_FORMAT_R8G8B8A8_UNORM ||
+       view->u.tex.first_level ||
+       view->u.tex.last_level != (mipmap ? view->texture->last_level : 0) ||
+       view->u.tex.first_layer || view->u.tex.last_layer ||
+       view->swizzle_r != PIPE_SWIZZLE_X || view->swizzle_g != PIPE_SWIZZLE_Y ||
+       view->swizzle_b != PIPE_SWIZZLE_Z || view->swizzle_a != PIPE_SWIZZLE_W ||
+       sampler->unnormalized_coords ||
+       sampler->min_img_filter != filter ||
+       sampler->mag_img_filter != filter ||
+       sampler->min_mip_filter != (mipmap ? PIPE_TEX_MIPFILTER_NEAREST : PIPE_TEX_MIPFILTER_NONE) ||
+       sampler->wrap_s != wrap_s ||
+       sampler->wrap_t != wrap_t ||
+       sampler->compare_mode != PIPE_TEX_COMPARE_NONE || sampler->max_anisotropy > 1 ||
+       sampler->seamless_cube_map || sampler->border_color_is_integer ||
+       sampler->reduction_mode != PIPE_TEX_REDUCTION_WEIGHTED_AVERAGE ||
+       !isfinite(sampler->lod_bias) || sampler->lod_bias != 0 ||
+       !isfinite(sampler->min_lod) || sampler->min_lod != 0 ||
+       !isfinite(sampler->max_lod) || sampler->max_lod < 0)
+      return false;
+   struct pipe_resource *resource = view->texture;
+   if (resource->target != PIPE_TEXTURE_2D ||
+       resource->format != PIPE_FORMAT_R8G8B8A8_UNORM ||
+       !resource->width0 || resource->width0 > MGC_HOST_TEXTURE_MAX_SIZE ||
+       !resource->height0 || resource->height0 > MGC_HOST_TEXTURE_MAX_SIZE ||
+       resource->depth0 != 1 || resource->array_size != 1 ||
+       (!mipmap && resource->last_level) || resource->nr_samples > 1 ||
+       resource->nr_storage_samples > 1 || resource->next ||
+       MAX2(1, resource->nr_samples) != MAX2(1, resource->nr_storage_samples) ||
+       ctx->framebuffer.nr_cbufs > ARRAY_SIZE(ctx->framebuffer.cbufs) ||
+       ctx->framebuffer.zsbuf.texture == resource || ctx->framebuffer.resolve == resource)
+      return false;
+   unsigned last_level = 0;
+   if (mipmap) {
+      for (unsigned edge = MAX2(resource->width0, resource->height0); edge > 1; edge >>= 1)
+         last_level++;
+      if (resource->last_level != last_level || last_level >= MGC_HOST_TEXTURE_MAX_LEVELS ||
+          sampler->max_lod < MIN2(lod, last_level))
+         return false;
+   }
+   for (unsigned index = 0; index < ctx->framebuffer.nr_cbufs; index++) {
+      if (ctx->framebuffer.cbufs[index].texture == resource)
+         return false;
+   }
+   struct mgc_resource *storage = mgc_resource(resource);
+   size_t row_bytes = resource->width0 * 4;
+   texture->width = resource->width0;
+   texture->height = resource->height0;
+   texture->size = row_bytes * texture->height;
+   texture->filter = sampler->min_img_filter == PIPE_TEX_FILTER_LINEAR ? "linear" : "nearest";
+   texture->mip_filter = sampler->min_mip_filter == PIPE_TEX_MIPFILTER_NEAREST ? "nearest" : "none";
+   texture->wrap_s = mgc_capture_sampler_wrap_name(sampler->wrap_s);
+   texture->wrap_t = mgc_capture_sampler_wrap_name(sampler->wrap_t);
+   texture->mipmapped = mipmap;
+   texture->last_level = last_level;
+   simple_mtx_lock(&ctx->screen->lock);
+   bool available = storage->data && storage->active_maps == 0 && storage->active_host_executions == 0;
+   for (unsigned index = 0; available && index <= last_level; index++) {
+      const struct mgc_resource_level *level = &storage->levels[index];
+      unsigned width = u_minify(texture->width, index);
+      unsigned height = u_minify(texture->height, index);
+      row_bytes = width * 4;
+      uint64_t span = (uint64_t)(height - 1) * level->stride + row_bytes;
+      if (level->width != width || level->height != height || level->layers != 1 ||
+          level->stride < row_bytes || level->layer_stride < span ||
+          level->offset > storage->size || span > storage->size - level->offset) {
+         available = false;
+         break;
+      }
+      uint8_t *destination = texture->data;
+      if (index) {
+         struct mgc_capture_texture_level *snapshot = &texture->mipmaps[index - 1];
+         snapshot->width = width;
+         snapshot->height = height;
+         snapshot->size = row_bytes * height;
+         destination = snapshot->data;
+      }
+      for (unsigned row = 0; row < height; row++) {
+         memcpy(destination + row * row_bytes,
+                (const uint8_t *)storage->data + level->offset + (size_t)row * level->stride,
+                row_bytes);
+      }
+   }
+   simple_mtx_unlock(&ctx->screen->lock);
+   return available;
+}
