+      "\"draw\":{\"mode\":\"%s\",\"start\":%u,\"count\":%u,\"index_size\":%u,"
+      "\"index_bias\":%d,\"instance_count\":%u,\"start_instance\":%u,"
+      "\"primitive_restart\":%s,\"restart_index\":%u},\"shaders\":{",
+      features ? "mgc-host-draw-v4" : ctx->host_instancing_version ? "mgc-host-draw-v3" :
+         host_textures[1] ? "mgc-host-draw-v2" : "mgc-host-draw-v1",
