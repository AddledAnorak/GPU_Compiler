+      options.input_base = 0xfffffff0u;
+   if (!texture_wrap_option("MGC_TEST_WRAP_S", &options.host_texture_wrap_s) ||
+       !texture_wrap_option("MGC_TEST_WRAP_T", &options.host_texture_wrap_t)) {
+      ralloc_free(builder.shader);
+      return 1;
+   }
+   if (argc == 4 && (!strcmp(argv[3], "host-texture-mixed-invalid-s") ||
+                    !strcmp(argv[3], "host-texture-mixed-invalid-t") ||
+                    !strcmp(argv[3], "host-texture-linear-mixed-invalid-s") ||
+                    !strcmp(argv[3], "host-texture-linear-mixed-invalid-t") ||
+                    !strcmp(argv[3], "host-texture-mipmap-invalid-s") ||
+                    !strcmp(argv[3], "host-texture-mipmap-invalid-t") ||
+                    !strcmp(argv[3], "host-texture-linear-mipmap-invalid-s") ||
+                    !strcmp(argv[3], "host-texture-linear-mipmap-invalid-t"))) {
+      if (strstr(argv[3], "mipmap"))
+         options.host_texture_version = strstr(argv[3], "linear") ?
+            MGC_HOST_TEXTURE_LINEAR_MIPMAP_VERSION : MGC_HOST_TEXTURE_MIPMAP_VERSION;
+      else
+         options.host_texture_version = strstr(argv[3], "linear") ?
+            MGC_HOST_TEXTURE_LINEAR_MIXED_VERSION : MGC_HOST_TEXTURE_MIXED_VERSION;
+      if (argv[3][strlen(argv[3]) - 1] == 's')
+         options.host_texture_wrap_s = (enum mgc_host_texture_wrap)count;
+      else
+         options.host_texture_wrap_t = (enum mgc_host_texture_wrap)count;
+   }
+   const char *instancing = getenv("MGC_TEST_HOST_INSTANCING");
+   if (instancing) {
+      if (strcmp(instancing, "0") && strcmp(instancing, "1")) {
+         fprintf(stderr, "MGC_TEST_HOST_INSTANCING must be 0 or 1\n");
+         ralloc_free(builder.shader);
+         return 1;
+      }
+      options.host_instancing_version = !strcmp(instancing, "1") ? MGC_HOST_INSTANCING_VERSION : 0;
+   }
+   const char *features = getenv("MGC_TEST_HOST_FEATURES");
+   const char *texture_version = getenv("MGC_TEST_HOST_TEXTURE");
+   const char *texture_base = getenv("MGC_TEST_TEXTURE_BASE");
+   if (features)
+      options.host_features_version = strtoul(features, NULL, 0);
+   if (texture_version)
+      options.host_texture_version = strtoul(texture_version, NULL, 0);
+   if (texture_base)
+      options.texture_base = strtoul(texture_base, NULL, 0);
+   struct mgc_shader *shader = mgc_compile_nir_with_options(builder.shader, &options);
+   if (shader->error) {
+      fprintf(stderr, "%s\n", shader->error);
+      if (shader->asm_text) {
+         fprintf(stderr, "error exposed partial assembly\n");
+         return 3;
+      }
+      mgc_shader_destroy(shader);
+      return 1;
+   }
+   const char *expected_format = options.target == MGC_TARGET_FP16_HARDWARE_V1 ?
+                                  "fp16-hardware-v1" : "legacy-mgcsim-v1";
+   if (!shader->program_format || strcmp(shader->program_format, expected_format) ||
+       shader->abi.target != options.target) {
+      fprintf(stderr, "compiler target metadata mismatch\n");
+      mgc_shader_destroy(shader);
+      return 3;
+   }
+   if (getenv("MGC_TEST_LAYOUT"))
+      fprintf(stderr, "host_texture_lod=%u\n", shader->host_texture_lod);
+   if (getenv("MGC_TEST_LAYOUT"))
+      fprintf(stderr, "host_instancing_version=%u uses_host_instance_id=%u\n",
+              shader->abi.host_instancing_version, shader->uses_host_instance_id);
+   fprintf(stderr, "abi=%u registers=%u predicates=%u instructions=%u waits=%u immediate_waits=%u blocks=%u\n",
+            shader->abi_version, shader->stats.registers, shader->stats.predicates,
+            shader->stats.instructions, shader->stats.waits,
+            shader->stats.waits_before_scheduling, shader->stats.blocks);
+   if (getenv("MGC_TEST_LAYOUT"))
+      fprintf(stderr, "layout=%s\n", shader->layout_json);
+   if (getenv("MGC_TEST_LAYOUT")) {
+      fprintf(stderr, "host_builtin_mask=%u uses_derivatives=%u host_texture_bindings=%u host_texture_samples=%u spill_words=%u spill_stores=%u spill_loads=%u\n",
+         shader->host_builtin_mask, shader->uses_derivatives, shader->host_texture_bindings,
+         shader->host_texture_samples, shader->stats.spill_words, shader->stats.spill_stores, shader->stats.spill_loads);
+      for (unsigned binding = 0; binding < shader->host_texture_bindings; binding++)
+         fprintf(stderr, "binding=%u:%u\n", shader->host_texture_binding[binding].texture, shader->host_texture_binding[binding].sampler);
+   }
+   fputs(shader->asm_text, stdout);
+   mgc_shader_destroy(shader);
+   return 0;
+}
diff --git a/src/gallium/drivers/mgc/mgc_vector_compiler.c b/src/gallium/drivers/mgc/mgc_vector_compiler.c
new file mode 100644
index 0000000000000000000000000000000000000000..ec57303919247defaff3d7435d9fafb80efe6f0a
--- /dev/null
+++ b/src/gallium/drivers/mgc/mgc_vector_compiler.c
@@ -0,0 +1,702 @@
+#include <limits.h>
+#include <math.h>
+#include <stdarg.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "compiler/nir/nir.h"
+#include "compiler/shader_enums.h"
+#include "util/half_float.h"
+#include "util/ralloc.h"
+
+#include "mgc_compiler.h"
+#include "mgc_vector_compiler.h"
+
+enum mgc_vector_role {
+   MGC_VECTOR_FLOAT = 1u,
+   MGC_VECTOR_ADDRESS = 2u,
+};
+
+struct mgc_vector_value {
+   nir_def *def;
+   unsigned slot;
+   unsigned roles;
+   uint32_t literal;
+};
+
+struct mgc_vector_ctx {
+   struct mgc_shader *shader;
+   nir_function_impl *impl;
+   nir_block *block;
+   void *mem_ctx;
+   struct mgc_vector_value *values;
+   char *text;
+   size_t length;
+   struct mgc_compile_stats stats;
+   uint32_t output_base;
+   unsigned rsq_labels;
+   unsigned first_error_jump;
+   bool has_error_jump;
+};
+
+static bool
+mgc_vector_error(struct mgc_vector_ctx *ctx, const char *format, ...)
+   PRINTFLIKE(2, 3);
+
+static bool
+mgc_vector_error(struct mgc_vector_ctx *ctx, const char *format, ...)
+{
+   if (!ctx->shader->error) {
+      va_list arguments;
+      va_start(arguments, format);
+      ctx->shader->error = ralloc_vasprintf(ctx->shader, format, arguments);
+      va_end(arguments);
+   }
+   return false;
+}
+
+static bool
+mgc_vector_append(struct mgc_vector_ctx *ctx, unsigned words,
+                  const char *format, ...) PRINTFLIKE(3, 4);
+
+static bool
+mgc_vector_append(struct mgc_vector_ctx *ctx, unsigned words,
+                  const char *format, ...)
+{
+   if (ctx->shader->error)
+      return false;
+   if (words > UINT_MAX - ctx->stats.instructions)
+      return mgc_vector_error(ctx, "mgc vector: machine-word count exceeds 32 bits");
+   va_list arguments;
+   va_start(arguments, format);
+   bool success = ralloc_vasprintf_rewrite_tail(&ctx->text, &ctx->length,
+                                               format, arguments);
+   va_end(arguments);
+   if (!success)
+      return mgc_vector_error(ctx, "mgc vector: assembly allocation failed");
+   ctx->stats.instructions += words;
+   return true;
+}
+
+static bool
+mgc_vector_address(struct mgc_vector_ctx *ctx, uint32_t base,
+                   uint64_t word, uint32_t *address)
+{
+   if (word >= MGC_ABI_REGION_WORDS ||
+       (uint64_t)base + word * 4 > UINT32_MAX) {
+      mgc_vector_error(ctx, "mgc vector: address exceeds ABI2 or 32-bit byte range");
+      return false;
+   }
+   *address = base + word * 4;
+   return true;
+}
+
+static struct mgc_vector_value *
+mgc_vector_source(struct mgc_vector_ctx *ctx, nir_src source, unsigned role)
+{
+   nir_def *def = source.ssa;
+   if (!def || def->num_components != 1 || def->bit_size != 32 ||
+       def->index >= ctx->impl->ssa_alloc ||
+       ctx->values[def->index].def != def) {
+      mgc_vector_error(ctx, "mgc vector: sources must be defined, scalar 32-bit SSA values");
+      return NULL;
+   }
+   ctx->values[def->index].roles |= role;
+   return &ctx->values[def->index];
+}
+
+static bool
+mgc_vector_offset(struct mgc_vector_ctx *ctx, nir_src source, uint32_t *offset)
+{
+   if (!mgc_vector_source(ctx, source, MGC_VECTOR_ADDRESS))
+      return false;
+   if (!nir_src_is_const(source))
+      return mgc_vector_error(ctx, "mgc vector: dynamic IO or UBO addressing is unsupported");
+   *offset = nir_src_as_uint(source);
+   return true;
+}
+
+static bool
+mgc_vector_define(struct mgc_vector_ctx *ctx, nir_def *def)
+{
+   if (def->num_components != 1 || def->bit_size != 32 ||
+       def->index >= ctx->impl->ssa_alloc || ctx->values[def->index].def)
+      return mgc_vector_error(ctx, "mgc vector: definitions must be unique scalar FP32 SSA values");
+   if (ctx->stats.spill_words >= MGC_VECTOR_SCRATCH_WORDS)
+      return mgc_vector_error(ctx, "mgc vector: scratch exceeds 16384 words");
+   ctx->values[def->index] = (struct mgc_vector_value){
+      .def = def,
+      .slot = ctx->stats.spill_words++,
+   };
+   return true;
+}
+
+static bool
+mgc_vector_float_type(struct mgc_vector_ctx *ctx, nir_alu_type type)
+{
+   if (type != nir_type_invalid &&
+       nir_alu_type_get_base_type(type) != nir_type_float)
+      return mgc_vector_error(ctx, "mgc vector: integer and boolean data IO is unsupported");
+   return true;
+}
+
+static bool
+mgc_vector_io_address(struct mgc_vector_ctx *ctx, nir_intrinsic_instr *intr,
+                      uint32_t *address)
+{
+   uint32_t offset, block = 0;
+   uint32_t base = ctx->shader->abi.uniform_base;
+   uint64_t word;
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_input:
+   case nir_intrinsic_load_interpolated_input:
+   case nir_intrinsic_store_output: {
+      unsigned offset_source = intr->intrinsic == nir_intrinsic_load_input ? 0 : 1;
+      if (!mgc_vector_offset(ctx, intr->src[offset_source], &offset))
+         return false;
+      if (nir_intrinsic_component(intr) >= 4)
+         return mgc_vector_error(ctx, "mgc vector: IO component exceeds a four-word slot");
+      word = ((uint64_t)nir_intrinsic_base(intr) + offset) * 4 +
+             nir_intrinsic_component(intr);
+      if (intr->intrinsic == nir_intrinsic_store_output) {
+         if (word >= MGC_VECTOR_SCRATCH_FIRST_WORD)
+            return mgc_vector_error(ctx, "mgc vector: output aliases reserved scratch/status words");
+         base = ctx->output_base;
+      } else {
+         base = ctx->shader->abi.input_base;
+      }
+      break;
+   }
+   case nir_intrinsic_load_uniform:
+      if (!mgc_vector_offset(ctx, intr->src[0], &offset))
+         return false;
+      word = (uint64_t)nir_intrinsic_base(intr) + offset;
+      break;
+   case nir_intrinsic_load_ubo:
+      if (!mgc_vector_offset(ctx, intr->src[0], &block) ||
+          !mgc_vector_offset(ctx, intr->src[1], &offset))
+         return false;
+      if (offset % 4)
+         return mgc_vector_error(ctx, "mgc vector: UBO byte offsets must be four-byte aligned");
+      word = offset / 4;
+      break;
+   case nir_intrinsic_load_ubo_vec4:
+      if (!mgc_vector_offset(ctx, intr->src[0], &block) ||
+          !mgc_vector_offset(ctx, intr->src[1], &offset))
+         return false;
+      if (nir_intrinsic_component(intr) >= 4)
+         return mgc_vector_error(ctx, "mgc vector: UBO component exceeds a four-word slot");
+      word = ((uint64_t)nir_intrinsic_base(intr) + offset) * 4 +
+             nir_intrinsic_component(intr);
+      break;
+   default:
+      return mgc_vector_error(ctx, "mgc vector: unsupported IO intrinsic");
+   }
+   if (intr->intrinsic == nir_intrinsic_load_ubo ||
+       intr->intrinsic == nir_intrinsic_load_ubo_vec4) {
+      if (block >= 16 || word >= MGC_UBO_STRIDE_WORDS)
+         return mgc_vector_error(ctx, "mgc vector: UBO exceeds sixteen blocks of 4096 words");
+      word += (uint64_t)block * MGC_UBO_STRIDE_WORDS;
+   }
+   return mgc_vector_address(ctx, base, word, address);
+}
+
+static bool
+mgc_vector_validate_alu(struct mgc_vector_ctx *ctx, nir_alu_instr *alu)
+{
+   switch (alu->op) {
+   case nir_op_mov:
+   case nir_op_fadd:
+   case nir_op_fsub:
+   case nir_op_fmul:
+   case nir_op_fneg:
+   case nir_op_fabs:
+   case nir_op_fmax:
+   case nir_op_fmin:
+   case nir_op_ffma:
+   case nir_op_frsq:
+   case nir_op_fsqrt:
+      break;
+   case nir_op_frcp:
+      if (!alu->src[0].src.ssa ||
+          alu->src[0].src.ssa->parent_instr->type != nir_instr_type_alu ||
+          nir_instr_as_alu(alu->src[0].src.ssa->parent_instr)->op != nir_op_frsq)
+         return mgc_vector_error(ctx, "mgc vector: reciprocal is supported only in lowered sqrt");
+      break;
+   default:
+      return mgc_vector_error(ctx, "mgc vector: unsupported ALU operation '%s'",
+                              nir_op_infos[alu->op].name);
+   }
+   const nir_op_info *info = &nir_op_infos[alu->op];
+   for (unsigned source = 0; source < info->num_inputs; source++) {
+      if (alu->src[source].swizzle[0] != 0 || info->input_sizes[source] > 1)
+         return mgc_vector_error(ctx, "mgc vector: non-scalar ALU source swizzle is unsupported");
+      if (!mgc_vector_source(ctx, alu->src[source].src, MGC_VECTOR_FLOAT))
+         return false;
+   }
+   return mgc_vector_define(ctx, &alu->def);
+}
+
+static bool
+mgc_vector_validate_intrinsic(struct mgc_vector_ctx *ctx, nir_intrinsic_instr *intr)
+{
+   if (intr->num_components != 1)
+      return mgc_vector_error(ctx, "mgc vector: data IO must be scalar");
+   switch (intr->intrinsic) {
+   case nir_intrinsic_store_output:
+      if (nir_intrinsic_write_mask(intr) > 1 ||
+          !mgc_vector_float_type(ctx, nir_intrinsic_src_type(intr)) ||
+          !mgc_vector_source(ctx, intr->src[0], MGC_VECTOR_FLOAT))
+         return mgc_vector_error(ctx, "mgc vector: output must be a scalar floating value");
+      break;
+   case nir_intrinsic_load_input:
+   case nir_intrinsic_load_interpolated_input:
+   case nir_intrinsic_load_uniform:
+   case nir_intrinsic_load_ubo:
+   case nir_intrinsic_load_ubo_vec4:
+      if (nir_intrinsic_has_dest_type(intr) &&
+          !mgc_vector_float_type(ctx, nir_intrinsic_dest_type(intr)))
+         return false;
+      if (intr->intrinsic == nir_intrinsic_load_interpolated_input &&
+          !mgc_vector_source(ctx, intr->src[0], 0))
+         return false;
+      break;
+   default:
+      return mgc_vector_error(ctx, "mgc vector: unsupported intrinsic '%s'",
+                              nir_intrinsic_infos[intr->intrinsic].name);
+   }
+   uint32_t address;
+   if (!mgc_vector_io_address(ctx, intr, &address))
+      return false;
+   return intr->intrinsic == nir_intrinsic_store_output ||
+          mgc_vector_define(ctx, &intr->def);
+}
+
+static bool
+mgc_vector_validate_abi(struct mgc_vector_ctx *ctx, nir_shader *nir)
+{
+   const struct mgc_compile_options *abi = &ctx->shader->abi;
+   if (ctx->shader->abi_version != MGC_HARDWARE_ABI_VERSION ||
+       abi->target != MGC_TARGET_FP16_HARDWARE_VECTOR || abi->schedule ||
+       abi->host_texture_version || abi->host_instancing_version ||
+       abi->host_features_version)
+      return mgc_vector_error(ctx, "mgc vector: unscheduled hardware ABI2 is required");
+   if (nir->info.stage != MESA_SHADER_VERTEX && nir->info.stage != MESA_SHADER_FRAGMENT)
+      return mgc_vector_error(ctx, "mgc vector: only vertex and fragment stages are supported");
+   if (nir->info.stage == MESA_SHADER_FRAGMENT && nir->info.fs.uses_discard)
+      return mgc_vector_error(ctx, "mgc vector: discard is unsupported");
+   uint32_t bases[] = {
+      abi->input_base, abi->uniform_base,
+      abi->vertex_output_base, abi->fragment_output_base,
+   };
+   uint64_t region_bytes = (uint64_t)MGC_ABI_REGION_WORDS * 4;
+   for (unsigned region = 0; region < 4; region++) {
+      if (bases[region] % 4 || (uint64_t)bases[region] + region_bytes > (UINT64_C(1) << 32))
+         return mgc_vector_error(ctx, "mgc vector: ABI2 regions must be aligned 32-bit byte ranges");
+      for (unsigned previous = 0; previous < region; previous++) {
+         if ((uint64_t)bases[region] < (uint64_t)bases[previous] + region_bytes &&
+             (uint64_t)bases[previous] < (uint64_t)bases[region] + region_bytes)
+            return mgc_vector_error(ctx, "mgc vector: ABI2 regions overlap");
+      }
+   }
+   ctx->output_base = nir->info.stage == MESA_SHADER_FRAGMENT ?
+      abi->fragment_output_base : abi->vertex_output_base;
+   return true;
+}
+
+static bool
+mgc_vector_validate(struct mgc_vector_ctx *ctx, nir_shader *nir)
+{
+   if (!mgc_vector_validate_abi(ctx, nir))
+      return false;
+   nir_foreach_function(function, nir) {
+      if (!function->impl)
+         continue;
+      if (ctx->impl || !function->is_entrypoint || function->num_params ||
+          function->impl->preamble)
+         return mgc_vector_error(ctx, "mgc vector: one parameterless entrypoint without a preamble is required");
+      ctx->impl = function->impl;
+   }
+   if (!ctx->impl || !exec_list_is_singular(&ctx->impl->body))
+      return mgc_vector_error(ctx, "mgc vector: control flow is unsupported");
+   nir_cf_node *node = exec_node_data(nir_cf_node,
+                                    exec_list_get_head(&ctx->impl->body), node);
+   if (node->type != nir_cf_node_block)
+      return mgc_vector_error(ctx, "mgc vector: control flow is unsupported");
+   ctx->block = nir_cf_node_as_block(node);
+   if (ctx->block->successors[0] != ctx->impl->end_block || ctx->block->successors[1] ||
+       exec_list_is_empty(&ctx->block->instr_list))
+      return mgc_vector_error(ctx, "mgc vector: one nonempty straight-line block is required");
+   ctx->values = rzalloc_array(ctx->mem_ctx, struct mgc_vector_value,
+                              MAX2(ctx->impl->ssa_alloc, 1));
+   if (!ctx->values)
+      return mgc_vector_error(ctx, "mgc vector: SSA validation allocation failed");
+   ctx->stats.blocks = 1;
+   nir_foreach_instr(instr, ctx->block) {
+      bool valid;
+      switch (instr->type) {
+      case nir_instr_type_load_const:
+         valid = mgc_vector_define(ctx, &nir_instr_as_load_const(instr)->def);
+         break;
+      case nir_instr_type_alu:
+         valid = mgc_vector_validate_alu(ctx, nir_instr_as_alu(instr));
+         break;
+      case nir_instr_type_intrinsic:
+         valid = mgc_vector_validate_intrinsic(ctx, nir_instr_as_intrinsic(instr));
+         break;
+      default:
+         return mgc_vector_error(ctx, "mgc vector: unsupported NIR instruction type %u", instr->type);
+      }
+      if (!valid)
+         return false;
+   }
+   nir_foreach_instr(instr, ctx->block) {
+      if (instr->type != nir_instr_type_load_const)
+         continue;
+      nir_load_const_instr *load = nir_instr_as_load_const(instr);
+      struct mgc_vector_value *value = &ctx->values[load->def.index];
+      if (value->roles == MGC_VECTOR_ADDRESS) {
+         value->literal = nir_const_value_as_uint(load->value[0], 32);
+      } else {
+         float literal = nir_const_value_as_float(load->value[0], 32);
+         uint16_t half = _mesa_float_to_half(literal);
+         if (!isfinite(literal) || (half & 0x7c00) == 0x7c00)
+            return mgc_vector_error(ctx, "mgc vector: constants must be finite representable FP16 values");
+         value->literal = half;
+      }
+   }
+   return true;
+}
+
+static bool
+mgc_vector_spacing(struct mgc_vector_ctx *ctx)
+{
+   for (unsigned spacing = 0; spacing < MGC_VECTOR_SPACING_NOPS; spacing++) {
+      if (!mgc_vector_append(ctx, 1, "nop\n"))
+         return false;
+   }
+   return true;
+}
+
+static bool
+mgc_vector_immediate(struct mgc_vector_ctx *ctx, uint32_t value, unsigned reg)
+{
+   return mgc_vector_append(ctx, 2, "movi_i32 %u, r%u\n", value, reg);
+}
+
+static bool
+mgc_vector_broadcast(struct mgc_vector_ctx *ctx, unsigned scalar, unsigned vector)
+{
+   ctx->stats.registers = MAX2(ctx->stats.registers, vector + 1);
+   return mgc_vector_append(ctx, 1, "vbcast r%u, v%u\n", scalar, vector) &&
+          mgc_vector_spacing(ctx);
+}
+
+static bool
+mgc_vector_extract(struct mgc_vector_ctx *ctx, unsigned vector, unsigned scalar)
+{
+   return mgc_vector_append(ctx, 1, "vget_lane0_i32 v%u, r%u\n", vector, scalar) &&
+          mgc_vector_spacing(ctx);
+}
+
+static bool
+mgc_vector_binary(struct mgc_vector_ctx *ctx, const char *operation,
+                  unsigned left, unsigned right, unsigned destination)
+{
+   ctx->stats.registers = MAX2(ctx->stats.registers, destination + 1);
+   return mgc_vector_append(ctx, 1, "%s v%u, v%u, v%u\n",
+                            operation, left, right, destination) &&
+          mgc_vector_spacing(ctx);
+}
+
+static bool
+mgc_vector_constant(struct mgc_vector_ctx *ctx, float value, unsigned vector)
+{
+   return mgc_vector_immediate(ctx, _mesa_float_to_half(value), 2) &&
+          mgc_vector_broadcast(ctx, 2, vector);
+}
+
+static bool
+mgc_vector_load_address(struct mgc_vector_ctx *ctx, uint32_t address,
+                        unsigned vector)
+{
+   if (!mgc_vector_immediate(ctx, address, 1) ||
+       !mgc_vector_append(ctx, 1, "load r1, r0\n") ||
+       !mgc_vector_append(ctx, 4, "wait_load\n"))
+      return false;
+   ctx->stats.waits++;
+   ctx->stats.waits_before_scheduling++;
+   return mgc_vector_broadcast(ctx, 0, vector);
+}
+
+static bool
+mgc_vector_load_source(struct mgc_vector_ctx *ctx, nir_src source, unsigned vector)
+{
+   uint32_t address;
+   unsigned slot = ctx->values[source.ssa->index].slot;
+   if (!mgc_vector_address(ctx, ctx->output_base,
+                           MGC_VECTOR_SCRATCH_FIRST_WORD + slot, &address) ||
+       !mgc_vector_load_address(ctx, address, vector))
+      return false;
+   ctx->stats.spill_loads++;
+   return true;
+}
+
+static bool
+mgc_vector_store_definition(struct mgc_vector_ctx *ctx, nir_def *def, unsigned vector)
+{
+   uint32_t address;
+   unsigned slot = ctx->values[def->index].slot;
+   if (!mgc_vector_address(ctx, ctx->output_base,
+                           MGC_VECTOR_SCRATCH_FIRST_WORD + slot, &address) ||
+       !mgc_vector_extract(ctx, vector, 0) ||
+       !mgc_vector_immediate(ctx, address, 1) ||
+       !mgc_vector_append(ctx, 1, "store r0, r1\n"))
+      return false;
+   ctx->stats.spill_stores++;
+   return true;
+}
+
+static bool
+mgc_vector_error_guard(struct mgc_vector_ctx *ctx, unsigned left, unsigned right)
+{
+   if (!mgc_vector_append(ctx, 1, "icmp_ge r%u, r%u, cr0\n", left, right))
+      return false;
+   if (!ctx->has_error_jump) {
+      ctx->first_error_jump = ctx->stats.instructions;
+      ctx->has_error_jump = true;
+   }
+   ctx->stats.predicates = 1;
+   return mgc_vector_append(ctx, 1, "[!cr0] jump mgc_vector_error_exit\n");
+}
+
+static bool
+mgc_vector_rsq(struct mgc_vector_ctx *ctx, bool square_root)
+{
+   unsigned label = ctx->rsq_labels++;
+   if (!mgc_vector_constant(ctx, 1.0f, 2) ||
+       !mgc_vector_binary(ctx, "vfmul16", 0, 2, 0) ||
+       !mgc_vector_extract(ctx, 0, 0))
+      return false;
+   if (square_root) {
+      if (!mgc_vector_immediate(ctx, 0, 1) ||
+          !mgc_vector_append(ctx, 1, "icmp_ge r1, r0, cr0\n") ||
+          !mgc_vector_append(ctx, 1, "[!cr0] jump mgc_vector_sqrt_nonzero_%u\n", label) ||
+          !mgc_vector_immediate(ctx, 0, 2) ||
+          !mgc_vector_broadcast(ctx, 2, 1) ||
+          !mgc_vector_append(ctx, 1, "jump mgc_vector_rsq_result_%u\n", label) ||
+          !mgc_vector_append(ctx, 0, "mgc_vector_sqrt_nonzero_%u:\n", label))
+         return false;
+   }
+   if (!mgc_vector_immediate(ctx, 1, 1) ||
+       !mgc_vector_error_guard(ctx, 0, 1) ||
+       !mgc_vector_immediate(ctx, 0x7bff, 1) ||
+       !mgc_vector_error_guard(ctx, 1, 0) ||
+       !mgc_vector_immediate(ctx, _mesa_float_to_half(ldexpf(0.632455532f, 12)), 2))
+      return false;
+   for (int exponent = -11; exponent <= 7; exponent++) {
+      uint16_t threshold = _mesa_float_to_half(ldexpf(1.0f, exponent * 2));
+      uint16_t seed = _mesa_float_to_half(ldexpf(0.632455532f, -exponent));
+      if (!mgc_vector_immediate(ctx, threshold, 1) ||
+          !mgc_vector_append(ctx, 1, "icmp_ge r0, r1, cr0\n") ||
+          !mgc_vector_append(ctx, 1, "[!cr0] jump mgc_vector_rsq_seed_%u\n", label) ||
+          !mgc_vector_immediate(ctx, seed, 2))
+         return false;
+   }
+   if (!mgc_vector_append(ctx, 0, "mgc_vector_rsq_seed_%u:\n", label) ||
+       !mgc_vector_broadcast(ctx, 2, 1) ||
+       !mgc_vector_constant(ctx, 0.5f, 2) ||
+       !mgc_vector_constant(ctx, 1.5f, 3))
+      return false;
+   for (unsigned iteration = 0; iteration < 6; iteration++) {
+      if (!mgc_vector_binary(ctx, "vfmul16", 0, 1, 4) ||
+          !mgc_vector_binary(ctx, "vfmul16", 4, 1, 4) ||
+          !mgc_vector_binary(ctx, "vfmul16", 4, 2, 4) ||
+          !mgc_vector_binary(ctx, "vfsub16", 3, 4, 4) ||
+          !mgc_vector_binary(ctx, "vfmul16", 4, 1, 1))
+         return false;
+   }
+   if (square_root && !mgc_vector_binary(ctx, "vfmul16", 0, 1, 1))
+      return false;
+   return mgc_vector_append(ctx, 0, "mgc_vector_rsq_result_%u:\n", label);
+}
+
+static bool
+mgc_vector_emit_alu(struct mgc_vector_ctx *ctx, nir_alu_instr *alu)
+{
+   for (unsigned source = 0; source < nir_op_infos[alu->op].num_inputs; source++) {
+      if (!mgc_vector_load_source(ctx, alu->src[source].src, source))
+         return false;
+   }
+   unsigned result = 0;
+   bool success;
+   switch (alu->op) {
+   case nir_op_mov:
+      success = true;
+      break;
+   case nir_op_fadd:
+   case nir_op_fsub:
+   case nir_op_fmul:
+   case nir_op_fmax: {
+      const char *operation = alu->op == nir_op_fadd ? "vfadd16" :
+         alu->op == nir_op_fsub ? "vfsub16" :
+         alu->op == nir_op_fmul ? "vfmul16" : "vfmax16";
+      result = 2;
+      success = mgc_vector_binary(ctx, operation, 0, 1, result);
+      break;
+   }
+   case nir_op_fneg:
+      result = 2;
+      success = mgc_vector_constant(ctx, -1.0f, 1) &&
+                mgc_vector_binary(ctx, "vfmul16", 0, 1, result);
+      break;
+   case nir_op_fabs:
+      result = 2;
+      success = mgc_vector_constant(ctx, -1.0f, 1) &&
+                mgc_vector_binary(ctx, "vfmul16", 0, 1, result) &&
+                mgc_vector_binary(ctx, "vfmax16", 0, result, result) &&
+                mgc_vector_constant(ctx, 0.0f, 1) &&
+                mgc_vector_binary(ctx, "vfadd16", result, 1, result);
+      break;
+   case nir_op_fmin:
+      success = mgc_vector_constant(ctx, -1.0f, 2) &&
+                mgc_vector_binary(ctx, "vfmul16", 0, 2, 0) &&
+                mgc_vector_binary(ctx, "vfmul16", 1, 2, 1) &&
+                mgc_vector_binary(ctx, "vfmax16", 0, 1, 0) &&
+                mgc_vector_binary(ctx, "vfmul16", 0, 2, 0);
+      break;
+   case nir_op_ffma:
+      result = 3;
+      success = mgc_vector_binary(ctx, "vfmul16", 0, 1, result) &&
+                mgc_vector_binary(ctx, "vfadd16", result, 2, result);
+      break;
+   case nir_op_frsq:
+   case nir_op_fsqrt:
+      result = 1;
+      success = mgc_vector_rsq(ctx, alu->op == nir_op_fsqrt);
+      break;
+   case nir_op_frcp: {
+      nir_alu_instr *rsq = nir_instr_as_alu(alu->src[0].src.ssa->parent_instr);
+      result = 2;
+      success = mgc_vector_load_source(ctx, rsq->src[0].src, 1) &&
+                mgc_vector_binary(ctx, "vfmul16", 0, 1, result);
+      break;
+   }
+   default:
+      return mgc_vector_error(ctx, "mgc vector: unsupported ALU reached emission");
+   }
+   return success && mgc_vector_store_definition(ctx, &alu->def, result);
+}
+
+static bool
+mgc_vector_status(struct mgc_vector_ctx *ctx, unsigned status)
+{
+   uint32_t address;
+   return mgc_vector_address(ctx, ctx->output_base, MGC_VECTOR_STATUS_WORD, &address) &&
+          mgc_vector_immediate(ctx, status, 0) &&
+          mgc_vector_immediate(ctx, address, 1) &&
+          mgc_vector_append(ctx, 1, "store r0, r1\n");
+}
+
+static bool
+mgc_vector_emit_program(struct mgc_vector_ctx *ctx, nir_shader *nir)
+{
+   if (!mgc_vector_append(ctx, 0, "; mgc " MGC_VECTOR_COMPILER_TARGET
+                          " backend, ABI=2, stage=%s\n",
+                          nir->info.stage == MESA_SHADER_VERTEX ? "vertex" : "fragment") ||
+       !mgc_vector_append(ctx, 0,
+                          "; fp16-hardware-v1 words; four broadcast lanes, not four fragments\n"
+                          "; explicit nop spacing is PROVISIONAL, not verified vector waits\n") ||
+       !mgc_vector_status(ctx, MGC_VECTOR_STATUS_PENDING))
+      return false;
+   nir_foreach_instr(instr, ctx->block) {
+      switch (instr->type) {
+      case nir_instr_type_load_const: {
+         nir_load_const_instr *load = nir_instr_as_load_const(instr);
+         if (!mgc_vector_immediate(ctx, ctx->values[load->def.index].literal, 0) ||
+             !mgc_vector_broadcast(ctx, 0, 0) ||
+             !mgc_vector_store_definition(ctx, &load->def, 0))
+            return false;
+         break;
+      }
+      case nir_instr_type_alu:
+         if (!mgc_vector_emit_alu(ctx, nir_instr_as_alu(instr)))
+            return false;
+         break;
+      case nir_instr_type_intrinsic: {
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic == nir_intrinsic_store_output)
+            break;
+         uint32_t address;
+         if (!mgc_vector_io_address(ctx, intr, &address) ||
+             !mgc_vector_load_address(ctx, address, 0) ||
+             !mgc_vector_store_definition(ctx, &intr->def, 0))
+            return false;
+         break;
+      }
+      default:
+         return mgc_vector_error(ctx, "mgc vector: unsupported NIR reached emission");
+      }
+   }
+   nir_foreach_instr(instr, ctx->block) {
+      if (instr->type != nir_instr_type_intrinsic)
+         continue;
+      nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+      if (intr->intrinsic != nir_intrinsic_store_output || !nir_intrinsic_write_mask(intr))
+         continue;
+      uint32_t address;
+      if (!mgc_vector_io_address(ctx, intr, &address) ||
+          !mgc_vector_load_source(ctx, intr->src[0], 0) ||
+          !mgc_vector_extract(ctx, 0, 0) ||
+          !mgc_vector_immediate(ctx, address, 1) ||
+          !mgc_vector_append(ctx, 1, "store r0, r1\n"))
+         return false;
+   }
+   if (!mgc_vector_status(ctx, MGC_VECTOR_STATUS_COMMITTED))
+      return false;
+   if (ctx->has_error_jump) {
+      if (!mgc_vector_append(ctx, 1, "jump mgc_vector_eof\n"))
+         return false;
+      unsigned error_pc = ctx->stats.instructions;
+      if (error_pc - ctx->first_error_jump - 1 >= (1u << 17))
+         return mgc_vector_error(ctx, "mgc vector: error exit exceeds observed signed 18-bit branch range");
+      if (!mgc_vector_append(ctx, 0, "mgc_vector_error_exit:\n") ||
+          !mgc_vector_status(ctx, MGC_VECTOR_STATUS_ERROR) ||
+          !mgc_vector_append(ctx, 0, "mgc_vector_eof:\n"))
+         return false;
+   }
+   return true;
+}
+
+bool
+mgc_vector_emit(struct nir_shader *nir, struct mgc_shader *shader)
+{
+   if (!shader)
+      return false;
+   shader->asm_text = NULL;
+   shader->stats = (struct mgc_compile_stats){0};
+   if (shader->error)
+      return false;
+   struct mgc_vector_ctx ctx = {.shader = shader};
+   if (!nir)
+      return mgc_vector_error(&ctx, "mgc vector: missing prepared NIR shader");
+   ctx.mem_ctx = ralloc_context(shader);
+   if (!ctx.mem_ctx)
+      return mgc_vector_error(&ctx, "mgc vector: compiler allocation failed");
+   bool success = mgc_vector_validate(&ctx, nir);
+   if (success) {
+      ctx.text = ralloc_strdup(ctx.mem_ctx, "");
+      if (!ctx.text)
+         success = mgc_vector_error(&ctx, "mgc vector: assembly allocation failed");
+      else
+         success = mgc_vector_emit_program(&ctx, nir);
+   }
+   if (success) {
+      ralloc_steal(shader, ctx.text);
+      shader->asm_text = ctx.text;
+      shader->program_format = "fp16-hardware-v1";
+      shader->stats = ctx.stats;
+   }
+   ralloc_free(ctx.mem_ctx);
+   return success;
+}
