+      mode, artifact->draw->start, artifact->draw->count, artifact->info->index_size,
+      artifact->info->index_size ? artifact->draw->index_bias : 0, artifact->info->instance_count,
+      artifact->info->start_instance, artifact->info->primitive_restart ? "true" : "false",
+      artifact->info->primitive_restart ? artifact->info->restart_index : 0);
