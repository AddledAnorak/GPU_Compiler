+static void
+mgc_emit_load(struct mgc_ctx *ctx, nir_intrinsic_instr *intr)
+{
+   if (ctx->options.host_features_version && intr->intrinsic == nir_intrinsic_load_ubo_vec4 &&
+       nir_src_is_const(intr->src[0]) && nir_src_as_uint(intr->src[0]) == 20 &&
+       nir_intrinsic_base(intr) == 3 && nir_src_is_const(intr->src[1])) {
+      unsigned component = nir_src_as_uint(intr->src[1]);
+      int address = mgc_alloc_reg(ctx);
+      int destination = mgc_alloc_destination(ctx, &intr->def);
+      ralloc_asprintf_append(&ctx->asm_text, "movi_i32 %u, r%d\nload r%d, r%d\nwait_load\n",
+         ctx->options.input_base + MGC_HOST_FRAG_COORD_WORD + component, address, address, destination);
+      mgc_free_reg(ctx, address);
+      ctx->host_builtin_mask |= MGC_HOST_BUILTIN_FRAG_COORD;
+      ctx->host_frag_coord_components |= 1u << component;
+      ctx->vals[intr->def.index] = (struct mgc_val){.kind = MGC_VAL_REG, .index = destination};
+      return;
+   }
+   if (ctx->options.host_features_version && ctx->host_texture &&
+       intr->intrinsic == nir_intrinsic_load_ubo_vec4 && nir_src_is_const(intr->src[0]) &&
+       nir_src_as_uint(intr->src[0]) >= MGC_HOST_INTERNAL_TEXTURE_BLOCK &&
+       nir_src_as_uint(intr->src[0]) < MGC_HOST_INTERNAL_TEXTURE_BLOCK + 4) {
+      mgc_emit_host_texture_load(ctx, intr, nir_src_as_uint(intr->src[0]) - MGC_HOST_INTERNAL_TEXTURE_BLOCK);
+      return;
+   }
+   if (intr->num_components != 1 ||
+       (intr->def.bit_size != 16 && intr->def.bit_size != 32)) {
+      mgc_error(ctx, "mgc: loads require scalar 16-bit or 32-bit floating values");
+      return;
+   }
+   if (nir_intrinsic_has_dest_type(intr) &&
+       nir_intrinsic_dest_type(intr) != nir_type_invalid &&
+       nir_alu_type_get_base_type(nir_intrinsic_dest_type(intr)) != nir_type_float) {
+      mgc_error(ctx, "mgc: integer and boolean input/uniform loads are not supported");
+      return;
+   }
+   uint32_t offset, block = 0, address;
+   uint64_t word_offset;
+   uint32_t base = ctx->options.uniform_base;
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_input:
+      if (!mgc_constant_offset(ctx, intr->src[0], &offset))
+         return;
+      base = ctx->options.input_base;
+      word_offset = ((uint64_t)nir_intrinsic_base(intr) + offset) * 4 +
+                    nir_intrinsic_component(intr);
+      if (ctx->options.host_instancing_version && word_offset == MGC_HOST_INSTANCE_ID_WORD) {
+         mgc_error(ctx, "mgc: ordinary input aliases the reserved host instance ID word");
+         return;
+      }
+      if (ctx->options.host_features_version &&
+          (word_offset >= MGC_HOST_FEATURES_INPUT_RESERVED || word_offset == MGC_HOST_DERIVATIVE_RESPONSE_WORD)) {
+         mgc_error(ctx, "mgc: ordinary input aliases reserved ABI4 host words");
+         return;
+      }
+      break;
+   case nir_intrinsic_load_uniform:
+      if (!mgc_constant_offset(ctx, intr->src[0], &offset))
+         return;
+      word_offset = (uint64_t)nir_intrinsic_base(intr) + offset;
+      break;
+   case nir_intrinsic_load_ubo_vec4:
+      if (!mgc_constant_offset(ctx, intr->src[0], &block))
+         return;
+      if (ctx->host_texture && block == MGC_HOST_TEXTURE_BLOCK &&
+          nir_intrinsic_base(intr) == 1 && nir_intrinsic_component(intr) < 4 &&
+          !nir_src_is_const(intr->src[1])) {
+         struct mgc_val index = mgc_integer_val(ctx, intr->src[1].ssa);
+         int temporary = mgc_alloc_reg(ctx);
+         int address_reg = mgc_alloc_reg(ctx);
+         int dst = mgc_alloc_destination(ctx, &intr->def);
+         char source[8];
+         mgc_val_str(index, source);
+         if (ctx->error)
+            return;
+         uint32_t texture_base = base + MGC_HOST_TEXTURE_BLOCK * MGC_UBO_STRIDE_WORDS +
+                                 4 + nir_intrinsic_component(intr);
+         ralloc_asprintf_append(&ctx->asm_text,
+                                 "add %s, %s, r%d\nwait_short\n"
+                                 "add r%d, r%d, r%d\nwait_short\n"
+                                 "movi_i32 %u, r%d\nadd r%d, r%d, r%d\nwait_short\n"
+                                 "load r%d, r%d\nwait_load\n",
+                                 source, source, temporary, temporary, temporary, temporary,
+                                 texture_base, address_reg, temporary, address_reg, address_reg,
+                                 address_reg, dst);
+         mgc_free_reg(ctx, address_reg);
+         mgc_free_reg(ctx, temporary);
+         ctx->vals[intr->def.index] = (struct mgc_val){ .kind = MGC_VAL_REG, .index = dst };
+         return;
+      }
+      if (!mgc_constant_offset(ctx, intr->src[1], &offset))
+         return;
+      word_offset = ((uint64_t)nir_intrinsic_base(intr) + offset) * 4 +
+                    nir_intrinsic_component(intr);
+      break;
+   case nir_intrinsic_load_ubo:
+      if (intr->def.bit_size != 32) {
+         mgc_error(ctx, "mgc: byte-addressed UBO loads require logical FP32 layout");
+         return;
+      }
+      if (!mgc_constant_offset(ctx, intr->src[0], &block) ||
+          !mgc_constant_offset(ctx, intr->src[1], &offset))
+         return;
+      if (offset % 4) {
+         mgc_error(ctx, "mgc: UBO byte offsets must be aligned to four bytes");
+         return;
+      }
+      word_offset = offset / 4;
+      break;
+   default:
+      unreachable("unsupported load");
+   }
+   if (intr->intrinsic == nir_intrinsic_load_ubo ||
+       intr->intrinsic == nir_intrinsic_load_ubo_vec4) {
+      if (word_offset >= MGC_UBO_STRIDE_WORDS ||
+          block >= MGC_ABI_REGION_WORDS / MGC_UBO_STRIDE_WORDS) {
+         mgc_error(ctx, "mgc: UBO access exceeds sixteen blocks of 4096 scalar words");
+         return;
+      }
+      word_offset += (uint64_t)block * MGC_UBO_STRIDE_WORDS;
+   }
+   if (!mgc_address(ctx, base, word_offset, &address))
+      return;
+   int address_reg = mgc_alloc_reg(ctx);
+   int dst = mgc_alloc_destination(ctx, &intr->def);
+   ralloc_asprintf_append(&ctx->asm_text,
+                           "movi_i32 %u, r%d\nload r%d, r%d\nwait_load\n",
+                           address, address_reg, address_reg, dst);
+   mgc_free_reg(ctx, address_reg);
+   ctx->vals[intr->def.index] = (struct mgc_val){ .kind = MGC_VAL_REG, .index = dst };
+}
