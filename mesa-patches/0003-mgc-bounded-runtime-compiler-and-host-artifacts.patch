+                                       MGC_HOST_CAPTURE_MAX_TEXT_BYTES + 1);
+      layout_sizes[stage] = strnlen(artifact->layout[stage],
+                                     MGC_HOST_CAPTURE_MAX_TEXT_BYTES + 1);
+      if (!assembly_sizes[stage] || assembly_sizes[stage] > MGC_HOST_CAPTURE_MAX_TEXT_BYTES ||
+          !layout_sizes[stage] || layout_sizes[stage] > MGC_HOST_CAPTURE_MAX_TEXT_BYTES ||
+          !mgc_capture_layout_valid(artifact->layout[stage], layout_sizes[stage],
