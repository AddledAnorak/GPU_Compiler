+   case MESA_PRIM_LINE_LOOP: return "line_loop";
+   case MESA_PRIM_LINE_STRIP: return "line_strip";
+   case MESA_PRIM_TRIANGLES: return "triangles";
+   case MESA_PRIM_TRIANGLE_STRIP: return "triangle_strip";
