+      return mgc_executor_state_error(reason, "unsupported rasterizer feature or non-GL-FBO pixel/edge state");
+   const struct pipe_viewport_state *viewport = &ctx->viewport;
+   for (unsigned axis = 0; axis < 3; axis++) {
+      if (!isfinite(viewport->scale[axis]) || !isfinite(viewport->translate[axis]))
+         return mgc_executor_state_error(reason, "viewport contains nonfinite values");
+   }
+   if (viewport->scale[0] != ctx->framebuffer.width * 0.5f ||
+       viewport->translate[0] != ctx->framebuffer.width * 0.5f ||
+       viewport->scale[1] != ctx->framebuffer.height * 0.5f ||
+       viewport->translate[1] != ctx->framebuffer.height * 0.5f ||
+       viewport->scale[2] != 0.5f || viewport->translate[2] != 0.5f ||
+       viewport->swizzle_x != PIPE_VIEWPORT_SWIZZLE_POSITIVE_X ||
+       viewport->swizzle_y != PIPE_VIEWPORT_SWIZZLE_POSITIVE_Y ||
+       viewport->swizzle_z != PIPE_VIEWPORT_SWIZZLE_POSITIVE_Z ||
+       viewport->swizzle_w != PIPE_VIEWPORT_SWIZZLE_POSITIVE_W)
+      return mgc_executor_state_error(reason, "viewport is not full, unflipped GL FBO with identity swizzle/default depth range");
+   *depth_test = depth->depth_enabled;
+   return true;
+}
+
+static unsigned
+mgc_features_color_format(enum pipe_format format, const char **name, unsigned *blocksize)
+{
+   switch (format) {
+   case PIPE_FORMAT_R8G8B8A8_UNORM: *name = "rgba8"; *blocksize = 4; return 1;
+   case PIPE_FORMAT_B8G8R8A8_UNORM: *name = "bgra8"; *blocksize = 4; return 2;
+   case PIPE_FORMAT_B5G6R5_UNORM: *name = "rgb565"; *blocksize = 2; return 3;
+   case PIPE_FORMAT_R8_UNORM: *name = "r8"; *blocksize = 1; return 4;
+   default: return 0;
+   }
+}
+
+static unsigned
+mgc_features_depth_format(enum pipe_format format, const char **name, unsigned *blocksize)
+{
+   switch (format) {
+   case PIPE_FORMAT_Z16_UNORM: *name = "z16"; *blocksize = 2; return 1;
+   case PIPE_FORMAT_Z24_UNORM_S8_UINT: *name = "z24s8"; *blocksize = 4; return 2;
+   default: return 0;
+   }
+}
+
+static bool
+mgc_features_targets_valid(struct mgc_context *ctx, struct pipe_resource *color,
+                            struct pipe_resource *depth, unsigned expected_executions)
+{
+   const struct pipe_framebuffer_state *framebuffer = &ctx->framebuffer;
+   const char *name = NULL;
+   unsigned color_bytes = 0, depth_bytes = 0;
+   if (!color || !mgc_features_color_format(color->format, &name, &color_bytes) ||
+       (depth && !mgc_features_depth_format(depth->format, &name, &depth_bytes)) ||
+       framebuffer->nr_cbufs != 1 || framebuffer->resolve || framebuffer->viewmask ||
+       framebuffer->layers > 1 || framebuffer->samples > 1 ||
+       framebuffer->zsbuf.texture != depth || color == depth)
+      return false;
+   return mgc_executor_resource_valid(ctx, color, &framebuffer->cbufs[0],
+      color->format, color_bytes, expected_executions) &&
+      (!depth || mgc_executor_resource_valid(ctx, depth, &framebuffer->zsbuf,
+         depth->format, depth_bytes, expected_executions));
+}
+
+static const char *
+mgc_features_blend_factor(unsigned factor)
+{
+   switch (factor) {
+   case PIPE_BLENDFACTOR_ZERO: return "zero";
+   case PIPE_BLENDFACTOR_ONE: return "one";
+   case PIPE_BLENDFACTOR_SRC_COLOR: return "src-color";
+   case PIPE_BLENDFACTOR_INV_SRC_COLOR: return "one-minus-src-color";
+   case PIPE_BLENDFACTOR_DST_COLOR: return "dst-color";
+   case PIPE_BLENDFACTOR_INV_DST_COLOR: return "one-minus-dst-color";
+   case PIPE_BLENDFACTOR_SRC_ALPHA: return "src-alpha";
+   case PIPE_BLENDFACTOR_INV_SRC_ALPHA: return "one-minus-src-alpha";
+   case PIPE_BLENDFACTOR_DST_ALPHA: return "dst-alpha";
+   case PIPE_BLENDFACTOR_INV_DST_ALPHA: return "one-minus-dst-alpha";
+   case PIPE_BLENDFACTOR_CONST_COLOR: return "constant-color";
+   case PIPE_BLENDFACTOR_INV_CONST_COLOR: return "one-minus-constant-color";
+   case PIPE_BLENDFACTOR_CONST_ALPHA: return "constant-alpha";
+   case PIPE_BLENDFACTOR_INV_CONST_ALPHA: return "one-minus-constant-alpha";
+   case PIPE_BLENDFACTOR_SRC_ALPHA_SATURATE: return "src-alpha-saturate";
+   default: return NULL;
+   }
+}
+
+static const char *
+mgc_features_blend_equation(unsigned equation)
+{
+   switch (equation) {
+   case PIPE_BLEND_ADD: return "add";
+   case PIPE_BLEND_SUBTRACT: return "subtract";
+   case PIPE_BLEND_REVERSE_SUBTRACT: return "reverse-subtract";
+   case PIPE_BLEND_MIN: return "min";
+   case PIPE_BLEND_MAX: return "max";
+   default: return NULL;
+   }
+}
+
+static const char *
+mgc_features_comparison(unsigned comparison)
+{
+   const char *names[] = {"never", "less", "equal", "lequal", "greater", "notequal", "gequal", "always"};
+   return comparison < ARRAY_SIZE(names) ? names[comparison] : NULL;
+}
+
+static const char *
+mgc_features_stencil_op(unsigned operation)
+{
+   const char *names[] = {"keep", "zero", "replace", "increment-clamp", "decrement-clamp",
+                          "increment-wrap", "decrement-wrap", "invert"};
+   return operation < ARRAY_SIZE(names) ? names[operation] : NULL;
+}
+
+static bool
+mgc_features_capture_state_locked(struct mgc_context *ctx, char *output,
+                                   size_t capacity, size_t *size, unsigned expected_executions)
+{
+   if (!ctx || !output || !size || !capacity ||
+       ctx->host_features_version != MGC_HOST_FEATURES_VERSION ||
+       !ctx->blend_state_valid || !ctx->rasterizer_state_valid ||
+       !ctx->depth_stencil_state_valid || !ctx->viewport_valid || !(ctx->sample_mask & 1))
+      return false;
+   struct pipe_resource *color = ctx->framebuffer.cbufs[0].texture;
+   struct pipe_resource *attachment = ctx->framebuffer.zsbuf.texture;
+   if (!mgc_features_targets_valid(ctx, color, attachment, expected_executions))
+      return false;
+   const struct pipe_blend_state *blend = &ctx->blend_state;
+   const struct pipe_rt_blend_state *target = &blend->rt[0];
+   const struct pipe_depth_stencil_alpha_state *depth = &ctx->depth_stencil_state;
+   if (blend->independent_blend_enable || blend->max_rt || blend->logicop_enable || blend->dither ||
+       blend->alpha_to_coverage || blend->alpha_to_coverage_dither || blend->alpha_to_one ||
+       blend->advanced_blend_func || blend->blend_coherent || depth->depth_bounds_test || depth->alpha_enabled ||
+       (depth->depth_enabled && !attachment) ||
+       (depth->stencil[0].enabled && (!attachment || attachment->format != PIPE_FORMAT_Z24_UNORM_S8_UINT)) ||
+       (!depth->stencil[0].enabled && depth->stencil[1].enabled))
+      return false;
+   for (unsigned index = 1; index < PIPE_MAX_COLOR_BUFS; index++) {
+      if (blend->rt[index].blend_enable || ctx->framebuffer.cbufs[index].texture)
+         return false;
+   }
+   const char *factors[] = {
+      mgc_features_blend_factor(target->rgb_src_factor), mgc_features_blend_factor(target->rgb_dst_factor),
+      mgc_features_blend_factor(target->alpha_src_factor), mgc_features_blend_factor(target->alpha_dst_factor),
+   };
+   const char *equations[] = {mgc_features_blend_equation(target->rgb_func), mgc_features_blend_equation(target->alpha_func)};
+   for (unsigned index = 0; index < ARRAY_SIZE(factors); index++) {
+      if (!factors[index]) {
+         if (target->blend_enable)
+            return false;
+         factors[index] = index & 1 ? "zero" : "one";
+      }
+   }
+   for (unsigned index = 0; index < ARRAY_SIZE(equations); index++) {
+      if (!equations[index]) {
+         if (target->blend_enable)
+            return false;
+         equations[index] = "add";
+      }
+   }
+   const struct pipe_rasterizer_state *rasterizer = &ctx->rasterizer_state;
+   if (rasterizer->scissor || rasterizer->cull_face != PIPE_FACE_NONE ||
+       rasterizer->rasterizer_discard || rasterizer->fill_front != PIPE_POLYGON_MODE_FILL ||
+       rasterizer->fill_back != PIPE_POLYGON_MODE_FILL || rasterizer->flatshade || rasterizer->light_twoside ||
+       rasterizer->clamp_vertex_color || rasterizer->offset_point || rasterizer->offset_line || rasterizer->offset_tri ||
+       rasterizer->poly_smooth || rasterizer->poly_stipple_enable || rasterizer->multisample ||
+       rasterizer->force_persample_interp || rasterizer->conservative_raster_mode ||
+       rasterizer->subpixel_precision_x || rasterizer->subpixel_precision_y || rasterizer->depth_clamp ||
+       !rasterizer->depth_clip_near || !rasterizer->depth_clip_far || rasterizer->clip_halfz ||
+       rasterizer->clip_plane_enable || !rasterizer->half_pixel_center || rasterizer->bottom_edge_rule ||
+       rasterizer->tile_raster_order_fixed)
+      return false;
+   const struct pipe_viewport_state *viewport = &ctx->viewport;
+   if (rasterizer->front_ccw)
+      return false;
+   if (viewport->scale[0] != ctx->framebuffer.width * 0.5f ||
+       viewport->translate[0] != ctx->framebuffer.width * 0.5f ||
+       viewport->scale[1] != ctx->framebuffer.height * 0.5f ||
+       viewport->translate[1] != ctx->framebuffer.height * 0.5f ||
+       viewport->scale[2] != 0.5f || viewport->translate[2] != 0.5f ||
+       viewport->swizzle_x != PIPE_VIEWPORT_SWIZZLE_POSITIVE_X ||
+       viewport->swizzle_y != PIPE_VIEWPORT_SWIZZLE_POSITIVE_Y ||
+       viewport->swizzle_z != PIPE_VIEWPORT_SWIZZLE_POSITIVE_Z ||
+       viewport->swizzle_w != PIPE_VIEWPORT_SWIZZLE_POSITIVE_W)
+      return false;
+   const char *color_name = NULL, *depth_name = "none";
+   unsigned blocksize;
+   mgc_features_color_format(color->format, &color_name, &blocksize);
+   if (attachment)
+      mgc_features_depth_format(attachment->format, &depth_name, &blocksize);
+   double constants[4];
+   for (unsigned index = 0; index < ARRAY_SIZE(constants); index++) {
+      if (!isfinite(ctx->blend_color.color[index]))
+         return false;
+      constants[index] = fmin(1, fmax(0, ctx->blend_color.color[index]));
+   }
+   char faces[2][512];
+   for (unsigned index = 0; index < 2; index++) {
+      unsigned face = index && depth->stencil[1].enabled ? 1 : 0;
+      const struct pipe_stencil_state *stencil = &depth->stencil[face];
+      int length = snprintf(faces[index], sizeof(faces[index]),
+         "{\"comparison\":\"%s\",\"reference\":%u,\"read_mask\":%u,\"write_mask\":%u,"
+         "\"fail\":\"%s\",\"zfail\":\"%s\",\"zpass\":\"%s\"}",
+         mgc_features_comparison(stencil->func), ctx->stencil_ref.ref_value[face],
+         stencil->valuemask, stencil->writemask, mgc_features_stencil_op(stencil->fail_op),
+         mgc_features_stencil_op(stencil->zfail_op), mgc_features_stencil_op(stencil->zpass_op));
+      if (length < 0 || (size_t)length >= sizeof(faces[index]))
+         return false;
+   }
+   int length = snprintf(output, capacity,
+      "{\"version\":1,\"framebuffer\":{\"color_format\":\"%s\",\"depth_stencil_format\":\"%s\"},"
+      "\"blend\":{\"enabled\":%s,\"src_rgb\":\"%s\",\"dst_rgb\":\"%s\",\"src_alpha\":\"%s\","
+      "\"dst_alpha\":\"%s\",\"rgb_equation\":\"%s\",\"alpha_equation\":\"%s\","
+      "\"constant\":[%.17g,%.17g,%.17g,%.17g]},\"color_mask\":[%s,%s,%s,%s],"
+      "\"depth\":{\"enabled\":%s,\"write\":%s,\"comparison\":\"%s\"},"
+      "\"stencil\":{\"enabled\":%s,\"front\":%s,\"back\":%s}}",
+      color_name, depth_name, target->blend_enable ? "true" : "false", factors[0], factors[1], factors[2], factors[3],
+      equations[0], equations[1], constants[0], constants[1], constants[2], constants[3],
+      target->colormask & PIPE_MASK_R ? "true" : "false", target->colormask & PIPE_MASK_G ? "true" : "false",
+      target->colormask & PIPE_MASK_B ? "true" : "false", target->colormask & PIPE_MASK_A ? "true" : "false",
+      depth->depth_enabled ? "true" : "false", depth->depth_writemask ? "true" : "false",
+      mgc_features_comparison(depth->depth_func), depth->stencil[0].enabled ? "true" : "false", faces[0], faces[1]);
+   if (length < 0 || (size_t)length >= capacity)
+      return false;
+   *size = length;
+   return true;
+}
+
+bool
+mgc_host_features_capture_state(struct mgc_context *ctx, char *output,
+                                 size_t capacity, size_t *size)
+{
+   if (!ctx)
+      return false;
+   simple_mtx_lock(&ctx->screen->lock);
+   bool valid = mgc_features_capture_state_locked(ctx, output, capacity, size, 0);
+   simple_mtx_unlock(&ctx->screen->lock);
+   return valid;
+}
+
+static int64_t
+mgc_executor_now(void)
+{
+   struct timespec now;
+   if (clock_gettime(CLOCK_MONOTONIC, &now))
+      return -1;
+   return (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+static bool
+mgc_executor_wait(int descriptor, short events, int64_t deadline)
+{
+   for (;;) {
+      int64_t now = mgc_executor_now();
+      if (now < 0 || now >= deadline)
+         return false;
+      struct pollfd pending = {.fd = descriptor, .events = events};
+      int result = poll(&pending, 1, (int)(deadline - now));
+      if (result < 0 && errno == EINTR)
+         continue;
+      return result > 0 && !(pending.revents & (POLLERR | POLLNVAL)) &&
+         (pending.revents & (events | POLLHUP));
+   }
+}
+
+static bool
+mgc_executor_transfer(int descriptor, void *data, size_t size,
+                       bool sending, int64_t deadline)
+{
+   size_t offset = 0;
+   while (offset < size) {
+      int64_t now = mgc_executor_now();
+      if (now < 0 || now >= deadline)
+         return false;
+      ssize_t transferred = sending ?
+         send(descriptor, (const uint8_t *)data + offset, size - offset, MSG_NOSIGNAL) :
+         recv(descriptor, (uint8_t *)data + offset, size - offset, 0);
+      if (transferred > 0) {
+         offset += transferred;
+         continue;
+      }
+      if (transferred < 0 && errno == EINTR)
+         continue;
+      if (transferred < 0 && (errno == EAGAIN || errno == EWOULDBLOCK) &&
+          mgc_executor_wait(descriptor, sending ? POLLOUT : POLLIN, deadline))
+         continue;
+      return false;
+   }
+   return true;
+}
+
+static void
+mgc_executor_put32(uint8_t *output, uint32_t value)
+{
+   for (unsigned index = 0; index < 4; index++)
+      output[index] = value >> (index * 8);
+}
+
+static void
+mgc_executor_put64(uint8_t *output, uint64_t value)
+{
+   for (unsigned index = 0; index < 8; index++)
+      output[index] = value >> (index * 8);
+}
+
+static void
+mgc_executor_put16(uint8_t *output, uint16_t value)
+{
+   output[0] = value;
+   output[1] = value >> 8;
+}
+
+static uint16_t
+mgc_executor_get16(const uint8_t *input)
+{
+   return (uint16_t)input[0] | (uint16_t)input[1] << 8;
+}
+
+static uint32_t
+mgc_executor_get32(const uint8_t *input)
+{
+   uint32_t value = 0;
+   for (unsigned index = 0; index < 4; index++)
+      value |= (uint32_t)input[index] << (index * 8);
+   return value;
+}
+
+static uint64_t
+mgc_executor_get64(const uint8_t *input)
+{
+   uint64_t value = 0;
+   for (unsigned index = 0; index < 8; index++)
+      value |= (uint64_t)input[index] << (index * 8);
+   return value;
+}
+
+static bool
+mgc_executor_exchange(struct mgc_context *ctx, uint64_t sequence,
+                       const char *json, size_t json_size, unsigned width,
+                       unsigned height, unsigned blend_mode,
+                       uint8_t *initial, uint8_t *image,
+                       uint8_t *initial_depth, uint8_t *depth_image, size_t depth_size,
+                       unsigned color_format, unsigned depth_format, size_t image_size)
+{
+   int64_t now = mgc_executor_now();
+   if (now < 0)
+      return false;
+   int64_t deadline = now + MGC_HOST_EXECUTOR_TIMEOUT_MS;
+   int descriptor = socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+   if (descriptor < 0)
+      return false;
+   struct sockaddr_un address = {.sun_family = AF_UNIX};
+   size_t path_length = strlen(ctx->host_executor_socket);
+   if (path_length >= sizeof(address.sun_path)) {
+      close(descriptor);
+      return false;
+   }
+   memcpy(address.sun_path, ctx->host_executor_socket, path_length + 1);
+   bool success = connect(descriptor, (struct sockaddr *)&address,
+      offsetof(struct sockaddr_un, sun_path) + path_length + 1) == 0;
+   if (!success && errno == EINPROGRESS && mgc_executor_wait(descriptor, POLLOUT, deadline)) {
+      int error = 0;
+      socklen_t length = sizeof(error);
+      success = !getsockopt(descriptor, SOL_SOCKET, SO_ERROR, &error, &length) &&
+         length == sizeof(error) && !error;
+   }
+   struct ucred peer;
+   socklen_t peer_size = sizeof(peer);
+   success = success && !getsockopt(descriptor, SOL_SOCKET, SO_PEERCRED, &peer, &peer_size) &&
+      peer_size == sizeof(peer) && peer.uid == geteuid();
+   bool features = ctx->host_features_version == MGC_HOST_FEATURES_VERSION;
+   uint8_t request[44] = {0};
+   size_t request_size = features ? 44 : depth_size ? 40 : 36;
+   memcpy(request, features ? "MGCHE04" : depth_size ? "MGCHE02" : "MGCHE01", 8);
+   mgc_executor_put32(request + 8, json_size);
+   mgc_executor_put64(request + 12, sequence);
+   mgc_executor_put32(request + 20, width);
+   mgc_executor_put32(request + 24, height);
+   if (features) {
+      mgc_executor_put32(request + 28, color_format);
+      mgc_executor_put32(request + 32, depth_format);
+      mgc_executor_put32(request + 36, image_size);
+      mgc_executor_put32(request + 40, depth_size);
+   } else {
+      mgc_executor_put32(request + 28, blend_mode);
+      mgc_executor_put32(request + 32, image_size);
+      mgc_executor_put32(request + 36, depth_size);
+   }
+   if (success)
+      success = mgc_executor_transfer(descriptor, request, request_size, true, deadline) &&
+         mgc_executor_transfer(descriptor, (void *)json, json_size, true, deadline) &&
+         mgc_executor_transfer(descriptor, initial, image_size, true, deadline) &&
+         mgc_executor_transfer(descriptor, initial_depth, depth_size, true, deadline) &&
+         !shutdown(descriptor, SHUT_WR);
+   uint8_t response[44];
+   size_t response_size = features ? 44 : depth_size ? 36 : 32;
+   if (success)
+      success = mgc_executor_transfer(descriptor, response, response_size, false, deadline) &&
+         !memcmp(response, features ? "MGCRG04" : depth_size ? "MGCRG02" : "MGCRG01", 8) &&
+         mgc_executor_get64(response + 8) == sequence &&
+         mgc_executor_get32(response + 16) == 0 &&
+         mgc_executor_get32(response + 20) == width &&
+         mgc_executor_get32(response + 24) == height &&
+         (features ?
+            mgc_executor_get32(response + 28) == color_format &&
+            mgc_executor_get32(response + 32) == depth_format &&
+            mgc_executor_get32(response + 36) == image_size &&
+            mgc_executor_get32(response + 40) == depth_size :
+            mgc_executor_get32(response + 28) == image_size &&
+            (!depth_size || mgc_executor_get32(response + 32) == depth_size)) &&
+         mgc_executor_transfer(descriptor, image, image_size, false, deadline) &&
+         mgc_executor_transfer(descriptor, depth_image, depth_size, false, deadline);
+   while (success) {
+      int64_t current = mgc_executor_now();
+      if (current < 0 || current >= deadline) {
+         success = false;
+         break;
+      }
+      uint8_t trailing;
+      ssize_t count = recv(descriptor, &trailing, 1, 0);
+      if (!count)
+         break;
+      if (count < 0 && errno == EINTR)
+         continue;
+      if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK) &&
+          mgc_executor_wait(descriptor, POLLIN, deadline))
+         continue;
+      success = false;
+   }
+   close(descriptor);
+   return success;
+}
+
+static bool
+mgc_features_execute(struct mgc_context *ctx, uint64_t sequence,
+                       const char *json, size_t json_size)
+{
+   const uint32_t endian_probe = 1;
+   if (*(const uint8_t *)&endian_probe != 1 || ctx->host_instancing_version)
+      return mgc_executor_error(ctx, "ABI4 native resources require little-endian bounded HOST FEATURES");
+   for (unsigned stage = 0; stage < MGC_RUNTIME_STAGES; stage++) {
+      const struct mgc_shader *shader = ctx->shaders[stage] ? ctx->shaders[stage]->shader : NULL;
+      if (!shader || shader->abi.target != MGC_TARGET_LEGACY ||
+          shader->abi_version != MGC_HOST_FEATURES_ABI_VERSION ||
+          shader->abi.host_features_version != MGC_HOST_FEATURES_VERSION ||
+          shader->abi.host_instancing_version || !shader->program_format ||
+          strcmp(shader->program_format, "legacy-mgcsim-v1"))
+         return mgc_executor_error(ctx, "native ABI4 requires matching opt-in shader stages");
+   }
+   struct mgc_executor_target color_target = {0}, depth_target = {0};
+   struct pipe_resource *color_resource = ctx->framebuffer.cbufs[0].texture;
+   struct pipe_resource *depth_resource = ctx->framebuffer.zsbuf.texture;
+   char state[MGC_HOST_FEATURES_STATE_BYTES];
+   size_t state_size = 0;
+   simple_mtx_lock(&ctx->screen->lock);
+   bool valid = mgc_features_capture_state_locked(ctx, state, sizeof(state), &state_size, 0);
+   if (valid) {
+      const char key[] = "\"render_state\":";
+      const char *captured = memmem(json, json_size, key, sizeof(key) - 1);
+      valid = captured && (size_t)(json + json_size - captured) >= sizeof(key) - 1 + state_size &&
+         !memcmp(captured + sizeof(key) - 1, state, state_size);
+   }
+   if (valid) {
+      mgc_executor_reserve_target(&color_target, color_resource);
+      if (depth_resource)
+         mgc_executor_reserve_target(&depth_target, depth_resource);
+   }
+   simple_mtx_unlock(&ctx->screen->lock);
+   if (!valid)
+      return mgc_executor_error(ctx, "invalid ABI4 pipeline state or mapped/aliased native attachment");
+   const char *name;
+   unsigned color_bytes = 0, depth_bytes = 0;
+   unsigned color_format = mgc_features_color_format(color_resource->format, &name, &color_bytes);
+   unsigned depth_format = depth_resource ? mgc_features_depth_format(depth_resource->format, &name, &depth_bytes) : 0;
+   size_t row_bytes = color_target.width * color_bytes;
+   size_t depth_row_bytes = color_target.width * depth_bytes;
+   size_t image_size = row_bytes * color_target.height;
+   size_t depth_size = depth_row_bytes * color_target.height;
+   uint8_t *images = malloc((image_size + depth_size) * 2);
+   if (!images) {
+      mgc_executor_release_targets(&color_target, &depth_target);
+      return mgc_executor_error(ctx, "ABI4 native staging allocation failed");
+   }
+   uint8_t *initial = images;
+   uint8_t *initial_depth = initial + image_size;
+   uint8_t *image = initial_depth + depth_size;
+   uint8_t *depth_image = image + image_size;
+   simple_mtx_lock(&ctx->screen->lock);
+   valid = mgc_features_targets_valid(ctx, color_resource, depth_resource, 1) &&
+      mgc_executor_target_unchanged(&color_target) && mgc_executor_target_unchanged(&depth_target);
+   for (unsigned row = 0; valid && row < color_target.height; row++) {
+      memcpy(initial + row * row_bytes, (const uint8_t *)color_target.data + color_target.level.offset +
+             (size_t)(color_target.height - 1 - row) * color_target.level.stride, row_bytes);
+      if (depth_resource)
+         memcpy(initial_depth + row * depth_row_bytes, (const uint8_t *)depth_target.data + depth_target.level.offset +
+                (size_t)(depth_target.height - 1 - row) * depth_target.level.stride, depth_row_bytes);
+   }
+   simple_mtx_unlock(&ctx->screen->lock);
+   bool success = valid && mgc_executor_exchange(ctx, sequence, json, json_size,
+      color_target.width, color_target.height, 0, initial, image,
+      initial_depth, depth_image, depth_size, color_format, depth_format, image_size);
+   if (success) {
+      char current_state[MGC_HOST_FEATURES_STATE_BYTES];
+      size_t current_size = 0;
+      simple_mtx_lock(&ctx->screen->lock);
+      success = mgc_features_capture_state_locked(ctx, current_state, sizeof(current_state), &current_size, 1) &&
+         current_size == state_size && !memcmp(current_state, state, state_size) &&
+         sequence == ctx->status.sequence &&
+         mgc_features_targets_valid(ctx, color_resource, depth_resource, 1) &&
+         mgc_executor_target_unchanged(&color_target) && mgc_executor_target_unchanged(&depth_target);
+      for (unsigned row = 0; success && row < color_target.height; row++) {
+         success = !memcmp(initial + row * row_bytes, (const uint8_t *)color_target.data + color_target.level.offset +
+            (size_t)(color_target.height - 1 - row) * color_target.level.stride, row_bytes) &&
+            (!depth_resource || !memcmp(initial_depth + row * depth_row_bytes,
+               (const uint8_t *)depth_target.data + depth_target.level.offset +
+               (size_t)(depth_target.height - 1 - row) * depth_target.level.stride, depth_row_bytes));
+      }
+      for (unsigned row = 0; success && row < color_target.height; row++) {
+         memcpy((uint8_t *)color_target.data + color_target.level.offset +
+                (size_t)(color_target.height - 1 - row) * color_target.level.stride, image + row * row_bytes, row_bytes);
+         if (depth_resource)
+            memcpy((uint8_t *)depth_target.data + depth_target.level.offset +
+                   (size_t)(depth_target.height - 1 - row) * depth_target.level.stride,
+                   depth_image + row * depth_row_bytes, depth_row_bytes);
+      }
+      simple_mtx_unlock(&ctx->screen->lock);
+   }
+   free(images);
+   mgc_executor_release_targets(&color_target, &depth_target);
+   if (!success)
+      return mgc_executor_error(ctx, "ABI4 native peer, response, timeout or transactional revalidation failed");
+   fprintf(stderr, "MGC_HOST_EXECUTOR_COMMIT sequence=%" PRIu64 " width=%u height=%u\n",
+           sequence, color_target.width, color_target.height);
+   return true;
+}
+
+bool
+mgc_host_executor_execute(struct mgc_context *ctx, uint64_t sequence,
+                           const char *json, size_t json_size)
+{
+   unsigned blend_mode;
+   bool depth_test;
+   if (!ctx->host_executor_enabled || !ctx->host_executor_valid || !json ||
+       !sequence || sequence != ctx->status.sequence || !json_size ||
+       json_size > MGC_HOST_CAPTURE_MAX_FILE_BYTES)
+      return mgc_executor_error(ctx, "invalid host executor configuration, sequence or bounded JSON");
+   if (ctx->host_features_version) {
+      if (ctx->host_features_version != MGC_HOST_FEATURES_VERSION)
+         return mgc_executor_error(ctx, "invalid HOST FEATURES native version");
+      return mgc_features_execute(ctx, sequence, json, json_size);
+   }
+   const char *state_error = NULL;
+   if (!mgc_executor_draw_state(ctx, &blend_mode, &depth_test, &state_error))
+      return mgc_executor_error(ctx, state_error);
+   if (ctx->host_instancing_version && ctx->host_instancing_version != MGC_HOST_INSTANCING_VERSION)
+      return mgc_executor_error(ctx, "unsupported host executor instancing version");
+   unsigned shader_abi = ctx->host_instancing_version ? MGC_HOST_INSTANCING_ABI_VERSION : MGC_ABI_VERSION;
+   for (unsigned stage = 0; stage < MGC_RUNTIME_STAGES; stage++) {
+      const struct mgc_shader *shader = ctx->shaders[stage] ? ctx->shaders[stage]->shader : NULL;
+      if (!shader || shader->abi.target != MGC_TARGET_LEGACY || shader->abi_version != shader_abi ||
+          shader->abi.host_instancing_version != ctx->host_instancing_version ||
+          !shader->program_format || strcmp(shader->program_format, "legacy-mgcsim-v1"))
+         return mgc_executor_error(ctx, "host executor requires matching opt-in legacy shader ABIs");
+   }
+   struct mgc_executor_target color_target = {0};
+   struct mgc_executor_target depth_target = {0};
+   struct pipe_resource *color_resource = ctx->framebuffer.cbufs[0].texture;
+   struct pipe_resource *depth_resource = depth_test ? ctx->framebuffer.zsbuf.texture : NULL;
+   simple_mtx_lock(&ctx->screen->lock);
+   bool valid = (!depth_test || depth_resource) &&
+      mgc_executor_targets_valid(ctx, color_resource, depth_resource, 0);
+   if (valid) {
+      mgc_executor_reserve_target(&color_target, color_resource);
+      if (depth_resource)
+         mgc_executor_reserve_target(&depth_target, depth_resource);
+   }
+   simple_mtx_unlock(&ctx->screen->lock);
+   if (!valid)
+      return mgc_executor_error(ctx, "unsupported, mapped or reserved host executor color/depth render target");
+   size_t row_bytes = color_target.width * 4;
+   size_t image_size = row_bytes * color_target.height;
+   size_t depth_row_bytes = depth_resource ? color_target.width * 2 : 0;
+   size_t depth_size = depth_row_bytes * color_target.height;
+   uint8_t *images = malloc((image_size + depth_size) * 2);
+   if (!images) {
+      mgc_executor_release_targets(&color_target, &depth_target);
+      return mgc_executor_error(ctx, "host executor framebuffer staging allocation failed");
+   }
+   uint8_t *initial = images;
+   uint8_t *initial_depth = images + image_size;
+   uint8_t *image = initial_depth + depth_size;
+   uint8_t *depth_image = image + image_size;
+   simple_mtx_lock(&ctx->screen->lock);
+   valid = mgc_executor_targets_valid(ctx, color_resource, depth_resource, 1) &&
+      mgc_executor_target_unchanged(&color_target) && mgc_executor_target_unchanged(&depth_target);
+   if (valid) {
+      for (unsigned row = 0; row < color_target.height; row++) {
+         memcpy(initial + row * row_bytes, (const uint8_t *)color_target.data + color_target.level.offset +
+                (size_t)(color_target.height - 1 - row) * color_target.level.stride, row_bytes);
+         if (depth_resource) {
+            const uint8_t *source = (const uint8_t *)depth_target.data + depth_target.level.offset +
+               (size_t)(depth_target.height - 1 - row) * depth_target.level.stride;
+            for (unsigned column = 0; column < depth_target.width; column++) {
+               uint16_t value;
+               memcpy(&value, source + column * 2, sizeof(value));
+               mgc_executor_put16(initial_depth + row * depth_row_bytes + column * 2, value);
+            }
+         }
+      }
+   }
+   simple_mtx_unlock(&ctx->screen->lock);
+   bool success = valid && mgc_executor_exchange(ctx, sequence, json, json_size,
+      color_target.width, color_target.height, blend_mode, initial, image,
+      initial_depth, depth_image, depth_size, 1, depth_resource ? 1 : 0, image_size);
+   if (success) {
+      unsigned current_blend;
+      bool current_depth;
+      simple_mtx_lock(&ctx->screen->lock);
+      success = mgc_executor_draw_state(ctx, &current_blend, &current_depth, NULL) &&
+         current_blend == blend_mode && current_depth == depth_test &&
+         sequence == ctx->status.sequence &&
+         mgc_executor_targets_valid(ctx, color_resource, depth_resource, 1) &&
+         mgc_executor_target_unchanged(&color_target) && mgc_executor_target_unchanged(&depth_target);
+      for (unsigned row = 0; success && row < color_target.height; row++) {
+         success = !memcmp(initial + row * row_bytes, (const uint8_t *)color_target.data +
+            color_target.level.offset + (size_t)(color_target.height - 1 - row) * color_target.level.stride,
+            row_bytes);
+         if (depth_resource) {
+            const uint8_t *source = (const uint8_t *)depth_target.data + depth_target.level.offset +
+               (size_t)(depth_target.height - 1 - row) * depth_target.level.stride;
+            for (unsigned column = 0; success && column < depth_target.width; column++) {
+               uint16_t value;
+               memcpy(&value, source + column * 2, sizeof(value));
+               success = value == mgc_executor_get16(initial_depth + row * depth_row_bytes + column * 2);
+            }
+         }
+      }
+      if (success) {
+         for (unsigned row = 0; row < color_target.height; row++) {
+            memcpy((uint8_t *)color_target.data + color_target.level.offset +
+               (size_t)(color_target.height - 1 - row) * color_target.level.stride,
+               image + row * row_bytes, row_bytes);
+            if (depth_resource) {
+               uint8_t *destination = (uint8_t *)depth_target.data + depth_target.level.offset +
+                  (size_t)(depth_target.height - 1 - row) * depth_target.level.stride;
+               for (unsigned column = 0; column < depth_target.width; column++) {
+                  uint16_t value = mgc_executor_get16(depth_image + row * depth_row_bytes + column * 2);
+                  memcpy(destination + column * 2, &value, sizeof(value));
+               }
+            }
+         }
+      }
+      simple_mtx_unlock(&ctx->screen->lock);
+   }
+   free(images);
+   mgc_executor_release_targets(&color_target, &depth_target);
+   if (!success)
+      return mgc_executor_error(ctx, "host executor peer, response, timeout or target revalidation failed");
+   fprintf(stderr, "MGC_HOST_EXECUTOR_COMMIT sequence=%" PRIu64 " width=%u height=%u\n",
+           sequence, color_target.width, color_target.height);
+   return success;
+}
+
+bool
+mgc_host_executor_clear(struct mgc_context *ctx, unsigned buffers,
+                         const struct pipe_scissor_state *scissor,
+                         const union pipe_color_union *color, double depth)
+{
+   if (!ctx->host_executor_enabled || !ctx->host_executor_valid ||
+       !buffers || (buffers & ~(PIPE_CLEAR_COLOR0 | PIPE_CLEAR_DEPTH)) || scissor ||
+       ((buffers & PIPE_CLEAR_COLOR0) && !color) ||
+       ((buffers & PIPE_CLEAR_DEPTH) && (!isfinite(depth) || depth < 0 || depth > 1)))
+      return false;
+   uint8_t rgba[4];
+   for (unsigned component = 0; (buffers & PIPE_CLEAR_COLOR0) && component < 4; component++) {
+      double value = color->f[component];
+      if (!isfinite(value))
+         return false;
+      value = fmin(1, fmax(0, value)) * 255;
+      unsigned quantized = floor(value);
+      double fraction = value - quantized;
+      if (fraction > 0.5 || (fraction == 0.5 && (quantized & 1)))
+         quantized++;
+      rgba[component] = quantized;
+   }
+   uint16_t depth_value = 0;
+   if (buffers & PIPE_CLEAR_DEPTH) {
+      double value = depth * 65535;
+      unsigned quantized = floor(value);
+      double fraction = value - quantized;
+      if (fraction > 0.5 || (fraction == 0.5 && (quantized & 1)))
+         quantized++;
+      depth_value = quantized;
+   }
+   struct pipe_resource *color_resource = ctx->framebuffer.cbufs[0].texture;
+   struct pipe_resource *depth_resource = ctx->framebuffer.zsbuf.texture;
+   simple_mtx_lock(&ctx->screen->lock);
+   bool success = (!(buffers & PIPE_CLEAR_DEPTH) || depth_resource) &&
+      mgc_executor_targets_valid(ctx, color_resource, depth_resource, 0);
+   if (success && (buffers & PIPE_CLEAR_COLOR0)) {
+      struct mgc_resource *storage = mgc_resource(color_resource);
+      const struct mgc_resource_level *level = &storage->levels[0];
+      for (unsigned row = 0; row < color_resource->height0; row++) {
+         uint8_t *destination = (uint8_t *)storage->data + level->offset + (size_t)row * level->stride;
+         for (unsigned column = 0; column < color_resource->width0; column++)
+            memcpy(destination + column * 4, rgba, sizeof(rgba));
+      }
+   }
+   if (success && (buffers & PIPE_CLEAR_DEPTH)) {
+      struct mgc_resource *storage = mgc_resource(depth_resource);
+      const struct mgc_resource_level *level = &storage->levels[0];
+      for (unsigned row = 0; row < depth_resource->height0; row++) {
+         uint8_t *destination = (uint8_t *)storage->data + level->offset + (size_t)row * level->stride;
+         for (unsigned column = 0; column < depth_resource->width0; column++)
+            memcpy(destination + column * 2, &depth_value, sizeof(depth_value));
+      }
+   }
+   simple_mtx_unlock(&ctx->screen->lock);
+   return success;
+}
+
+static unsigned
+mgc_features_quantize(double value, unsigned maximum)
+{
+   value = fmin(1, fmax(0, value)) * maximum;
+   unsigned quantized = floor(value);
+   double fraction = value - quantized;
+   return quantized + (fraction > 0.5 || (fraction == 0.5 && (quantized & 1)));
+}
+
+bool
+mgc_host_features_clear(struct mgc_context *ctx, unsigned buffers,
+                         const struct pipe_scissor_state *scissor,
+                         const union pipe_color_union *color, double depth, unsigned stencil)
+{
+   const uint32_t endian_probe = 1;
+   if (!ctx || *(const uint8_t *)&endian_probe != 1 ||
+       ctx->host_features_version != MGC_HOST_FEATURES_VERSION ||
+       !ctx->host_executor_enabled || !ctx->host_executor_valid || scissor || !buffers ||
+       (buffers & ~(PIPE_CLEAR_COLOR0 | PIPE_CLEAR_DEPTH | PIPE_CLEAR_STENCIL)) ||
+       ((buffers & PIPE_CLEAR_COLOR0) && !color) ||
+       ((buffers & PIPE_CLEAR_DEPTH) && (!isfinite(depth) || depth < 0 || depth > 1)))
+      return false;
+   if (buffers & PIPE_CLEAR_COLOR0) {
+      for (unsigned component = 0; component < 4; component++) {
+         if (!isfinite(color->f[component]))
+            return false;
+      }
+   }
+   struct pipe_resource *color_resource = ctx->framebuffer.cbufs[0].texture;
+   struct pipe_resource *depth_resource = ctx->framebuffer.zsbuf.texture;
+   simple_mtx_lock(&ctx->screen->lock);
+   bool success = mgc_features_targets_valid(ctx, color_resource, depth_resource, 0) &&
+      (!(buffers & PIPE_CLEAR_DEPTH) || depth_resource) &&
+      (!(buffers & PIPE_CLEAR_STENCIL) || (depth_resource && depth_resource->format == PIPE_FORMAT_Z24_UNORM_S8_UINT));
+   if (success && (buffers & PIPE_CLEAR_COLOR0)) {
+      const char *name;
+      unsigned blocksize = 0;
+      unsigned format = mgc_features_color_format(color_resource->format, &name, &blocksize);
+      uint8_t pixel[4];
+      if (format == 3) {
+         uint16_t packed = (mgc_features_quantize(color->f[0], 31) << 11) |
+            (mgc_features_quantize(color->f[1], 63) << 5) | mgc_features_quantize(color->f[2], 31);
+         mgc_executor_put16(pixel, packed);
+      } else {
+         for (unsigned component = 0; component < blocksize; component++) {
+            unsigned source = format == 2 && component < 3 ? 2 - component : component;
+            pixel[component] = mgc_features_quantize(color->f[source], 255);
+         }
+      }
+      struct mgc_resource *storage = mgc_resource(color_resource);
+      const struct mgc_resource_level *level = &storage->levels[0];
+      for (unsigned row = 0; row < color_resource->height0; row++) {
+         uint8_t *destination = (uint8_t *)storage->data + level->offset + (size_t)row * level->stride;
+         for (unsigned column = 0; column < color_resource->width0; column++)
+            memcpy(destination + column * blocksize, pixel, blocksize);
+      }
+   }
+   if (success && (buffers & (PIPE_CLEAR_DEPTH | PIPE_CLEAR_STENCIL))) {
+      struct mgc_resource *storage = mgc_resource(depth_resource);
+      const struct mgc_resource_level *level = &storage->levels[0];
+      bool packed = depth_resource->format == PIPE_FORMAT_Z24_UNORM_S8_UINT;
+      unsigned depth_value = buffers & PIPE_CLEAR_DEPTH ?
+         mgc_features_quantize(depth, packed ? 16777215 : 65535) : 0;
+      unsigned blocksize = packed ? 4 : 2;
+      for (unsigned row = 0; row < depth_resource->height0; row++) {
+         uint8_t *destination = (uint8_t *)storage->data + level->offset + (size_t)row * level->stride;
+         for (unsigned column = 0; column < depth_resource->width0; column++) {
+            if (packed) {
+               uint32_t value = mgc_executor_get32(destination + column * blocksize);
+               if (buffers & PIPE_CLEAR_DEPTH)
+                  value = (value & 0xff000000u) | depth_value;
+               if (buffers & PIPE_CLEAR_STENCIL)
+                  value = (value & 0x00ffffffu) | ((stencil & 255u) << 24);
+               mgc_executor_put32(destination + column * blocksize, value);
+            } else {
+               mgc_executor_put16(destination + column * blocksize, depth_value);
+            }
+         }
+      }
+   }
+   simple_mtx_unlock(&ctx->screen->lock);
+   return success;
+}
diff --git a/src/gallium/drivers/mgc/mgc_host_executor.h b/src/gallium/drivers/mgc/mgc_host_executor.h
