+static char *
+mgc_reflect_layout(struct mgc_shader *shader, nir_shader *nir,
+                   const struct mgc_layout_hints *hints, bool compiled)
+{
+   if (nir->info.stage != MESA_SHADER_VERTEX && nir->info.stage != MESA_SHADER_FRAGMENT)
+      return NULL;
+   void *temporary = ralloc_context(NULL);
+   if (!temporary)
+      return NULL;
+   struct mgc_layout layout = {.mem_ctx = temporary, .json = ralloc_strdup(temporary, "")};
+   if (!layout.json) {
+      ralloc_free(temporary);
+      return NULL;
+   }
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   bool ready = mgc_layout_gather_types(&layout, impl);
+   for (unsigned domain = 0; domain < 2; domain++) {
+      for (unsigned component = 0; component < MGC_LAYOUT_SEMANTIC_COMPONENTS; component++)
+         layout.semantic_offsets[domain][component] = -1;
+   }
+   for (unsigned domain = 0; domain < 3; domain++) {
+      layout.entries[domain] = rzalloc_array(temporary, struct mgc_layout_entry, MGC_ABI_REGION_WORDS);
+      ready &= layout.entries[domain] != NULL;
+   }
+   if (!ready)
+      layout.errors |= MGC_LAYOUT_LIMIT;
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type == nir_instr_type_intrinsic) {
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic == nir_intrinsic_demote || intr->intrinsic == nir_intrinsic_demote_if ||
+                intr->intrinsic == nir_intrinsic_terminate || intr->intrinsic == nir_intrinsic_terminate_if ||
+                intr->intrinsic == nir_intrinsic_demote_samples)
+               layout.uses_discard = true;
+            bool texture_storage =
+               (intr->intrinsic == nir_intrinsic_load_ubo ||
+                intr->intrinsic == nir_intrinsic_load_ubo_vec4) &&
+               nir_src_is_const(intr->src[0]) &&
+               ((shader->uses_host_texture && nir_src_as_uint(intr->src[0]) == MGC_HOST_TEXTURE_BLOCK) ||
+                (shader->abi.host_features_version &&
+                 nir_src_as_uint(intr->src[0]) >= MGC_HOST_INTERNAL_TEXTURE_BLOCK));
+            bool instance_id = shader->abi.host_instancing_version == MGC_HOST_INSTANCING_VERSION &&
+               nir->info.stage == MESA_SHADER_VERTEX && intr->intrinsic == nir_intrinsic_load_instance_id;
+            bool host_builtin = shader->abi.host_features_version &&
+               (intr->intrinsic == nir_intrinsic_load_instance_id ||
