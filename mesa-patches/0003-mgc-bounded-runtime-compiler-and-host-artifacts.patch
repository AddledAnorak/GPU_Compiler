+static bool
+mgc_lower_small_power(nir_builder *builder, nir_instr *instr, void *data)
+{
+   if (instr->type != nir_instr_type_alu)
+      return false;
+   nir_alu_instr *alu = nir_instr_as_alu(instr);
+   if (alu->def.num_components != 1)
+      return false;
+   nir_def *base = NULL, *exponent_def = NULL;
+   if (alu->op == nir_op_fpow) {
+      base = alu->src[0].src.ssa;
+      exponent_def = alu->src[1].src.ssa;
+   } else if (alu->op == nir_op_fexp2 &&
+              alu->src[0].src.ssa->parent_instr->type == nir_instr_type_alu) {
+      nir_alu_instr *multiply = nir_instr_as_alu(alu->src[0].src.ssa->parent_instr);
+      if (multiply->op != nir_op_fmul && multiply->op != nir_op_fmulz)
+         return false;
+      for (unsigned source = 0; source < 2; source++) {
+         nir_def *candidate = multiply->src[source].src.ssa;
+         if (candidate->parent_instr->type != nir_instr_type_alu)
+            continue;
+         nir_alu_instr *logarithm = nir_instr_as_alu(candidate->parent_instr);
+         if (logarithm->op == nir_op_flog2) {
+            base = logarithm->src[0].src.ssa;
+            exponent_def = multiply->src[1 - source].src.ssa;
+         }
+      }
+   }
+   if (!base || !exponent_def ||
+       exponent_def->parent_instr->type != nir_instr_type_load_const)
+      return false;
+   nir_load_const_instr *constant = nir_instr_as_load_const(exponent_def->parent_instr);
+   float exponent = nir_const_value_as_float(constant->value[0], exponent_def->bit_size);
+   if (!isfinite(exponent) || exponent < 0 || exponent > 64 || floorf(exponent) != exponent)
+      return false;
+   builder->cursor = nir_before_instr(instr);
+   nir_def *result = nir_imm_floatN_t(builder, 1.0, alu->def.bit_size);
+   unsigned remaining = exponent;
+   while (remaining) {
+      if (remaining & 1)
+         result = nir_fmul(builder, result, base);
+      remaining >>= 1;
+      if (remaining)
+         base = nir_fmul(builder, base, base);
+   }
+   nir_def_replace(&alu->def, result);
+   return true;
+}
