+   unsigned strides[MGC_RUNTIME_VERTEX_BUFFERS] = {0};
+   bool used[MGC_RUNTIME_VERTEX_BUFFERS] = {false};
+   for (unsigned index = 0; index < artifact->num_vertex_elements; index++) {
+      const struct pipe_vertex_element *element = &artifact->vertex_elements[index];
+      unsigned slot = element->vertex_buffer_index;
+      if (slot >= artifact->num_vertex_buffers || !mgc_capture_format(element->src_format) ||
+          element->dual_slot ||
+          ((ctx->host_instancing_version || features) ?
+             element->instance_divisor > MGC_HOST_INSTANCING_MAX_INDEX :
+             element->instance_divisor != 0) ||
+          (used[slot] && strides[slot] != element->src_stride))
+         return false;
