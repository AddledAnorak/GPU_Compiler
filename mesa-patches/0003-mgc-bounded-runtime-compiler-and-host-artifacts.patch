+#ifndef MGC_HOST_EXECUTOR_H
+#define MGC_HOST_EXECUTOR_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define MGC_HOST_EXECUTOR_MAX_SIZE 128u
+#define MGC_HOST_EXECUTOR_SOCKET_BYTES 108u
+#define MGC_HOST_EXECUTOR_TIMEOUT_MS 5000
+#define MGC_HOST_FEATURES_STATE_BYTES 4096u
+
+enum mgc_host_blend_mode {
+   MGC_HOST_BLEND_DISABLED = 0,
+   MGC_HOST_BLEND_SOURCE_OVER = 1,
+   MGC_HOST_BLEND_ADDITIVE = 2,
+   MGC_HOST_BLEND_SUBTRACT = 3,
+   MGC_HOST_BLEND_REVERSE_SUBTRACT = 4,
+   MGC_HOST_BLEND_MINIMUM = 5,
+   MGC_HOST_BLEND_MAXIMUM = 6,
+};
+
+struct mgc_context;
+struct pipe_scissor_state;
+union pipe_color_union;
+
+void mgc_host_executor_init(struct mgc_context *ctx);
+bool mgc_host_executor_execute(struct mgc_context *ctx, uint64_t sequence,
+                               const char *json, size_t json_size);
+bool mgc_host_executor_clear(struct mgc_context *ctx, unsigned buffers,
+                             const struct pipe_scissor_state *scissor,
+                             const union pipe_color_union *color, double depth);
+bool mgc_host_features_capture_state(struct mgc_context *ctx, char *output,
+                                      size_t capacity, size_t *size);
+bool mgc_host_features_clear(struct mgc_context *ctx, unsigned buffers,
+                              const struct pipe_scissor_state *scissor,
+                              const union pipe_color_union *color, double depth,
+                              unsigned stencil);
+
+#endif
diff --git a/src/gallium/drivers/mgc/mgc_test_backend.c b/src/gallium/drivers/mgc/mgc_test_backend.c
new file mode 100644
index 0000000000000000000000000000000000000000..f63173ebefa58e28df4d6391bfb4e1ef14407619
--- /dev/null
+++ b/src/gallium/drivers/mgc/mgc_test_backend.c
@@ -0,0 +1,911 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+#include "compiler/nir/nir_builtin_builder.h"
+#include "mgc_compiler.h"
+
+static bool
+texture_wrap_option(const char *variable, enum mgc_host_texture_wrap *wrap)
+{
+   const char *value = getenv(variable);
+   if (!value)
+      return true;
+   for (unsigned candidate = MGC_HOST_WRAP_CLAMP_TO_EDGE;
+        candidate <= MGC_HOST_WRAP_MIRRORED_REPEAT; candidate++) {
+      if (!strcmp(value, mgc_host_texture_wrap_name(candidate))) {
+         *wrap = candidate;
+         return true;
+      }
+   }
+   fprintf(stderr, "%s must be clamp-to-edge, repeat, or mirrored-repeat\n", variable);
+   return false;
+}
+
+static bool
+texture_source_lod(unsigned count, float *lod)
+{
+   const char *value = getenv("MGC_TEST_SOURCE_LOD");
+   *lod = count;
+   if (!value)
+      return true;
+   char *end;
+   *lod = strtof(value, &end);
+   if (end != value && !*end)
+      return true;
+   fprintf(stderr, "MGC_TEST_SOURCE_LOD must be a floating-point source literal\n");
+   return false;
+}
+
+static int
+check_texture_helpers(void)
+{
+   struct mgc_compile_options test_options = mgc_default_compile_options();
+   struct mgc_compile_options hardware = mgc_default_hardware_compile_options();
+   if (test_options.host_texture_wrap_s || test_options.host_texture_wrap_t ||
+       hardware.host_texture_wrap_s || hardware.host_texture_wrap_t)
+      return 1;
+   test_options.host_texture_wrap_s = MGC_HOST_WRAP_REPEAT;
+   test_options.host_texture_wrap_t = MGC_HOST_WRAP_MIRRORED_REPEAT;
+   for (unsigned version = 0; version <= MGC_HOST_TEXTURE_ANISOTROPIC_VERSION; version++) {
+      test_options.host_texture_version = version;
+      bool linear = version == 2 || version == 4 || version == 6 || version == 8 || version == 10 || version >= 12;
+      if (mgc_host_texture_is_linear(version) != linear)
+         return 1;
+      for (unsigned axis = 0; axis < 2; axis++) {
+         enum mgc_host_texture_wrap expected = version < 3 ? MGC_HOST_WRAP_CLAMP_TO_EDGE :
+            version < 5 ? MGC_HOST_WRAP_REPEAT : version < 7 ? MGC_HOST_WRAP_MIRRORED_REPEAT :
+            axis ? MGC_HOST_WRAP_MIRRORED_REPEAT : MGC_HOST_WRAP_REPEAT;
+         if (mgc_host_texture_wrap_for_axis(&test_options, axis) != expected)
+            return 1;
+      }
+   }
+   test_options.host_texture_version = MGC_HOST_TEXTURE_ANISOTROPIC_VERSION + 1;
+   if (mgc_host_texture_is_linear(test_options.host_texture_version) ||
+       mgc_host_texture_is_linear(~0u) ||
+       mgc_host_texture_wrap_name(mgc_host_texture_wrap_for_axis(&test_options, 0)) ||
+       mgc_host_texture_wrap_name(mgc_host_texture_wrap_for_axis(&test_options, 2)) ||
+       mgc_host_texture_wrap_name(mgc_host_texture_wrap_for_axis(NULL, 0)) ||
+       mgc_host_texture_wrap_name((enum mgc_host_texture_wrap)-1) ||
+       mgc_host_texture_wrap_name((enum mgc_host_texture_wrap)3) ||
+       strcmp(mgc_host_texture_wrap_name(MGC_HOST_WRAP_CLAMP_TO_EDGE), "clamp-to-edge") ||
+       strcmp(mgc_host_texture_wrap_name(MGC_HOST_WRAP_REPEAT), "repeat") ||
+       strcmp(mgc_host_texture_wrap_name(MGC_HOST_WRAP_MIRRORED_REPEAT), "mirrored-repeat"))
+      return 1;
+   return 0;
+}
+
+static nir_def *
+input(nir_builder *builder, unsigned slot, unsigned component)
+{
+   return nir_load_input(builder, 1, 32, nir_imm_int(builder, 0),
+                         .base = slot, .component = component,
+                         .dest_type = nir_type_float32);
+}
+
+static void
+output(nir_builder *builder, nir_def *value, unsigned slot, unsigned component)
+{
+   nir_store_output(builder, value, nir_imm_int(builder, 0),
+                    .base = slot, .component = component, .write_mask = 1,
+                    .src_type = nir_type_float32);
+}
+
+static nir_def *
+vector_input(nir_builder *builder, unsigned slot)
+{
+   return nir_load_input(builder, 3, 32, nir_imm_int(builder, 0),
+                         .base = slot, .dest_type = nir_type_float32);
+}
+
+static nir_def *
+instance_input(nir_builder *builder, unsigned word)
+{
+   unsigned location = builder->shader->info.stage == MESA_SHADER_FRAGMENT ?
+      VARYING_SLOT_VAR0 : VERT_ATTRIB_GENERIC0;
+   return nir_load_input(builder, 1, 32, nir_imm_int(builder, 0),
+                         .base = word / 4, .component = word % 4, .dest_type = nir_type_float32,
+                         .io_semantics = { .location = location, .num_slots = 1 });
+}
+
+static void
+instance_output(nir_builder *builder, nir_def *value, unsigned component, bool integer)
+{
+   unsigned location = builder->shader->info.stage == MESA_SHADER_FRAGMENT ?
+      FRAG_RESULT_DATA0 : VARYING_SLOT_VAR0;
+   nir_store_output(builder, value, nir_imm_int(builder, 0),
+                    .component = component, .write_mask = 1,
+                    .src_type = integer ? nir_type_int32 : nir_type_float32,
+                    .io_semantics = { .location = location, .num_slots = 1 });
+}
+
+static bool
+instance_shader(nir_builder *builder, const char *mode, unsigned count)
+{
+   bool fragment = builder->shader->info.stage == MESA_SHADER_FRAGMENT;
+   bool ordinary = !strcmp(mode, "instance-no-id") || !strcmp(mode, "instance-fragment-no-id") ||
+      !strncmp(mode, "instance-input-", 15);
+   bool floating = ordinary || !strcmp(mode, "instance-unused") || !strcmp(mode, "instance-float");
+   nir_variable *result = nir_variable_create(builder->shader, nir_var_shader_out,
+      floating ? glsl_vec4_type() : glsl_ivec4_type(), "instance_result");
+   result->data.location = fragment ? FRAG_RESULT_DATA0 : VARYING_SLOT_VAR0;
+   result->data.interpolation = INTERP_MODE_FLAT;
+   nir_variable *attribute = nir_variable_create(builder->shader, nir_var_shader_in,
+                                                glsl_vec4_type(), "instance_attribute");
+   attribute->data.location = fragment ? VARYING_SLOT_VAR0 : VERT_ATTRIB_GENERIC0;
+   attribute->data.interpolation = INTERP_MODE_SMOOTH;
+   if (ordinary) {
+      if (!strcmp(mode, "instance-input-vector-alias")) {
+         nir_def *value = nir_load_input(builder, 4, 32, nir_imm_int(builder, 0),
+            .base = MGC_HOST_INSTANCE_ID_WORD / 4, .dest_type = nir_type_float32,
+            .io_semantics = { .location = attribute->data.location, .num_slots = 1 });
+         instance_output(builder, nir_channel(builder, value, 0), 0, false);
+      } else {
+         unsigned word = !strcmp(mode, "instance-input-edge") ? count :
+            (!strcmp(mode, "instance-input-alias") || !strcmp(mode, "instance-input-alias-unused")) ?
+            MGC_HOST_INSTANCE_ID_WORD : 0;
+         nir_def *value = instance_input(builder, word);
+         instance_output(builder, !strcmp(mode, "instance-input-alias-unused") ?
+                          nir_imm_float(builder, 1) : value, 0, false);
+      }
+      return true;
+   }
+   nir_def *instance = !strcmp(mode, "instance-base") ? nir_load_base_instance(builder) :
+      !strcmp(mode, "instance-vertex-id") ? nir_load_vertex_id(builder) :
+      !strcmp(mode, "instance-draw-id") ? nir_load_draw_id(builder) : nir_load_instance_id(builder);
+   if (!strcmp(mode, "instance-id16"))
+      instance->bit_size = 16;
+   if (!strcmp(mode, "instance-id64"))
+      instance->bit_size = 64;
+   if (!strcmp(mode, "instance-id-vector")) {
+      instance->num_components = 2;
+      nir_instr_as_intrinsic(instance->parent_instr)->num_components = 2;
+   }
+   if (!strcmp(mode, "instance-unused")) {
+      instance_output(builder, nir_imm_float(builder, 1), 0, false);
+   } else if (!strcmp(mode, "instance-float")) {
+      nir_def *value = nir_i2f32(builder, instance);
+      instance_output(builder, value, 0, false);
+      instance_output(builder, nir_fadd_imm(builder, value, 0.5), 1, false);
+      instance_output(builder, nir_b2f32(builder, nir_ige_imm(builder, instance, 8)), 2, false);
+      instance_output(builder, nir_imm_float(builder, 1), 3, false);
+   } else if (!strcmp(mode, "instance-select") || !strcmp(mode, "instance-select-constant")) {
+      nir_def *value = nir_bcsel(builder, nir_ilt_imm(builder, instance, 8),
+         !strcmp(mode, "instance-select") ? instance : nir_imm_int(builder, 3),
+         nir_imm_int(builder, !strcmp(mode, "instance-select") ? 15 : 11));
+      instance_output(builder, value, 0, true);
+   } else if (!strcmp(mode, "instance-branch")) {
+      nir_if *branch = nir_push_if(builder, nir_ilt_imm(builder, instance, 8));
+      instance_output(builder, instance, 0, true);
+      nir_push_else(builder, branch);
+      instance_output(builder, nir_iadd_imm(builder, instance, 16), 0, true);
+      nir_pop_if(builder, branch);
+   } else if (!strcmp(mode, "instance-loop") || !strcmp(mode, "instance-loop-phi")) {
+      nir_variable *index = nir_local_variable_create(builder->impl, glsl_int_type(), "instance_index");
+      nir_variable *sum = nir_local_variable_create(builder->impl, glsl_int_type(), "instance_sum");
+      nir_store_var(builder, index, nir_imm_int(builder, 0), 1);
+      if (!strcmp(mode, "instance-loop-phi")) {
+         nir_if *branch = nir_push_if(builder, nir_ilt_imm(builder, instance, 8));
+         nir_store_var(builder, sum, nir_imm_int(builder, 3), 1);
+         nir_push_else(builder, branch);
+         nir_store_var(builder, sum, nir_imm_int(builder, 11), 1);
+         nir_pop_if(builder, branch);
+      } else {
+         nir_store_var(builder, sum, nir_imm_int(builder, 0), 1);
+      }
+      nir_loop *loop = nir_push_loop(builder);
+      loop->control = nir_loop_control_dont_unroll;
+      nir_def *current = nir_load_var(builder, index);
+      nir_if *exit = nir_push_if(builder, nir_ige(builder, current, instance));
+      nir_jump(builder, nir_jump_break);
+      nir_pop_if(builder, exit);
+      nir_store_var(builder, sum, nir_iadd_imm(builder, nir_load_var(builder, sum), 1), 1);
+      nir_store_var(builder, index, nir_iadd_imm(builder, current, 1), 1);
+      nir_pop_loop(builder, loop);
+      instance_output(builder, nir_load_var(builder, sum), 0, true);
+      instance_output(builder, nir_load_var(builder, index), 1, true);
+      instance_output(builder, instance, 2, true);
+   } else if (!strcmp(mode, "instance-vector")) {
+      for (unsigned component = 0; component < 4; component++)
+         instance_output(builder, nir_iadd_imm(builder, instance, component), component, true);
+   } else if (!strcmp(mode, "instance-id") || !strcmp(mode, "instance-id16") ||
+              !strcmp(mode, "instance-id64") || !strcmp(mode, "instance-id-vector") ||
+              !strcmp(mode, "instance-fragment") || !strcmp(mode, "instance-compute") ||
+              !strcmp(mode, "instance-base") || !strcmp(mode, "instance-vertex-id") ||
+              !strcmp(mode, "instance-draw-id")) {
+      instance_output(builder, instance, 0, true);
+   } else {
+      return false;
+   }
+   return true;
+}
+
+static void
+loop_shader(nir_builder *builder, unsigned count, bool runtime, bool integer_bound)
+{
+   nir_def *step = input(builder, 0, 0);
+   nir_def *bound = integer_bound ? nir_load_ubo(builder, 1, 32,
+                                               nir_imm_int(builder, 0), nir_imm_int(builder, 0),
+                                               .align_mul = 4, .range = 4) :
+                                   runtime ? input(builder, 0, 1) : NULL;
+   nir_variable *index = nir_local_variable_create(builder->impl, glsl_int_type(), "index");
+   nir_variable *sum = nir_local_variable_create(builder->impl, glsl_float_type(), "sum");
+   nir_store_var(builder, index, nir_imm_int(builder, 0), 1);
+   nir_store_var(builder, sum, nir_imm_float(builder, 0), 1);
+   nir_loop *loop = nir_push_loop(builder);
+   nir_def *current = nir_load_var(builder, index);
+   nir_def *done = integer_bound ? nir_ige(builder, current, bound) :
+                  runtime ? nir_fge(builder, nir_i2f32(builder, current), bound) :
+                             nir_ige(builder, current, nir_imm_int(builder, count));
+   nir_if *exit_if = nir_push_if(builder, done);
+   nir_jump(builder, nir_jump_break);
+   nir_pop_if(builder, exit_if);
+   nir_store_var(builder, sum, nir_fadd(builder, nir_load_var(builder, sum), step), 1);
+   nir_store_var(builder, index, nir_iadd_imm(builder, current, 1), 1);
+   nir_pop_loop(builder, loop);
+   output(builder, nir_load_var(builder, sum), 0, 0);
+}
+
+static void
+phong_shader(nir_builder *builder)
+{
+   nir_def *normal = nir_normalize(builder, vector_input(builder, 0));
+   nir_def *light = nir_normalize(builder, vector_input(builder, 1));
+   nir_def *view = nir_normalize(builder, vector_input(builder, 2));
+   nir_def *dot = nir_fdot3(builder, normal, light);
+   nir_def *diffuse = nir_fmax(builder, dot, nir_imm_float(builder, 0));
+   nir_def *reflection = nir_fsub(builder,
+                                 nir_fmul(builder, nir_fmul_imm(builder, dot, 2), normal), light);
+   nir_def *specular = nir_fpow(builder,
+                               nir_fmax(builder, nir_fdot3(builder, view, reflection),
+                                         nir_imm_float(builder, 0)),
+                               nir_imm_float(builder, 32));
+   nir_def *color = nir_load_ubo_vec4(builder, 3, 32,
+                                    nir_imm_int(builder, 0), nir_imm_int(builder, 0));
+   nir_def *brightness = nir_fadd_imm(builder, diffuse, 0.1f);
+   for (unsigned component = 0; component < 3; component++) {
+      nir_def *value = nir_fadd(builder,
+                                nir_fmul(builder, brightness, nir_channel(builder, color, component)),
+                                nir_fmul_imm(builder, specular, 0.5f));
+      output(builder, value, 0, component);
+   }
+   output(builder, nir_imm_float(builder, 1), 0, 3);
+}
+
+static void
+swap_loop(nir_builder *builder)
+{
+   nir_def *bound = input(builder, 0, 2);
+   nir_variable *left = nir_local_variable_create(builder->impl, glsl_float_type(), "left");
+   nir_variable *right = nir_local_variable_create(builder->impl, glsl_float_type(), "right");
+   nir_variable *index = nir_local_variable_create(builder->impl, glsl_int_type(), "index");
+   nir_store_var(builder, left, input(builder, 0, 0), 1);
+   nir_store_var(builder, right, input(builder, 0, 1), 1);
+   nir_store_var(builder, index, nir_imm_int(builder, 0), 1);
+   nir_loop *loop = nir_push_loop(builder);
+   nir_def *current = nir_load_var(builder, index);
+   nir_if *exit_if = nir_push_if(builder, nir_fge(builder, nir_i2f32(builder, current), bound));
+   nir_jump(builder, nir_jump_break);
+   nir_pop_if(builder, exit_if);
+   nir_def *previous_left = nir_load_var(builder, left);
+   nir_def *previous_right = nir_load_var(builder, right);
+   nir_store_var(builder, left, previous_right, 1);
+   nir_store_var(builder, right, previous_left, 1);
+   nir_store_var(builder, index, nir_iadd_imm(builder, current, 1), 1);
+   nir_pop_loop(builder, loop);
+   output(builder, nir_load_var(builder, left), 0, 0);
+   output(builder, nir_load_var(builder, right), 0, 1);
+}
+
+static bool
+host_input_output_hints(nir_builder *builder)
+{
+   bool vertex = builder->shader->info.stage == MESA_SHADER_VERTEX;
+   for (unsigned slot = 0; slot < 32; slot++) {
+      nir_variable *variable = nir_variable_create(builder->shader, nir_var_shader_in, glsl_vec4_type(), "host_input");
+      variable->data.location = (vertex ? VERT_ATTRIB_GENERIC0 : VARYING_SLOT_VAR0) + slot;
+      variable->data.interpolation = INTERP_MODE_SMOOTH;
+   }
+   nir_variable *variable = nir_variable_create(builder->shader, nir_var_shader_out,
+                                                vertex ? glsl_ivec4_type() : glsl_vec4_type(), "host_output");
+   variable->data.location = vertex ? VARYING_SLOT_VAR0 : FRAG_RESULT_DATA0;
+   variable->data.interpolation = INTERP_MODE_SMOOTH;
+   return true;
+}
+
+static nir_def *
+host_input(nir_builder *builder, unsigned slot, unsigned component)
+{
+   unsigned location = builder->shader->info.stage == MESA_SHADER_VERTEX ? VERT_ATTRIB_GENERIC0 : VARYING_SLOT_VAR0;
+   return nir_load_input(builder, 1, 32, nir_imm_int(builder, 0), .base = slot, .component = component,
+      .dest_type = nir_type_float32, .io_semantics = {.location = location + MIN2(slot, 31), .num_slots = 1});
+}
+
+static bool
+host_features_shader(nir_builder *builder, const char *mode, unsigned count)
+{
+   host_input_output_hints(builder);
+   if (!strcmp(mode, "host-vertex")) {
+      nir_def *channels[] = {nir_load_instance_id(builder), nir_load_vertex_id(builder),
+                            nir_load_base_instance(builder), nir_load_draw_id(builder)};
+      nir_store_output(builder, nir_vec(builder, channels, 4), nir_imm_int(builder, 0),
+         .src_type = nir_type_int32, .write_mask = 15,
+         .io_semantics = {.location = VARYING_SLOT_VAR0, .num_slots = 1});
+   } else if (!strcmp(mode, "host-fragment") || !strcmp(mode, "host-fragcoord-subset")) {
+      nir_def *coordinate = nir_load_frag_coord(builder);
+      nir_def *value = !strcmp(mode, "host-fragcoord-subset") ? nir_channel(builder, coordinate, count % 4) :
+         nir_fmul(builder, coordinate, nir_bcsel(builder, nir_load_front_face(builder, 1),
+                                                nir_imm_float(builder, 1), nir_imm_float(builder, -1)));
+      nir_store_output(builder, value, nir_imm_int(builder, 0), .src_type = nir_type_float32,
+         .write_mask = value->num_components == 4 ? 15 : 1,
+         .io_semantics = {.location = FRAG_RESULT_DATA0, .num_slots = 1});
+   } else if (!strncmp(mode, "host-derivative", 15)) {
+      nir_def *source = host_input(builder, 0, 0);
+      nir_def *squared = nir_fmul(builder, source, source);
+      if (!strcmp(mode, "host-derivative-kill"))
+         nir_demote_if(builder, nir_flt(builder, source, nir_imm_float(builder, 0)));
+      bool divergent = !strcmp(mode, "host-derivative-divergent");
+      if (divergent)
+         nir_push_if(builder, nir_flt(builder, source, nir_imm_float(builder, 0)));
+      nir_def *dx = nir_ddx_fine(builder, squared);
+      nir_def *dy = nir_ddy_fine(builder, squared);
+      nir_def *channels[] = {squared, dx, dy, nir_fadd(builder, nir_fabs(builder, dx), nir_fabs(builder, dy))};
+      nir_store_output(builder, nir_vec(builder, channels, 4), nir_imm_int(builder, 0),
+         .src_type = nir_type_float32, .write_mask = 15,
+         .io_semantics = {.location = FRAG_RESULT_DATA0, .num_slots = 1});
+      if (divergent)
+         nir_pop_if(builder, NULL);
+   } else if (!strcmp(mode, "host-input-alias")) {
+      output(builder, host_input(builder, count / 4, count % 4), 0, 0);
+   } else if (!strcmp(mode, "host-output-alias")) {
+      output(builder, nir_imm_float(builder, 1), count / 4, count % 4);
+   } else if (!strcmp(mode, "host-spill") || !strcmp(mode, "host-spill-cfg")) {
+      if (!count || count > 65536)
+         return false;
+      nir_def **values = ralloc_array(builder->shader, nir_def *, count);
+      for (unsigned index = 0; index < count; index++)
+         values[index] = host_input(builder, index / 4, index % 4);
+      if (!strcmp(mode, "host-spill-cfg")) {
+         nir_push_if(builder, nir_fge(builder, values[0], nir_imm_float(builder, 0)));
+         nir_store_output(builder, nir_imm_float(builder, 1), nir_imm_int(builder, 0),
+            .src_type = nir_type_float32, .write_mask = 1, .component = 1,
+            .io_semantics = {.location = FRAG_RESULT_DATA0, .num_slots = 1});
+         nir_pop_if(builder, NULL);
+      }
+      nir_def *sum = values[0];
+      for (unsigned index = 1; index < count; index++)
+         sum = nir_fadd(builder, sum, values[index]);
+      nir_store_output(builder, sum, nir_imm_int(builder, 0), .src_type = nir_type_float32, .write_mask = 1,
+         .io_semantics = {.location = FRAG_RESULT_DATA0, .num_slots = 1});
+   } else if (!strcmp(mode, "host-textures")) {
+      const char *operation = getenv("MGC_TEST_TEXTURE_OP");
+      nir_texop op = operation && !strcmp(operation, "tex") ? nir_texop_tex :
+                    operation && !strcmp(operation, "txd") ? nir_texop_txd : nir_texop_txl;
+      unsigned textures[33], samplers[33], pairs = 0;
+      const char *bindings = getenv("MGC_TEST_BINDINGS");
+      char *copy = bindings ? strdup(bindings) : NULL;
+      char *state;
+      for (char *pair = copy ? strtok_r(copy, ",", &state) : NULL; pair && pairs < 33;
+           pair = strtok_r(NULL, ",", &state)) {
+         if (sscanf(pair, "%u:%u", &textures[pairs], &samplers[pairs]) != 2) {
+            free(copy);
+            return false;
+         }
+         pairs++;
+      }
+      free(copy);
+      if (!pairs) {
+         textures[0] = samplers[0] = 0;
+         pairs = 1;
+      }
+      nir_def *uv = nir_vec2(builder, host_input(builder, 0, 0), host_input(builder, 0, 1));
+      nir_def *lod = host_input(builder, 0, 2);
+      const char *kill = getenv("MGC_TEST_TEXTURE_KILL");
+      if (kill && !strcmp(kill, "1"))
+         nir_demote_if(builder, nir_flt(builder, nir_channel(builder, uv, 0), nir_imm_float(builder, 0)));
+      if (getenv("MGC_TEST_TEXTURE_AFTER_IF")) {
+         nir_push_if(builder, nir_fge(builder, nir_channel(builder, uv, 0), nir_imm_float(builder, 0)));
+         nir_store_output(builder, nir_imm_float(builder, 1), nir_imm_int(builder, 0),
+            .src_type = nir_type_float32, .write_mask = 1, .component = 1,
+            .io_semantics = {.location = FRAG_RESULT_DATA0, .num_slots = 1});
+         nir_pop_if(builder, NULL);
+      }
+      nir_def *sum = NULL;
+      for (unsigned sample = 0; sample < count; sample++) {
+         nir_tex_instr *texture = nir_tex_instr_create(builder->shader, op == nir_texop_tex ? 1 : op == nir_texop_txl ? 2 : 3);
+         texture->op = op;
+         texture->sampler_dim = GLSL_SAMPLER_DIM_2D;
+         texture->dest_type = nir_type_float32;
+         texture->coord_components = 2;
+         texture->texture_index = textures[sample % pairs];
+         texture->sampler_index = samplers[sample % pairs];
+         texture->src[0].src_type = nir_tex_src_coord;
+         texture->src[0].src = nir_src_for_ssa(uv);
+         if (op == nir_texop_txl) {
+            texture->src[1].src_type = nir_tex_src_lod;
+            texture->src[1].src = nir_src_for_ssa(nir_fadd_imm(builder, lod, sample * 0.125));
+         } else if (op == nir_texop_txd) {
+            texture->src[1].src_type = nir_tex_src_ddx;
+            texture->src[2].src_type = nir_tex_src_ddy;
+            if (getenv("MGC_TEST_CONSTANT_GRADIENTS")) {
+               texture->src[1].src = nir_src_for_ssa(nir_imm_vec2(builder, 0.125, 0));
+               texture->src[2].src = nir_src_for_ssa(nir_imm_vec2(builder, 0, 0.125));
+            } else {
+               texture->src[1].src = nir_src_for_ssa(nir_vec2(builder, host_input(builder, 1, 0), host_input(builder, 1, 1)));
+               texture->src[2].src = nir_src_for_ssa(nir_vec2(builder, host_input(builder, 1, 2), host_input(builder, 1, 3)));
+            }
+         }
+         nir_def_init(&texture->instr, &texture->def, 4, 32);
+         nir_builder_instr_insert(builder, &texture->instr);
+         sum = sum ? nir_fadd(builder, sum, &texture->def) : &texture->def;
+      }
+      if (!sum)
+         return false;
+      nir_store_output(builder, sum, nir_imm_int(builder, 0), .src_type = nir_type_float32,
+         .write_mask = 15, .io_semantics = {.location = FRAG_RESULT_DATA0, .num_slots = 1});
+   } else {
+      return false;
+   }
+   return true;
+}
+
+int
+main(int argc, char **argv)
+{
