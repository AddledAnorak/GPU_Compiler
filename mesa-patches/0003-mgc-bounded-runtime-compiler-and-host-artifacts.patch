+      return false;
+   }
+   for (unsigned index = 0; index < ctx->vertex_elements.count; index++) {
+      const struct pipe_vertex_element *element = &ctx->vertex_elements.elements[index];
+      if (element->dual_slot ||
+          ((ctx->host_instancing_version || features) ?
+             element->instance_divisor > MGC_HOST_INSTANCING_MAX_INDEX :
+             element->instance_divisor != 0))
+         return false;
+   }
+   return true;
+}
