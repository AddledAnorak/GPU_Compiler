+void
+mgc_init_draw_capture(struct pipe_context *pipe)
+{
+   struct mgc_context *ctx = mgc_context(pipe);
+   const char *directory = getenv("MGC_HOST_CAPTURE_DIR");
+   const char *instancing = getenv("MGC_HOST_INSTANCING");
+   const char *features = getenv("MGC_HOST_FEATURES");
+   const char *target = getenv("MGC_COMPILE_TARGET");
+   if (features && strcmp(features, "0")) {
+      if (!strcmp(features, "1") &&
+          (!target || !strcmp(target, "legacy-mgcsim-v1"))) {
+         ctx->host_features_version = 1;
+      } else {
+         ctx->host_features_version = UINT32_MAX;
+         mgc_context_error(pipe, PIPE_ERROR_BAD_INPUT,
+                           "unsupported MGC_HOST_FEATURES target or version");
+      }
+   }
+   if (instancing && strcmp(instancing, "0")) {
+      if (!strcmp(instancing, "1")) {
+         ctx->host_instancing_version = MGC_HOST_INSTANCING_VERSION;
+      } else {
+         ctx->host_instancing_version = UINT32_MAX;
+         mgc_context_error(pipe, PIPE_ERROR_BAD_INPUT, "unsupported MGC_HOST_INSTANCING version");
+      }
+   }
+   if (ctx->host_features_version && ctx->host_instancing_version) {
+      ctx->host_features_version = UINT32_MAX;
+      mgc_context_error(pipe, PIPE_ERROR_BAD_INPUT,
+                        "HOST FEATURES and the old instancing ABI are mutually exclusive");
+   }
+   mgc_host_executor_init(ctx);
+   ctx->capture_requested = directory && directory[0];
+   if ((!ctx->capture_requested && !ctx->host_executor_enabled) || ctx->artifact_callback)
+      return;
+   if (ctx->capture_requested)
+      ctx->capture_dir_fd = open(directory, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+   ctx->artifact_callback = mgc_capture_draw;
+   ctx->artifact_data = ctx;
+}
+
+static bool
+mgc_draw_buffer_valid(struct mgc_context *ctx, struct pipe_resource *resource,
+                       unsigned offset, unsigned size)
+{
+   if (!resource || resource->screen != &ctx->screen->base ||
+       resource->target != PIPE_BUFFER || offset > resource->width0 ||
+       size > resource->width0 - offset)
+      return false;
+   struct mgc_resource *storage = mgc_resource(resource);
+   return storage->data && resource->width0 <= storage->size &&
+      !mgc_resource_is_mapped(resource);
+}
+
+static bool
+mgc_draw_range_valid(struct mgc_context *ctx, const struct pipe_draw_info *info,
+                      const struct pipe_draw_start_count_bias *draw,
+                      struct mgc_draw_artifact *artifact)
+{
+   uint64_t first = draw->start;
+   uint64_t last = first + draw->count - 1;
+   if (last > UINT_MAX || (uint64_t)info->start_instance + info->instance_count -
+       (ctx->host_features_version == MGC_HOST_FEATURES_VERSION ? 1u : 0u) > UINT_MAX)
+      return false;
+   if (info->index_size) {
+      struct pipe_resource *resource = info->index.resource;
+      if (info->has_user_indices || !resource ||
+          !mgc_draw_buffer_valid(ctx, resource, 0, resource->width0) ||
+          (info->index_size != 1 && info->index_size != 2 && info->index_size != 4) ||
+          (last + 1) * info->index_size > resource->width0)
+         return false;
+      artifact->indices.data = mgc_resource(resource)->data;
+      artifact->indices.size = resource->width0;
+      first = UINT_MAX;
+      last = 0;
+      for (unsigned index = 0; index < draw->count; index++) {
+         uint32_t value = 0;
+         memcpy(&value, (const uint8_t *)artifact->indices.data +
+                ((size_t)draw->start + index) * info->index_size, info->index_size);
+         if (info->primitive_restart && value == info->restart_index)
+            continue;
+         int64_t biased = (int64_t)value + draw->index_bias;
+         if (biased < 0 || biased > UINT_MAX)
+            return false;
+         first = MIN2(first, biased);
+         last = MAX2(last, biased);
+      }
+      if (first == UINT_MAX && last == 0)
+         return true;
+   }
+   for (unsigned index = 0; index < ctx->vertex_elements.count; index++) {
+      const struct pipe_vertex_element *element = &ctx->vertex_elements.elements[index];
+      unsigned slot = element->vertex_buffer_index;
+      if (slot >= ctx->num_vertex_buffers || !artifact->vertices[slot].data)
+         return false;
+      uint64_t vertex = element->instance_divisor ?
+         (uint64_t)info->start_instance +
+            (info->instance_count - 1) / element->instance_divisor : last;
+      uint64_t end = (uint64_t)element->src_offset +
+         vertex * element->src_stride + util_format_get_blocksize(element->src_format);
+      if (end > artifact->vertices[slot].size)
+         return false;
+   }
+   return true;
+}
 
