+       texture->texture_non_uniform || texture->sampler_non_uniform ||
+       texture->texture_index || texture->sampler_index || texture->backend_flags) {
+      mgc_error(ctx, "mgc: host texture supports one direct 2D float fragment sample only");
+      return true;
+   }
+   if (mipmap) {
+      int lod_source = nir_tex_instr_src_index(texture, nir_tex_src_lod);
+      if (lod_source < 0 || !texture->src[lod_source].src.ssa ||
+          texture->src[lod_source].src.ssa->num_components != 1 ||
+          texture->src[lod_source].src.ssa->bit_size != 32 ||
+          !nir_src_is_const(texture->src[lod_source].src)) {
+         mgc_error(ctx, "mgc: host mipmap LOD must be a scalar float constant integer in 0..4");
+         return true;
+      }
+      float lod = nir_src_as_float(texture->src[lod_source].src);
+      if (!isfinite(lod) || lod < 0 || lod >= MGC_HOST_TEXTURE_MAX_LEVELS || floorf(lod) != lod) {
+         mgc_error(ctx, "mgc: host mipmap LOD must be a finite exact integer in 0..4");
+         return true;
+      }
+      ctx->host_texture_lod = (uint32_t)lod;
+   }
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic == nir_intrinsic_load_ubo || intr->intrinsic == nir_intrinsic_load_ubo_vec4) {
+            if (!nir_src_is_const(intr->src[0]) || nir_src_as_uint(intr->src[0]) == MGC_HOST_TEXTURE_BLOCK) {
+               mgc_error(ctx, "mgc: original shader conflicts with reserved host texture UBO block");
+               return true;
+            }
+         } else if (intr->intrinsic == nir_intrinsic_load_uniform) {
+            if (!nir_src_is_const(intr->src[0]) ||
+                (uint64_t)nir_intrinsic_base(intr) + nir_src_as_uint(intr->src[0]) >=
+                   MGC_HOST_TEXTURE_BLOCK * MGC_UBO_STRIDE_WORDS) {
+               mgc_error(ctx, "mgc: original uniform access conflicts with reserved host texture storage");
+               return true;
+            }
+         }
+      }
+   }
+   nir_builder builder = nir_builder_create(impl);
+   builder.cursor = nir_before_instr(&texture->instr);
+   nir_def *block = nir_imm_int(&builder, MGC_HOST_TEXTURE_BLOCK);
+   nir_def *sizes[2];
+   nir_def *coordinates[2];
+   nir_def *upper[2];
+   nir_def *weights[2];
+   bool linear_filter = mgc_host_texture_is_linear(ctx->options.host_texture_version);
+   for (unsigned axis = 0; axis < 2; axis++) {
+      enum mgc_host_texture_wrap wrap = mgc_host_texture_wrap_for_axis(&ctx->options, axis);
+      bool repeat = wrap == MGC_HOST_WRAP_REPEAT;
+      bool mirrored = wrap == MGC_HOST_WRAP_MIRRORED_REPEAT;
+      sizes[axis] = nir_load_ubo(&builder, 1, 32, block, nir_imm_int(&builder, axis * 4),
+                                  .align_mul = 4, .range = 4);
+      nir_def *coordinate = nir_channel(&builder, texture->src[coordinate_source].src.ssa, axis);
+      if (mirrored) {
+         nir_def *period = nir_ffloor(&builder, nir_fmul_imm(&builder, coordinate, 0.5));
+         coordinate = nir_fsub(&builder, coordinate, nir_fmul_imm(&builder, period, 2));
+         coordinate = nir_fmin(&builder, coordinate,
+                                 nir_fsub(&builder, nir_imm_float(&builder, 2), coordinate));
+      }
+      if (repeat)
+         coordinate = nir_fsub(&builder, coordinate, nir_ffloor(&builder, coordinate));
+      else
+         coordinate = nir_fmin(&builder, nir_fmax(&builder, coordinate, nir_imm_float(&builder, 0)),
+                                 nir_imm_float(&builder, 1));
+      if (linear_filter) {
+         nir_def *position = nir_fadd_imm(&builder, nir_fmul(&builder, coordinate, sizes[axis]), -0.5);
+         nir_def *lower = nir_ffloor(&builder, position);
+         weights[axis] = nir_fsub(&builder, position, lower);
+         nir_def *last = nir_fadd_imm(&builder, sizes[axis], -1);
+         if (repeat) {
+            coordinates[axis] = nir_bcsel(&builder,
+               nir_flt(&builder, lower, nir_imm_float(&builder, 0)), last, lower);
+            nir_def *next = nir_fadd_imm(&builder, lower, 1);
+            upper[axis] = nir_bcsel(&builder,
+               nir_fge(&builder, next, sizes[axis]), nir_imm_float(&builder, 0), next);
+         } else {
+            coordinates[axis] = nir_fmin(&builder, nir_fmax(&builder, lower, nir_imm_float(&builder, 0)), last);
+            upper[axis] = nir_fmin(&builder, nir_fmax(&builder, nir_fadd_imm(&builder, lower, 1),
+                                                     nir_imm_float(&builder, 0)), last);
+         }
+      } else {
+         nir_def *texel = nir_ffloor(&builder, nir_fmul(&builder, coordinate, sizes[axis]));
+         coordinates[axis] = repeat ?
+            nir_bcsel(&builder, nir_fge(&builder, texel, sizes[axis]), nir_imm_float(&builder, 0), texel) :
+            nir_fmin(&builder, texel, nir_fadd_imm(&builder, sizes[axis], -1));
+      }
    }
+   if (linear_filter) {
+      nir_def *indices[4];
+      for (unsigned row = 0; row < 2; row++) {
+         nir_def *vertical = row ? upper[1] : coordinates[1];
+         nir_def *row_base = nir_fmul(&builder, vertical, sizes[0]);
+         for (unsigned column = 0; column < 2; column++) {
+            nir_def *horizontal = column ? upper[0] : coordinates[0];
+            indices[row * 2 + column] = nir_f2i32(&builder, nir_fadd(&builder, row_base, horizontal));
+         }
+      }
+      nir_def *channels[4];
+      for (unsigned component = 0; component < 4; component++) {
+         nir_def *texels[4];
+         for (unsigned sample = 0; sample < 4; sample++)
+            texels[sample] = nir_load_ubo_vec4(&builder, 1, 32, block, indices[sample],
+                                                .base = 1, .component = component);
+         nir_def *lower = nir_fadd(&builder, texels[0],
+                                     nir_fmul(&builder, nir_fsub(&builder, texels[1], texels[0]), weights[0]));
+         nir_def *higher = nir_fadd(&builder, texels[2],
+                                      nir_fmul(&builder, nir_fsub(&builder, texels[3], texels[2]), weights[0]));
+         channels[component] = nir_fadd(&builder, lower,
+                                          nir_fmul(&builder, nir_fsub(&builder, higher, lower), weights[1]));
+      }
+      nir_def_replace(&texture->def, nir_vec4(&builder, channels[0], channels[1], channels[2], channels[3]));
+      nir_progress(true, impl, nir_metadata_control_flow);
+      return true;
+   }
+   nir_def *linear = nir_fadd(&builder, nir_fmul(&builder, coordinates[1], sizes[0]), coordinates[0]);
+   nir_def *index = nir_f2i32(&builder, linear);
+   nir_def *channels[4];
+   for (unsigned component = 0; component < 4; component++)
+      channels[component] = nir_load_ubo_vec4(&builder, 1, 32, block, index, .base = 1, .component = component);
+   nir_def_replace(&texture->def, nir_vec4(&builder, channels[0], channels[1], channels[2], channels[3]));
+   nir_progress(true, impl, nir_metadata_control_flow);
    return true;
 }
 
+static nir_def *
+mgc_host_texture_word(nir_builder *builder, unsigned binding, nir_def *offset,
+                      unsigned kind, unsigned field)
+{
+   return nir_load_ubo_vec4(builder, 1, 32,
+      nir_imm_int(builder, MGC_HOST_INTERNAL_TEXTURE_BLOCK + binding), offset,
+      .base = kind, .component = field);
+}
+
+static nir_def *
+mgc_host_finite(nir_builder *builder, unsigned binding, nir_def *value)
+{
+   return mgc_host_texture_word(builder, binding, value, 2, 0);
+}
+
+static nir_def *
+mgc_host_sample_level(struct mgc_ctx *ctx, nir_builder *builder,
+                      unsigned binding, nir_def *uv, nir_def *level)
+{
+   nir_def *record = nir_iadd_imm(builder, nir_iadd(builder, level, nir_iadd(builder, level, level)), 1);
+   nir_def *sizes[2], *lower[2], *upper[2], *weights[2];
+   nir_def *offset = mgc_host_texture_word(builder, binding, nir_iadd_imm(builder, record, 2), 0, 3);
+   bool linear = mgc_host_texture_is_linear(ctx->options.host_texture_version);
+   for (unsigned axis = 0; axis < 2; axis++) {
+      sizes[axis] = nir_i2f32(builder,
+         mgc_host_texture_word(builder, binding, nir_iadd_imm(builder, record, axis), 0, axis + 1));
+      nir_def *coordinate = mgc_host_finite(builder, binding, nir_channel(builder, uv, axis));
+      enum mgc_host_texture_wrap wrap = mgc_host_texture_wrap_for_axis(&ctx->options, axis);
+      bool repeat = wrap == MGC_HOST_WRAP_REPEAT;
+      if (wrap == MGC_HOST_WRAP_MIRRORED_REPEAT) {
+         coordinate = nir_fsub(builder, coordinate,
+            nir_fmul_imm(builder, nir_ffloor(builder, nir_fmul_imm(builder, coordinate, 0.5)), 2));
+         coordinate = nir_fmin(builder, coordinate, nir_fsub(builder, nir_imm_float(builder, 2), coordinate));
+      }
+      coordinate = repeat ? nir_ffract(builder, coordinate) :
+         nir_fmin(builder, nir_fmax(builder, coordinate, nir_imm_float(builder, 0)), nir_imm_float(builder, 1));
+      nir_def *position = nir_fmul(builder, coordinate, sizes[axis]);
+      nir_def *last = nir_fadd_imm(builder, sizes[axis], -1);
+      if (linear) {
+         position = nir_fadd_imm(builder, position, -0.5);
+         nir_def *floored = nir_ffloor(builder, position);
+         nir_def *next = nir_fadd_imm(builder, floored, 1);
+         weights[axis] = nir_fsub(builder, position, floored);
+         lower[axis] = repeat ? nir_bcsel(builder, nir_flt(builder, floored, nir_imm_float(builder, 0)), last, floored) :
+            nir_fmin(builder, nir_fmax(builder, floored, nir_imm_float(builder, 0)), last);
+         upper[axis] = repeat ? nir_bcsel(builder, nir_fge(builder, next, sizes[axis]), nir_imm_float(builder, 0), next) :
+            nir_fmin(builder, nir_fmax(builder, next, nir_imm_float(builder, 0)), last);
+      } else {
+         nir_def *floored = nir_ffloor(builder, position);
+         lower[axis] = repeat ? nir_bcsel(builder, nir_fge(builder, floored, sizes[axis]), nir_imm_float(builder, 0), floored) :
+            nir_fmin(builder, floored, last);
+      }
+   }
+   nir_def *indices[4];
+   unsigned taps = linear ? 4 : 1;
+   for (unsigned tap = 0; tap < taps; tap++) {
+      nir_def *horizontal = linear && (tap & 1) ? upper[0] : lower[0];
+      nir_def *vertical = linear && (tap & 2) ? upper[1] : lower[1];
+      nir_def *index = nir_f2i32(builder, nir_fadd(builder, nir_fmul(builder, vertical, sizes[0]), horizontal));
+      indices[tap] = nir_iadd(builder, offset, nir_iadd(builder, nir_iadd(builder, index, index),
+                                                                      nir_iadd(builder, index, index)));
+   }
+   nir_def *channels[4];
+   for (unsigned component = 0; component < 4; component++) {
+      nir_def *texels[4];
+      for (unsigned tap = 0; tap < taps; tap++)
+         texels[tap] = mgc_host_texture_word(builder, binding, nir_iadd_imm(builder, indices[tap], component), 1, 0);
+      if (linear) {
+         nir_def *bottom = nir_fadd(builder, texels[0], nir_fmul(builder, nir_fsub(builder, texels[1], texels[0]), weights[0]));
+         nir_def *top = nir_fadd(builder, texels[2], nir_fmul(builder, nir_fsub(builder, texels[3], texels[2]), weights[0]));
+         channels[component] = nir_fadd(builder, bottom, nir_fmul(builder, nir_fsub(builder, top, bottom), weights[1]));
+      } else {
+         channels[component] = texels[0];
+      }
+   }
+   return nir_vec(builder, channels, 4);
+}
+
+static nir_def *
+mgc_host_texture_log2(nir_builder *builder, nir_def *rho)
+{
+   nir_def *exponent = nir_imm_float(builder, 0);
+   nir_def *scale = nir_imm_float(builder, 1);
+   for (unsigned power = 1; power <= 5; power++) {
+      nir_def *above = nir_fge(builder, rho, nir_imm_float(builder, 1u << power));
+      exponent = nir_bcsel(builder, above, nir_imm_float(builder, power), exponent);
+      scale = nir_bcsel(builder, above, nir_imm_float(builder, 1u << power), scale);
+   }
+   nir_def *normalized = nir_fdiv(builder, rho, scale);
+   nir_def *ratio = nir_fdiv(builder, nir_fadd_imm(builder, normalized, -1), nir_fadd_imm(builder, normalized, 1));
+   nir_def *ratio_squared = nir_fmul(builder, ratio, ratio);
+   nir_def *polynomial = nir_fadd_imm(builder, nir_fmul_imm(builder, ratio_squared, 1.0 / 7.0), 1.0 / 5.0);
+   polynomial = nir_fadd_imm(builder, nir_fmul(builder, polynomial, ratio_squared), 1.0 / 3.0);
+   polynomial = nir_fadd_imm(builder, nir_fmul(builder, polynomial, ratio_squared), 1);
+   return nir_fadd(builder, exponent, nir_fmul_imm(builder, nir_fmul(builder, ratio, polynomial), 2.8853900817779268));
+}
+
+static nir_def *
+mgc_host_gradient_lod(nir_builder *builder, unsigned binding,
+                      nir_def *gradient_x, nir_def *gradient_y)
+{
+   nir_def *squared[2];
+   nir_def *gradients[] = {gradient_x, gradient_y};
+   for (unsigned direction = 0; direction < 2; direction++) {
+      nir_def *scaled[2];
+      for (unsigned axis = 0; axis < 2; axis++) {
+         nir_def *size = nir_i2f32(builder, mgc_host_texture_word(builder, binding,
+            nir_imm_int(builder, 1 + axis), 0, 1 + axis));
+         nir_def *gradient = mgc_host_finite(builder, binding, nir_channel(builder, gradients[direction], axis));
+         scaled[axis] = nir_fmul(builder, gradient, size);
+      }
+      squared[direction] = mgc_host_finite(builder, binding,
+         nir_fadd(builder, nir_fmul(builder, scaled[0], scaled[0]), nir_fmul(builder, scaled[1], scaled[1])));
+   }
+   nir_def *rho = nir_fsqrt(builder, nir_fmax(builder, nir_fmax(builder, squared[0], squared[1]), nir_imm_float(builder, 1)));
+   rho = nir_fmin(builder, rho, nir_imm_float(builder, 32));
+   return mgc_host_texture_log2(builder, rho);
+}
+
+static nir_def *
+mgc_host_anisotropic_sample(struct mgc_ctx *ctx, nir_builder *builder,
+                            unsigned binding, nir_def *uv, nir_def *gradient_x,
+                            nir_def *gradient_y, nir_def *last)
+{
+   nir_def *squared[2];
+   nir_def *gradients[] = {gradient_x, gradient_y};
+   for (unsigned direction = 0; direction < 2; direction++) {
+      nir_def *scaled[2];
+      for (unsigned axis = 0; axis < 2; axis++) {
+         nir_def *size = nir_i2f32(builder, mgc_host_texture_word(builder, binding,
+            nir_imm_int(builder, 1 + axis), 0, 1 + axis));
+         nir_def *gradient = mgc_host_finite(builder, binding, nir_channel(builder, gradients[direction], axis));
+         scaled[axis] = nir_fmul(builder, gradient, size);
+      }
+      squared[direction] = mgc_host_finite(builder, binding,
+         nir_fadd(builder, nir_fmul(builder, scaled[0], scaled[0]), nir_fmul(builder, scaled[1], scaled[1])));
+   }
+   nir_def *maximum = nir_fmax(builder, squared[0], squared[1]);
+   nir_def *minimum = nir_fmin(builder, squared[0], squared[1]);
+   nir_def *major_uv = nir_bcsel(builder, nir_fge(builder, squared[0], squared[1]), gradient_x, gradient_y);
+   nir_def *major_length = nir_fsqrt(builder, nir_fmax(builder, maximum, nir_imm_float(builder, 1)));
+   nir_def *minor_length = nir_fsqrt(builder, nir_fmax(builder, nir_fmax(builder, minimum,
+      nir_fmul_imm(builder, maximum, 1.0 / (MGC_HOST_FEATURES_TEXTURE_MAX_ANISOTROPY *
+                                         MGC_HOST_FEATURES_TEXTURE_MAX_ANISOTROPY))), nir_imm_float(builder, 1)));
+   nir_def *taps = nir_fmin(builder, nir_fmax(builder,
+      nir_fceil(builder, nir_fdiv(builder, major_length, minor_length)), nir_imm_float(builder, 1)),
+      nir_imm_float(builder, MGC_HOST_FEATURES_TEXTURE_MAX_ANISOTROPY));
+   nir_def *lod = mgc_host_texture_log2(builder, nir_fmin(builder, minor_length, nir_imm_float(builder, 32)));
+   lod = nir_fmin(builder, nir_fmax(builder, lod, nir_imm_float(builder, 0)), last);
+   nir_def *floored = nir_ffloor(builder, lod);
+   nir_def *lower_level = nir_f2i32(builder, floored);
+   nir_def *upper_level = nir_f2i32(builder, nir_fmin(builder, nir_fadd_imm(builder, floored, 1), last));
+   nir_def *mip_weight = nir_fsub(builder, lod, floored);
+   nir_def *sum = NULL;
+   for (unsigned tap = 0; tap < MGC_HOST_FEATURES_TEXTURE_MAX_ANISOTROPY; tap++) {
+      nir_def *active = nir_flt(builder, nir_imm_float(builder, tap), taps);
+      nir_def *position = nir_fadd_imm(builder, nir_fdiv(builder, nir_imm_float(builder, tap + 0.5), taps), -0.5);
+      nir_def *coordinate = nir_bcsel(builder, active, nir_fadd(builder, uv, nir_fmul(builder, major_uv, position)), uv);
+      nir_def *lower = mgc_host_sample_level(ctx, builder, binding, coordinate, lower_level);
+      nir_def *upper = mgc_host_sample_level(ctx, builder, binding, coordinate, upper_level);
+      nir_def *sample = nir_fadd(builder, lower, nir_fmul(builder, nir_fsub(builder, upper, lower), mip_weight));
+      sample = nir_bcsel(builder, active, sample, nir_imm_vec4(builder, 0, 0, 0, 0));
+      sum = sum ? nir_fadd(builder, sum, sample) : sample;
+   }
+   return nir_fdiv(builder, sum, taps);
+}
+
+static bool
+mgc_lower_dynamic_textures(struct mgc_ctx *ctx, nir_shader *nir)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_builder builder = nir_builder_create(impl);
+   bool progress = false;
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr_safe(instr, block) {
+         if (instr->type != nir_instr_type_tex)
+            continue;
+         nir_tex_instr *texture = nir_instr_as_tex(instr);
+         int coordinate = nir_tex_instr_src_index(texture, nir_tex_src_coord);
+         bool explicit_lod = texture->op == nir_texop_txl;
+         bool gradients = texture->op == nir_texop_txd;
+         if (nir->info.stage != MESA_SHADER_FRAGMENT ||
+             (!explicit_lod && !gradients && texture->op != nir_texop_tex) ||
+             texture->sampler_dim != GLSL_SAMPLER_DIM_2D || texture->dest_type != nir_type_float32 ||
+             texture->def.bit_size != 32 || texture->def.num_components != 4 || texture->coord_components != 2 ||
+             texture->num_srcs != (explicit_lod ? 2 : gradients ? 3 : 1) || coordinate < 0 ||
+             texture->is_array || texture->is_shadow || texture->is_new_style_shadow || texture->is_sparse ||
+             texture->array_is_lowered_cube || texture->is_gather_implicit_lod || texture->skip_helpers ||
+             texture->offset_non_uniform || texture->component || texture->texture_non_uniform ||
+             texture->sampler_non_uniform || texture->backend_flags ||
+             texture->texture_index >= MGC_HOST_FEATURES_TEXTURE_MAX_BINDINGS ||
+             texture->sampler_index >= MGC_HOST_FEATURES_TEXTURE_MAX_BINDINGS) {
+            mgc_error(ctx, "mgc: ABI4 texture requires direct 2D float texture/sampler bindings 0..3 and tex/txl/txd sources");
+            return false;
+         }
+         for (unsigned source = 0; source < texture->num_srcs; source++) {
+            unsigned components = texture->src[source].src_type == nir_tex_src_lod ? 1 : 2;
+            if (!texture->src[source].src.ssa || texture->src[source].src.ssa->bit_size != 32 ||
+                texture->src[source].src.ssa->num_components != components) {
+               mgc_error(ctx, "mgc: ABI4 texture coordinates/gradients require vec2 FP32 and LOD scalar FP32");
+               return false;
+            }
+         }
+         if (++ctx->host_texture_samples > MGC_HOST_FEATURES_TEXTURE_MAX_SAMPLES) {
+            mgc_error(ctx, "mgc: ABI4 texture exceeds 32 static samples");
+            return false;
+         }
+         unsigned binding = texture->texture_index;
+         unsigned pair;
+         for (pair = 0; pair < ctx->host_texture_bindings; pair++) {
+            if (ctx->host_texture_binding[pair].texture == binding &&
+                ctx->host_texture_binding[pair].sampler == texture->sampler_index)
+               break;
+         }
+         if (pair == ctx->host_texture_bindings) {
+            if (pair == 4) {
+               mgc_error(ctx, "mgc: ABI4 texture exceeds four unique static texture/sampler binding pairs");
+               return false;
+            }
+            ctx->host_texture_binding[pair] = (struct mgc_host_texture_binding){binding, texture->sampler_index};
+            ctx->host_texture_bindings++;
+         }
+         ctx->host_texture_lod_modes |= explicit_lod ? 1 : gradients ? 4 : 2;
+         builder.cursor = nir_before_instr(instr);
+         nir_def *uv = texture->src[coordinate].src.ssa;
+         bool anisotropic = ctx->options.host_texture_version == MGC_HOST_TEXTURE_ANISOTROPIC_VERSION;
+         nir_def *lod = NULL, *gradient_x = NULL, *gradient_y = NULL;
+         if (explicit_lod) {
+            int source = nir_tex_instr_src_index(texture, nir_tex_src_lod);
+            if (source < 0) {
+               mgc_error(ctx, "mgc: ABI4 txl requires a scalar LOD source");
+               return false;
+            }
+            if (nir_src_is_const(texture->src[source].src)) {
+               float value = nir_src_as_float(texture->src[source].src);
+               if (!isfinite(value) || (_mesa_float_to_half(value) & 0x7c00) == 0x7c00) {
+                  mgc_error(ctx, "mgc: ABI4 constant LOD must be finite representable FP16");
+                  return false;
+               }
+            }
+            lod = mgc_host_finite(&builder, binding, texture->src[source].src.ssa);
+         } else {
+            int source_x = nir_tex_instr_src_index(texture, nir_tex_src_ddx);
+            int source_y = nir_tex_instr_src_index(texture, nir_tex_src_ddy);
+            if (gradients && (source_x < 0 || source_y < 0)) {
+               mgc_error(ctx, "mgc: ABI4 txd requires both gradient sources");
+               return false;
+            }
+            if (anisotropic) {
+               gradient_x = gradients ? texture->src[source_x].src.ssa : nir_ddx_fine(&builder, uv);
+               gradient_y = gradients ? texture->src[source_y].src.ssa : nir_ddy_fine(&builder, uv);
+            } else {
+               lod = mgc_host_gradient_lod(&builder, binding,
+                  gradients ? texture->src[source_x].src.ssa : nir_ddx_fine(&builder, uv),
+                  gradients ? texture->src[source_y].src.ssa : nir_ddy_fine(&builder, uv));
+            }
+         }
+         nir_def *count = mgc_host_texture_word(&builder, binding, nir_imm_int(&builder, 0), 0, 0);
+         nir_def *last = nir_fadd_imm(&builder, nir_i2f32(&builder, count), -1);
+         nir_def *sample;
+         if (anisotropic && !explicit_lod) {
+            sample = mgc_host_anisotropic_sample(ctx, &builder, binding, uv, gradient_x, gradient_y, last);
+         } else {
+            lod = nir_fmin(&builder, nir_fmax(&builder, lod, nir_imm_float(&builder, 0)), last);
+            bool trilinear = ctx->options.host_texture_version == MGC_HOST_TEXTURE_TRILINEAR_VERSION || anisotropic;
+            nir_def *floored = nir_ffloor(&builder, trilinear ? lod :
+               nir_fmin(&builder, nir_fadd_imm(&builder, lod, 0.5), last));
+            sample = mgc_host_sample_level(ctx, &builder, binding, uv, nir_f2i32(&builder, floored));
+            if (trilinear) {
+               nir_def *next = mgc_host_sample_level(ctx, &builder, binding, uv,
+                  nir_f2i32(&builder, nir_fmin(&builder, nir_fadd_imm(&builder, floored, 1), last)));
+               sample = nir_fadd(&builder, sample, nir_fmul(&builder, nir_fsub(&builder, next, sample),
+                                                          nir_fsub(&builder, lod, floored)));
+            }
+         }
+         nir_def_replace(&texture->def, sample);
+         progress = true;
+      }
+   }
+   nir_progress(progress, impl, nir_metadata_control_flow);
+   return progress;
+}
+
+static void
+mgc_prepare_nir(nir_shader *nir)
+{
+   bool fold_constants = false;
+   nir_foreach_function_impl(impl, nir) {
+      unsigned blocks = 0;
+      nir_foreach_block(block, impl) {
+         blocks++;
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_intrinsic &&
+                nir_instr_as_intrinsic(instr)->intrinsic != nir_intrinsic_store_output)
+               fold_constants = true;
+         }
+      }
+      fold_constants |= blocks > 1;
+   }
+   NIR_PASS(_, nir, nir_lower_vars_to_ssa);
+   nir_shader_instructions_pass(nir, mgc_host_interpolated_input, nir_metadata_control_flow, NULL);
+   NIR_PASS(_, nir, nir_lower_io_to_scalar,
+            nir_var_shader_in | nir_var_shader_out | nir_var_mem_ubo, NULL, NULL);
+   nir_shader_instructions_pass(nir, mgc_scalarize_uniform, nir_metadata_control_flow, NULL);
+   NIR_PASS(_, nir, nir_lower_alu_to_scalar, NULL, NULL);
+   NIR_PASS(_, nir, nir_lower_load_const_to_scalar);
+   NIR_PASS(_, nir, nir_lower_phis_to_scalar, NULL, NULL);
+   const nir_opt_peephole_select_options select_options = {
+      .limit = 64, .indirect_load_ok = false, .expensive_alu_ok = true,
+   };
+   for (unsigned iteration = 0; iteration < 8; iteration++) {
+      bool progress = false;
+      NIR_PASS(progress, nir, nir_copy_prop);
+      NIR_PASS(progress, nir, nir_opt_dce);
+      if (fold_constants)
+         NIR_PASS(progress, nir, nir_opt_constant_folding);
+      NIR_PASS(progress, nir, nir_opt_dead_cf);
+      NIR_PASS(progress, nir, nir_opt_if, nir_opt_if_optimize_phi_true_false);
+      NIR_PASS(progress, nir, nir_opt_loop_unroll);
+      NIR_PASS(progress, nir, nir_opt_peephole_select, &select_options);
+      NIR_PASS(progress, nir, nir_opt_remove_phis);
+      progress |= nir_shader_instructions_pass(nir, mgc_lower_small_power,
+                                               nir_metadata_control_flow, NULL);
+      NIR_PASS(progress, nir, nir_opt_algebraic);
+      NIR_PASS(progress, nir, nir_opt_cse);
+      NIR_PASS(progress, nir, nir_opt_dce);
+      if (!progress)
+         break;
+   }
+}
+
+static bool
+mgc_lower_host_frag_coord(nir_builder *builder, nir_instr *instr, void *data)
+{
+   if (instr->type != nir_instr_type_intrinsic ||
+       nir_instr_as_intrinsic(instr)->intrinsic != nir_intrinsic_load_frag_coord)
+      return false;
+   struct mgc_ctx *ctx = data;
+   nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+   if (builder->shader->info.stage != MESA_SHADER_FRAGMENT || intr->def.bit_size != 32 ||
+       intr->def.num_components != 4) {
+      mgc_error(ctx, "mgc: ABI4 gl_FragCoord requires fragment vec4 FP32");
+      return false;
+   }
+   builder->cursor = nir_before_instr(instr);
+   nir_def *channels[4];
+   for (unsigned component = 0; component < 4; component++)
+      channels[component] = nir_load_ubo_vec4(builder, 1, 32, nir_imm_int(builder, 20),
+                                             nir_imm_int(builder, component), .base = 3);
+   nir_def_replace(&intr->def, nir_vec(builder, channels, 4));
+   return true;
+}
+
+static const char *const mgc_wait_names[] = {
+   "wait_short", "wait_load", "wait_fcomp", "wait_fadd", "wait_fmul", "wait_fdiv", "wait_conv",
+};
+
+static unsigned
+mgc_latency(const char *name)
+{
+   if (!strcmp(name, "store") || !strcmp(name, "and") || !strcmp(name, "add") ||
+       !strcmp(name, "floor16") || !strcmp(name, "ceil16") || !strcmp(name, "trunc16") ||
+       !strcmp(name, "fmin16") || !strcmp(name, "fmax16"))
+      return 1u << 0;
+   if (!strcmp(name, "load"))
+      return 1u << 1;
+   if (!strncmp(name, "fcomp_", 6))
+      return 1u << 2;
+   if (!strncmp(name, "icmp_", 5))
+      return 1u << 0;
+   if (!strcmp(name, "fadd16") || !strcmp(name, "fsub16"))
+      return 1u << 3;
+   if (!strcmp(name, "fmul16"))
+      return 1u << 4;
+   if (!strcmp(name, "fdiv16"))
+      return 1u << 5;
+   if (!strcmp(name, "f16toi32") || !strcmp(name, "i32tof16"))
+      return 1u << 6;
+   return 0;
+}
+
+static void
+mgc_drain_waits(struct mgc_ctx *ctx, char **text, unsigned required,
+                unsigned pending_regs[32], unsigned pending_crs[8], unsigned *memory)
+{
+   for (unsigned latency = 0; latency < ARRAY_SIZE(mgc_wait_names); latency++) {
+      unsigned mask = 1u << latency;
+      if (!(required & mask))
+         continue;
+      ralloc_asprintf_append(text, "%s\n", mgc_wait_names[latency]);
+      ctx->stats.waits++;
+      for (unsigned reg = 0; reg < 32; reg++)
+         pending_regs[reg] &= ~mask;
+      for (unsigned cr = 0; cr < 8; cr++)
+         pending_crs[cr] &= ~mask;
+      *memory &= ~mask;
+   }
+}
+
+static void
+mgc_validate_host_branches(struct mgc_ctx *ctx)
+{
+   if (!ctx->options.host_features_version)
+      return;
+   struct branch_point {
+      char name[96];
+      unsigned offset;
+   };
+   unsigned lines = 0;
+   for (const char *cursor = ctx->asm_text; *cursor; cursor++)
+      lines += *cursor == '\n';
+   struct branch_point *labels = ralloc_array(ctx->mem_ctx, struct branch_point, MAX2(lines, 1));
+   struct branch_point *branches = ralloc_array(ctx->mem_ctx, struct branch_point, MAX2(lines, 1));
+   if (!labels || !branches) {
+      mgc_error(ctx, "mgc: ABI4 branch range analysis allocation failed");
+      return;
+   }
+   unsigned num_labels = 0, num_branches = 0, offset = 0;
+   char *input = ralloc_strdup(ctx->mem_ctx, ctx->asm_text);
+   char *state;
+   for (char *line = strtok_r(input, "\n", &state); line; line = strtok_r(NULL, "\n", &state)) {
+      if (*line == ';')
+         continue;
+      if (strchr(line, ':')) {
+         sscanf(line, "%95[^:]", labels[num_labels].name);
+         labels[num_labels++].offset = offset;
+         continue;
+      }
+      char instruction[32], target[96];
+      unsigned fields = sscanf(line, "%31s %95s", instruction, target);
+      if (fields == 2 && !strncmp(instruction, "goto", 4)) {
+         snprintf(branches[num_branches].name, sizeof(branches[num_branches].name), "%s", target);
+         branches[num_branches++].offset = offset;
+      }
+      offset += !strcmp(instruction, "movi_i32") || !strcmp(instruction, "movi_f16") ? 2 : 1;
+   }
+   for (unsigned branch = 0; branch < num_branches; branch++) {
+      bool found = false;
+      for (unsigned label = 0; label < num_labels; label++) {
+         if (strcmp(branches[branch].name, labels[label].name))
+            continue;
+         found = true;
+         int64_t distance = (int64_t)labels[label].offset - branches[branch].offset - 1;
+         if (distance < -32768 || distance > 32767)
+            mgc_error(ctx, "mgc: ABI4 control-flow branch exceeds the legacy signed 16-bit span");
+         break;
+      }
+      if (!found)
+         mgc_error(ctx, "mgc: ABI4 control-flow branch has no emitted target");
+   }
+   ralloc_free(input);
+   ralloc_free(branches);
+   ralloc_free(labels);
+}
+
+static void
+mgc_schedule(struct mgc_ctx *ctx)
+{
+   unsigned pending_regs[32] = {0}, pending_crs[8] = {0}, memory = 0;
+   char *output = ralloc_strdup(ctx->mem_ctx, "");
+   char *input = ralloc_strdup(ctx->mem_ctx, ctx->asm_text);
+   char *state;
+   for (char *line = strtok_r(input, "\n", &state); line; line = strtok_r(NULL, "\n", &state)) {
+      if (line[0] == ';') {
+         ralloc_asprintf_append(&output, "%s\n", line);
+         continue;
+      }
+      if (strchr(line, ':')) {
+         unsigned required = memory;
+         for (unsigned reg = 0; reg < 32; reg++)
+            required |= pending_regs[reg];
+         for (unsigned cr = 0; cr < 8; cr++)
+            required |= pending_crs[cr];
+         if (ctx->options.schedule)
+            mgc_drain_waits(ctx, &output, required, pending_regs, pending_crs, &memory);
+         ralloc_asprintf_append(&output, "%s\n", line);
+         continue;
+      }
+      if (!strncmp(line, "wait_", 5)) {
+         ctx->stats.waits_before_scheduling++;
+         if (ctx->options.target == MGC_TARGET_C_INTERPRETER_V1)
+            continue;
+         if (!ctx->options.schedule) {
+            ralloc_asprintf_append(&output, "%s\n", line);
+            ctx->stats.waits++;
+         }
+         continue;
+      }
+      char name[32];
+      if (sscanf(line, "%31s", name) != 1)
+         continue;
+      ctx->stats.instructions++;
+      if (!ctx->options.schedule) {
+         if (ctx->options.target == MGC_TARGET_C_INTERPRETER_V1 &&
+             !strncmp(line, "goto", 4) && (line[4] == ' ' || line[4] == '.'))
+            ralloc_asprintf_append(&output, "jump%s\n", line + 4);
+         else
+            ralloc_asprintf_append(&output, "%s\n", line);
+         continue;
+      }
+      unsigned required = 0;
+      int destination = -1;
+      bool predicate_destination = false;
+      for (const char *cursor = line; *cursor; cursor++) {
+         bool predicate = cursor[0] == 'c' && cursor[1] == 'r';
+         bool scalar = cursor[0] == 'r' && (cursor == line || cursor[-1] != 'c');
+         if (!predicate && !scalar)
+            continue;
+         const char *digits = cursor + (predicate ? 2 : 1);
+         if (*digits < '0' || *digits > '9')
+            continue;
+         unsigned index = strtoul(digits, NULL, 10);
+         if (index >= (predicate ? 8 : 32)) {
+            mgc_error(ctx, "mgc: scheduler encountered an invalid register");
+            return;
+         }
+         required |= predicate ? pending_crs[index] : pending_regs[index];
+         destination = index;
+         predicate_destination = predicate;
+      }
+      if (!strcmp(name, "load") || !strcmp(name, "store"))
+         required |= memory;
+      if (!strncmp(name, "stop_core", 9) || !strncmp(name, "goto", 4)) {
+         required |= memory;
+         for (unsigned reg = 0; reg < 32; reg++)
+            required |= pending_regs[reg];
+         for (unsigned cr = 0; cr < 8; cr++)
+            required |= pending_crs[cr];
+      }
+      mgc_drain_waits(ctx, &output, required, pending_regs, pending_crs, &memory);
+      ralloc_asprintf_append(&output, "%s\n", line);
+      unsigned latency = mgc_latency(name);
+      if (!strcmp(name, "store"))
+         memory |= latency;
+      else if (destination >= 0) {
+         if (predicate_destination)
+            pending_crs[destination] = latency;
+         else
+            pending_regs[destination] = latency;
+      }
+   }
+   ctx->asm_text = output;
+   mgc_validate_host_branches(ctx);
+}
+
+static bool
+mgc_phi_is_integer_inner(nir_def *def, bool *visited, bool host_instancing)
+{
+   if (visited[def->index])
+      return false;
+   visited[def->index] = true;
+   nir_foreach_use(source, def) {
+      nir_instr *parent = nir_src_parent_instr(source);
+      if (host_instancing && parent->type == nir_instr_type_intrinsic) {
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(parent);
+         if (intr->intrinsic == nir_intrinsic_store_output && &intr->src[0] == source &&
+             nir_alu_type_get_base_type(nir_intrinsic_instr_src_type(intr, 0)) == nir_type_int)
+            return true;
+      }
+      if (parent->type == nir_instr_type_phi &&
+          mgc_phi_is_integer_inner(&nir_instr_as_phi(parent)->def, visited, host_instancing))
+         return true;
+      if (parent->type != nir_instr_type_alu)
+         continue;
+      nir_alu_instr *alu = nir_instr_as_alu(parent);
+      if (alu->op == nir_op_mov || alu->op == nir_op_bcsel) {
+         if (mgc_phi_is_integer_inner(&alu->def, visited, host_instancing))
+            return true;
+         continue;
+      }
+      if (alu->op == nir_op_iand || alu->op == nir_op_ior)
+         continue;
+      for (unsigned input = 0; input < nir_op_infos[alu->op].num_inputs; input++) {
+         if (&alu->src[input].src == source) {
+            nir_alu_type type = nir_alu_type_get_base_type(nir_op_infos[alu->op].input_types[input]);
+            if (type == nir_type_int || type == nir_type_uint)
+               return true;
+         }
+      }
+   }
+   return false;
+}
+
+static bool
+mgc_phi_is_integer(struct mgc_ctx *ctx, nir_def *def, unsigned ssa_alloc)
+{
+   bool *visited = rzalloc_array(ctx->mem_ctx, bool, MAX2(ssa_alloc, 1));
+   bool integer = mgc_phi_is_integer_inner(def, visited,
+      ctx->options.host_instancing_version == MGC_HOST_INSTANCING_VERSION || ctx->options.host_features_version);
+   ralloc_free(visited);
+   return integer;
+}
+
+static void
+mgc_setup_cfg(struct mgc_ctx *ctx, nir_function_impl *impl)
+{
+   unsigned registers = 0, predicates = 0;
+   ctx->cfg = true;
+   nir_metadata_require(impl, nir_metadata_block_index |
+                              nir_metadata_instr_index | nir_metadata_live_defs);
+   nir_def **definitions = ralloc_array(ctx->mem_ctx, nir_def *, 4096);
+   if (!definitions) {
+      mgc_error(ctx, "mgc: CFG analysis allocation failed");
+      return;
+   }
+   unsigned count = 0;
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         nir_def *def = nir_instr_def(instr);
+         if (!def)
+            continue;
+         if (instr->type == nir_instr_type_load_const) {
+            mgc_emit_load_const(ctx, nir_instr_as_load_const(instr));
+            continue;
+         }
+         if (def->num_components != 1 ||
+             (def->bit_size != 1 && def->bit_size != 16 && def->bit_size != 32)) {
+            mgc_error(ctx, "mgc: CFG values must be scalar booleans or 16/32-bit values");
+            return;
+         }
+         if (count == 4096) {
+            mgc_error(ctx, "mgc: CFG exceeds the 4096-value analysis limit");
+            return;
+         }
+         definitions[count++] = def;
+      }
+   }
+   for (unsigned value = 0; value < count; value++) {
+      nir_def *def = definitions[value];
+      bool predicate = def->bit_size == 1;
+      unsigned unavailable = 0;
+      for (unsigned previous = 0; previous < value; previous++) {
+         nir_def *other = definitions[previous];
+         if (predicate != (other->bit_size == 1) || ctx->vals[other->index].kind == MGC_VAL_SPILL)
+            continue;
+         bool source_overlap = false;
+         nir_foreach_use(source, def) {
+            if (nir_src_parent_instr(source) == other->parent_instr)
+               source_overlap = true;
+         }
+         nir_foreach_use(source, other) {
+            if (nir_src_parent_instr(source) == def->parent_instr)
+               source_overlap = true;
+         }
+         if (source_overlap || nir_defs_interfere(def, other))
+            unavailable |= 1u << ctx->vals[other->index].index;
+      }
+      unsigned limit = predicate ? 7 : 24;
+      unsigned available = ((1u << limit) - 1) & ~unavailable;
+      if (!available) {
+         if (ctx->options.host_features_version && !predicate) {
+            if (ctx->next_spill == MGC_HOST_FEATURES_SPILL_WORDS) {
+               mgc_error(ctx, "mgc: CFG scalar spill storage exceeds 4096 words");
+               return;
+            }
+            ctx->vals[def->index] = (struct mgc_val){
+               .kind = MGC_VAL_SPILL, .index = ctx->next_spill++,
+               .integer = mgc_phi_is_integer(ctx, def, impl->ssa_alloc),
+            };
+            ctx->stats.spill_words = ctx->next_spill;
+            continue;
+         }
+         mgc_error(ctx, "mgc: CFG %s register pressure exceeds %u registers; "
+                        "eight scalar and one predicate scratch registers remain reserved; no spills",
+                   predicate ? "predicate" : "scalar", limit);
+         return;
+      }
+      unsigned physical = ffs(available) - 1;
+      ctx->vals[def->index] = (struct mgc_val){
+         .kind = predicate ? MGC_VAL_PRED : MGC_VAL_REG,
+         .index = physical,
+         .integer = !predicate && def->parent_instr->type == nir_instr_type_phi &&
+                    mgc_phi_is_integer(ctx, def, impl->ssa_alloc),
+      };
+      if (predicate)
+         predicates = MAX2(predicates, physical + 1);
+      else
+         registers = MAX2(registers, physical + 1);
+   }
+   ralloc_free(definitions);
+   ctx->next_reg = registers;
+   ctx->active_regs = registers ? (1u << registers) - 1 : 0;
+   ctx->free_crs = 0xffu & ~((1u << predicates) - 1);
+   ctx->live_crs = predicates;
+   ctx->stats.registers = registers;
+   ctx->stats.predicates = predicates;
+}
+
+static void
+mgc_emit_halt(struct mgc_ctx *ctx, bool discarded)
+{
+   if (ctx->fragment_status) {
+      int value_reg = mgc_alloc_reg(ctx);
+      int address_reg = mgc_alloc_reg(ctx);
+      if (ctx->error)
+         return;
+      if (ctx->options.host_features_version && !discarded) {
+         unsigned predicate = mgc_alloc_cr(ctx);
+         int zero = mgc_alloc_reg(ctx);
+         int committed = mgc_alloc_reg(ctx);
+         ralloc_asprintf_append(&ctx->asm_text,
+            "movi_i32 %u, r%d\nload r%d, r%d\nwait_load\n"
+            "movi_i32 0, r%d\nicmp_eq r%d, r%d, cr%u\nwait_short\n"
+            "movi_i32 2, r%d\ncopy.cr%u r%d, r%d\nstore r%d, r%d\nwait_short\n",
+            ctx->options.fragment_output_base + MGC_FRAGMENT_STATUS_OFFSET, address_reg, address_reg, value_reg,
+            zero, value_reg, zero, predicate, committed, predicate, committed, value_reg, value_reg, address_reg);
+         mgc_free_reg(ctx, committed);
+         mgc_free_reg(ctx, zero);
+         mgc_free_cr(ctx, predicate);
+         mgc_free_reg(ctx, address_reg);
+         mgc_free_reg(ctx, value_reg);
+         ralloc_asprintf_append(&ctx->asm_text, "stop_core\n");
+         return;
+      }
+      ralloc_asprintf_append(&ctx->asm_text,
+                              "movi_i32 %u, r%d\nmovi_i32 %u, r%d\n"
+                              "store r%d, r%d\nwait_short\n",
+                              discarded ? MGC_FRAGMENT_DISCARDED : MGC_FRAGMENT_COMMITTED,
+                              value_reg, ctx->options.fragment_output_base + MGC_FRAGMENT_STATUS_OFFSET,
+                              address_reg, value_reg, address_reg);
+      mgc_free_reg(ctx, address_reg);
+      mgc_free_reg(ctx, value_reg);
+   }
+   if (!ctx->options.host_features_version || !discarded)
+      ralloc_asprintf_append(&ctx->asm_text, "stop_core\n");
+}
+
+static void
+mgc_emit_instruction(struct mgc_ctx *ctx, nir_instr *instr, gl_shader_stage stage)
+{
+   ctx->pinned_regs = 0;
+   nir_def *definition = nir_instr_def(instr);
+   struct mgc_val assigned = definition ? ctx->vals[definition->index] : (struct mgc_val){0};
+   if (ctx->options.target == MGC_TARGET_FP16_HARDWARE_V1) {
+      bool supported = instr->type == nir_instr_type_load_const;
+      if (instr->type == nir_instr_type_alu) {
+         nir_op operation = nir_instr_as_alu(instr)->op;
+         supported = operation == nir_op_mov || operation == nir_op_fadd;
+      }
+      if (instr->type == nir_instr_type_intrinsic) {
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         supported = intr->intrinsic == nir_intrinsic_store_output ||
+                     intr->intrinsic == nir_intrinsic_load_input ||
+                     intr->intrinsic == nir_intrinsic_load_uniform ||
+                     intr->intrinsic == nir_intrinsic_load_ubo ||
+                     intr->intrinsic == nir_intrinsic_load_ubo_vec4;
+         if (intr->intrinsic == nir_intrinsic_store_output &&
+             nir_intrinsic_has_src_type(intr) &&
+             nir_alu_type_get_base_type(nir_intrinsic_src_type(intr)) != nir_type_float)
+            supported = false;
+      }
+      if (!supported) {
+         mgc_error(ctx, "mgc: hardware target supports only scalar floating constants, copies, addition, and direct IO; unsupported NIR instruction");
+         return;
+      }
+   }
+   switch (instr->type) {
+   case nir_instr_type_load_const:
+      if (!ctx->cfg)
+         mgc_emit_load_const(ctx, nir_instr_as_load_const(instr));
+      break;
+   case nir_instr_type_alu:
+      mgc_emit_alu(ctx, nir_instr_as_alu(instr));
+      break;
+   case nir_instr_type_intrinsic: {
+      nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+      if (ctx->options.target == MGC_TARGET_C_INTERPRETER_V1 &&
+          (intr->intrinsic == nir_intrinsic_demote || intr->intrinsic == nir_intrinsic_terminate ||
+           intr->intrinsic == nir_intrinsic_demote_if || intr->intrinsic == nir_intrinsic_terminate_if)) {
+         mgc_error(ctx, "mgc: current C target has no fragment discard/output-valid contract");
+         return;
+      }
+      if (intr->intrinsic == nir_intrinsic_store_output) {
+         mgc_emit_store_output(ctx, intr, stage);
+      } else if (intr->intrinsic == nir_intrinsic_ddx || intr->intrinsic == nir_intrinsic_ddy ||
+                 intr->intrinsic == nir_intrinsic_ddx_fine || intr->intrinsic == nir_intrinsic_ddy_fine) {
+         mgc_emit_derivative(ctx, intr);
+      } else if (ctx->options.host_features_version &&
+                 (intr->intrinsic == nir_intrinsic_load_instance_id || intr->intrinsic == nir_intrinsic_load_vertex_id ||
+                  intr->intrinsic == nir_intrinsic_load_base_instance || intr->intrinsic == nir_intrinsic_load_draw_id ||
+                  intr->intrinsic == nir_intrinsic_load_front_face)) {
+         mgc_emit_host_builtin(ctx, intr, stage);
+      } else if (intr->intrinsic == nir_intrinsic_load_instance_id) {
+         mgc_emit_instance_id(ctx, intr, stage);
+      } else if (intr->intrinsic == nir_intrinsic_load_input ||
+                 intr->intrinsic == nir_intrinsic_load_uniform ||
+                 intr->intrinsic == nir_intrinsic_load_ubo ||
+                 intr->intrinsic == nir_intrinsic_load_ubo_vec4) {
+         mgc_emit_load(ctx, intr);
+      } else if (intr->intrinsic == nir_intrinsic_demote ||
+                 intr->intrinsic == nir_intrinsic_terminate) {
+         mgc_emit_halt(ctx, true);
+      } else if (intr->intrinsic == nir_intrinsic_demote_if ||
+                 intr->intrinsic == nir_intrinsic_terminate_if) {
+         struct mgc_val condition = ctx->vals[intr->src[0].ssa->index];
+         if (condition.kind == MGC_VAL_PRED) {
+            if (ctx->fragment_status) {
+               unsigned label = ctx->discard_labels++;
+               ralloc_asprintf_append(&ctx->asm_text,
+                                       "goto.cr%d mgc_discard_%u\ngoto mgc_continue_%u\nmgc_discard_%u:\n",
+                                       condition.index, label, label, label);
+               mgc_emit_halt(ctx, true);
+               ralloc_asprintf_append(&ctx->asm_text, "mgc_continue_%u:\n", label);
+            } else {
+               ralloc_asprintf_append(&ctx->asm_text, "stop_core.cr%d\n", condition.index);
+            }
+         } else if (condition.kind == MGC_VAL_LITERAL) {
+            if (nir_const_value_as_uint(condition.literal, condition.bit_size))
+               mgc_emit_halt(ctx, true);
+         } else
+            mgc_error(ctx, "mgc: early discard condition must be a predicate");
+      } else {
+         mgc_error(ctx, "mgc: unsupported NIR intrinsic '%s'; see docs/backend/README.md",
+                   nir_intrinsic_infos[intr->intrinsic].name);
+      }
+      break;
+   }
+   case nir_instr_type_phi:
+      if (!ctx->cfg)
+         mgc_error(ctx, "mgc: phi requires the CFG path");
+      break;
+   case nir_instr_type_jump:
+      if (!ctx->cfg || nir_instr_as_jump(instr)->type == nir_jump_goto ||
+          nir_instr_as_jump(instr)->type == nir_jump_goto_if)
+         mgc_error(ctx, "mgc: jump requires the CFG path");
+      break;
+   default:
+      mgc_error(ctx, "mgc: unsupported NIR instruction type %d", instr->type);
+      break;
+   }
+   if (ctx->cfg || ctx->options.host_features_version) {
+      if (ctx->cfg && definition && assigned.kind == MGC_VAL_SPILL && instr->type != nir_instr_type_phi) {
+         struct mgc_val result = ctx->vals[definition->index];
+         uint32_t base = stage == MESA_SHADER_FRAGMENT ? ctx->options.fragment_output_base : ctx->options.vertex_output_base;
+         ralloc_asprintf_append(&ctx->asm_text, "movi_i32 %u, r31\nstore r%d, r31\nwait_short\n",
+                                 base + MGC_HOST_FEATURES_OUTPUT_RESERVED + assigned.index, result.index);
+         ctx->stats.spill_stores++;
+         mgc_free_reg(ctx, result.index);
+         ctx->vals[definition->index] = assigned;
+         ctx->stats.registers = 32;
+      }
+      unsigned temporaries = ctx->transient_regs;
+      ctx->transient_regs = 0;
+      for (unsigned reg = 0; reg < 32; reg++) {
+         if (temporaries & (1u << reg))
+            mgc_free_reg(ctx, reg);
+      }
+   }
+}
+
+static void
+mgc_validate_discard(struct mgc_ctx *ctx, nir_function_impl *impl, gl_shader_stage stage)
+{
+   bool stored = false, discarded = false, backedge = false;
+   nir_index_blocks(impl);
+   nir_foreach_block(block, impl) {
+      for (unsigned edge = 0; edge < 2; edge++) {
+         nir_block *successor = block->successors[edge];
+         if (successor && successor != impl->end_block && successor->index <= block->index)
+            backedge = true;
+      }
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         stored |= intr->intrinsic == nir_intrinsic_store_output;
+         if (intr->intrinsic == nir_intrinsic_demote || intr->intrinsic == nir_intrinsic_terminate ||
+             intr->intrinsic == nir_intrinsic_demote_if || intr->intrinsic == nir_intrinsic_terminate_if) {
+            discarded = true;
+            if ((stored && !ctx->fragment_status) || stage != MESA_SHADER_FRAGMENT) {
+               mgc_error(ctx, "mgc: discard is supported only before all output stores in fragment shaders");
+               return;
+            }
+         }
+      }
+   }
+   if (discarded && backedge && !ctx->fragment_status)
+      mgc_error(ctx, "mgc: discard inside looping control flow requires deferred output commits");
+}
+
+static void
+mgc_emit_edge(struct mgc_ctx *ctx, nir_block *predecessor, nir_block *successor,
+               nir_block *end_block)
+{
+   ralloc_asprintf_append(&ctx->asm_text, "mgc_edge_%u_%u:\n", predecessor->index, successor->index);
+   int temporary_regs[8];
+   struct mgc_val destinations[8];
+   unsigned copies = 0;
+   nir_foreach_instr(instr, successor) {
+      if (instr->type != nir_instr_type_phi)
+         continue;
+      if (copies >= ARRAY_SIZE(temporary_regs)) {
+         mgc_error(ctx, "mgc: CFG edge requires more than eight parallel phi copies");
+         return;
+      }
+      nir_phi_instr *phi = nir_instr_as_phi(instr);
+      struct mgc_val destination = ctx->vals[phi->def.index];
+      nir_def *incoming = NULL;
+      nir_foreach_phi_src(source, phi) {
+         if (source->pred == predecessor)
+            incoming = source->src.ssa;
+      }
+      if (!incoming) {
+         mgc_error(ctx, "mgc: phi has no source for CFG edge");
+         return;
+      }
+      struct mgc_val source = ctx->vals[incoming->index];
+      int reloaded = -1;
+      if (source.kind == MGC_VAL_SPILL) {
+         source = destination.integer ? mgc_integer_val(ctx, incoming) : mgc_float_val(ctx, incoming);
+         reloaded = source.index;
+         ctx->transient_regs &= ~(1u << reloaded);
+      }
+      int temporary = mgc_alloc_reg(ctx);
+      if (ctx->error)
+         return;
+      temporary_regs[copies] = temporary;
+      destinations[copies++] = destination;
+      if (source.kind == MGC_VAL_LITERAL) {
+         uint32_t bits = destination.kind == MGC_VAL_PRED ?
+            (nir_const_value_as_uint(source.literal, source.bit_size) ? 0x3c00 : 0) :
+            destination.integer ? nir_const_value_as_uint(source.literal, source.bit_size) :
+            mgc_target_half(ctx, nir_const_value_as_float(source.literal, source.bit_size));
+         ralloc_asprintf_append(&ctx->asm_text, "movi_i32 %u, r%d\n", bits, temporary);
+      } else if (source.kind == MGC_VAL_PRED) {
+         ralloc_asprintf_append(&ctx->asm_text, "copy #2, r%d\ncopy.cr%d #3, r%d\n",
+                                 temporary, source.index, temporary);
+      } else {
+         char source_text[8];
+         mgc_val_str(source, source_text);
+         ralloc_asprintf_append(&ctx->asm_text, "copy %s, r%d\n", source_text, temporary);
+      }
+      mgc_free_reg(ctx, reloaded);
+   }
+   for (unsigned copy = 0; copy < copies; copy++) {
+      struct mgc_val destination = destinations[copy];
+      if (destination.kind == MGC_VAL_PRED) {
+         ralloc_asprintf_append(&ctx->asm_text,
+                                 "fcomp_ne #2, r%d, cr%d\nwait_fcomp\n",
+                                 temporary_regs[copy], destination.index);
+      } else if (destination.kind == MGC_VAL_SPILL) {
+         uint32_t base = ctx->stage == MESA_SHADER_FRAGMENT ? ctx->options.fragment_output_base : ctx->options.vertex_output_base;
+         ralloc_asprintf_append(&ctx->asm_text, "movi_i32 %u, r31\nstore r%d, r31\nwait_short\n",
+                                 base + MGC_HOST_FEATURES_OUTPUT_RESERVED + destination.index, temporary_regs[copy]);
+         ctx->stats.spill_stores++;
+         ctx->stats.registers = 32;
+      } else {
+         ralloc_asprintf_append(&ctx->asm_text, "copy r%d, r%d\n",
+                                 temporary_regs[copy], destination.index);
+      }
+      mgc_free_reg(ctx, temporary_regs[copy]);
+   }
+   if (successor == end_block)
+      mgc_emit_halt(ctx, false);
+   else
+      ralloc_asprintf_append(&ctx->asm_text, "goto mgc_block_%u\n", successor->index);
+}
+
+static void
+mgc_emit_cfg(struct mgc_ctx *ctx, nir_function_impl *impl, gl_shader_stage stage)
+{
+   mgc_setup_cfg(ctx, impl);
+   if (ctx->error)
+      return;
+   nir_foreach_block(block, impl) {
+      ralloc_asprintf_append(&ctx->asm_text, "mgc_block_%u:\n", block->index);
+      nir_foreach_instr(instr, block) {
+         mgc_emit_instruction(ctx, instr, stage);
+         if (ctx->error)
+            return;
+      }
+      nir_if *branch = nir_block_get_following_if(block);
+      if (branch) {
+         struct mgc_val condition = ctx->vals[branch->condition.ssa->index];
+         if (condition.kind == MGC_VAL_LITERAL) {
+            unsigned selected = nir_const_value_as_uint(condition.literal, condition.bit_size) ? 0 : 1;
+            ralloc_asprintf_append(&ctx->asm_text, "goto mgc_edge_%u_%u\n", block->index,
+                                    block->successors[selected]->index);
+         } else if (condition.kind == MGC_VAL_PRED) {
+            ralloc_asprintf_append(&ctx->asm_text,
+                                    "goto.cr%d mgc_edge_%u_%u\ngoto mgc_edge_%u_%u\n",
+                                    condition.index, block->index, block->successors[0]->index,
+                                    block->index, block->successors[1]->index);
+         } else {
+            mgc_error(ctx, "mgc: CFG if condition must be a predicate");
+            return;
+         }
+      } else if (block->successors[0]) {
+         ralloc_asprintf_append(&ctx->asm_text, "goto mgc_edge_%u_%u\n",
+                                 block->index, block->successors[0]->index);
+      } else {
+         mgc_emit_halt(ctx, false);
+      }
+   }
+   nir_foreach_block(block, impl) {
+      for (unsigned edge = 0; edge < 2; edge++) {
+         if (block->successors[edge]) {
+            mgc_emit_edge(ctx, block, block->successors[edge], impl->end_block);
+            if (ctx->error)
+               return;
+         }
+      }
+   }
+}
+
+struct mgc_compile_options
+mgc_default_compile_options(void)
+{
+   return (struct mgc_compile_options){
+      .input_base = MGC_INPUT_BASE,
+      .uniform_base = MGC_UNIFORM_BASE,
+      .vertex_output_base = MGC_VERTEX_OUTPUT_BASE,
+      .fragment_output_base = MGC_FRAGMENT_OUTPUT_BASE,
+      .schedule = true,
+      .target = MGC_TARGET_LEGACY,
+      .host_texture_wrap_s = MGC_HOST_WRAP_CLAMP_TO_EDGE,
+      .host_texture_wrap_t = MGC_HOST_WRAP_CLAMP_TO_EDGE,
+      .host_instancing_version = 0,
+      .texture_base = MGC_HOST_TEXTURE_BASE,
+   };
+}
+
+struct mgc_compile_options
+mgc_default_hardware_compile_options(void)
+{
+   struct mgc_compile_options options = mgc_default_compile_options();
+   options.input_base *= 4;
+   options.uniform_base *= 4;
+   options.vertex_output_base *= 4;
+   options.fragment_output_base *= 4;
+   options.schedule = false;
+   options.target = MGC_TARGET_FP16_HARDWARE_V1;
+   return options;
+}
+
+struct mgc_compile_options
+mgc_default_c_interpreter_compile_options(void)
+{
+   struct mgc_compile_options options = mgc_default_hardware_compile_options();
+   options.target = MGC_TARGET_C_INTERPRETER_V1;
+   return options;
+}
+
+bool
+mgc_host_texture_is_linear(unsigned version)
+{
+   return version == MGC_HOST_TEXTURE_LINEAR_VERSION ||
+      version == MGC_HOST_TEXTURE_LINEAR_REPEAT_VERSION ||
+      version == MGC_HOST_TEXTURE_LINEAR_MIRRORED_REPEAT_VERSION ||
+      version == MGC_HOST_TEXTURE_LINEAR_MIXED_VERSION ||
+      version == MGC_HOST_TEXTURE_LINEAR_MIPMAP_VERSION ||
+      version == MGC_HOST_TEXTURE_DYNAMIC_LINEAR_VERSION || version == MGC_HOST_TEXTURE_TRILINEAR_VERSION ||
+      version == MGC_HOST_TEXTURE_ANISOTROPIC_VERSION;
+}
+
+enum mgc_host_texture_wrap
+mgc_host_texture_wrap_for_axis(const struct mgc_compile_options *options, unsigned axis)
+{
+   if (!options || axis > 1)
+      return (enum mgc_host_texture_wrap)-1;
+   switch (options->host_texture_version) {
+   case 0:
+   case MGC_HOST_TEXTURE_VERSION:
+   case MGC_HOST_TEXTURE_LINEAR_VERSION:
+      return MGC_HOST_WRAP_CLAMP_TO_EDGE;
+   case MGC_HOST_TEXTURE_REPEAT_VERSION:
+   case MGC_HOST_TEXTURE_LINEAR_REPEAT_VERSION:
+      return MGC_HOST_WRAP_REPEAT;
+   case MGC_HOST_TEXTURE_MIRRORED_REPEAT_VERSION:
+   case MGC_HOST_TEXTURE_LINEAR_MIRRORED_REPEAT_VERSION:
+      return MGC_HOST_WRAP_MIRRORED_REPEAT;
+   case MGC_HOST_TEXTURE_MIXED_VERSION:
+   case MGC_HOST_TEXTURE_LINEAR_MIXED_VERSION:
+   case MGC_HOST_TEXTURE_MIPMAP_VERSION:
+   case MGC_HOST_TEXTURE_LINEAR_MIPMAP_VERSION:
+   case MGC_HOST_TEXTURE_DYNAMIC_VERSION:
+   case MGC_HOST_TEXTURE_DYNAMIC_LINEAR_VERSION:
+   case MGC_HOST_TEXTURE_TRILINEAR_VERSION:
+   case MGC_HOST_TEXTURE_ANISOTROPIC_VERSION:
+      return axis ? options->host_texture_wrap_t : options->host_texture_wrap_s;
+   default:
+      return (enum mgc_host_texture_wrap)-1;
+   }
+}
+
+const char *
+mgc_host_texture_wrap_name(enum mgc_host_texture_wrap wrap)
+{
+   switch (wrap) {
+   case MGC_HOST_WRAP_CLAMP_TO_EDGE:
+      return "clamp-to-edge";
+   case MGC_HOST_WRAP_REPEAT:
+      return "repeat";
+   case MGC_HOST_WRAP_MIRRORED_REPEAT:
+      return "mirrored-repeat";
+   default:
+      return NULL;
+   }
+}
+
+static void
+mgc_validate_options(struct mgc_ctx *ctx)
+{
+   if (ctx->options.target != MGC_TARGET_LEGACY &&
+       ctx->options.target != MGC_TARGET_FP16_HARDWARE_V1 &&
+       ctx->options.target != MGC_TARGET_FP16_HARDWARE_VECTOR &&
+       ctx->options.target != MGC_TARGET_C_INTERPRETER_V1) {
+      mgc_error(ctx, "mgc: unsupported compiler target");
+      return;
+   }
+   bool current_c = ctx->options.target == MGC_TARGET_C_INTERPRETER_V1;
+   if (current_c && (ctx->options.host_features_version || ctx->options.host_texture_version ||
+                     ctx->options.host_instancing_version || ctx->options.fragment_status_version)) {
+      mgc_error(ctx, "mgc: current C target does not implement host texture, instancing, derivative or discard-status ABIs");
+      return;
+   }
+   bool hardware = ctx->options.target == MGC_TARGET_FP16_HARDWARE_V1 ||
+                   ctx->options.target == MGC_TARGET_FP16_HARDWARE_VECTOR || current_c;
+   if (ctx->options.host_features_version &&
+       (hardware || ctx->options.host_features_version != MGC_HOST_FEATURES_VERSION)) {
+      mgc_error(ctx, "mgc: host features version 1 requires the legacy software target");
+      return;
+   }
+   if (ctx->options.host_features_version && ctx->options.host_texture_version &&
+       !mgc_host_texture_is_dynamic(ctx->options.host_texture_version)) {
+      mgc_error(ctx, "mgc: ABI4 host textures require versions 11..14; older texture storage belongs to ABI1/3");
+      return;
+   }
+   if (ctx->options.host_instancing_version &&
+       (hardware || ctx->options.host_instancing_version != MGC_HOST_INSTANCING_VERSION)) {
+      mgc_error(ctx, "mgc: host instancing version is unsupported for this target");
+      return;
+   }
+   if (ctx->options.host_texture_version &&
+       (hardware || (ctx->options.host_texture_version != MGC_HOST_TEXTURE_VERSION &&
+                     ctx->options.host_texture_version != MGC_HOST_TEXTURE_LINEAR_VERSION &&
+                     ctx->options.host_texture_version != MGC_HOST_TEXTURE_REPEAT_VERSION &&
+                     ctx->options.host_texture_version != MGC_HOST_TEXTURE_LINEAR_REPEAT_VERSION &&
+                     ctx->options.host_texture_version != MGC_HOST_TEXTURE_MIRRORED_REPEAT_VERSION &&
+                     ctx->options.host_texture_version != MGC_HOST_TEXTURE_LINEAR_MIRRORED_REPEAT_VERSION &&
+                     ctx->options.host_texture_version != MGC_HOST_TEXTURE_MIXED_VERSION &&
+                     ctx->options.host_texture_version != MGC_HOST_TEXTURE_LINEAR_MIXED_VERSION &&
+                     ctx->options.host_texture_version != MGC_HOST_TEXTURE_MIPMAP_VERSION &&
+                     ctx->options.host_texture_version != MGC_HOST_TEXTURE_LINEAR_MIPMAP_VERSION &&
+                     !(ctx->options.host_features_version && mgc_host_texture_is_dynamic(ctx->options.host_texture_version))))) {
+      mgc_error(ctx, "mgc: host texture version is unsupported for this target");
+      return;
+   }
+   bool mixed = ctx->options.host_texture_version == MGC_HOST_TEXTURE_MIXED_VERSION ||
+      ctx->options.host_texture_version == MGC_HOST_TEXTURE_LINEAR_MIXED_VERSION ||
+      mgc_host_texture_is_mipmap(ctx->options.host_texture_version) ||
+      mgc_host_texture_is_dynamic(ctx->options.host_texture_version);
+   if (!mixed && (ctx->options.host_texture_wrap_s != MGC_HOST_WRAP_CLAMP_TO_EDGE ||
+                  ctx->options.host_texture_wrap_t != MGC_HOST_WRAP_CLAMP_TO_EDGE)) {
+      mgc_error(ctx, "mgc: host texture wrap axes require mixed version 7 or 8, or mipmap version 9 or 10");
+      return;
+   }
+   if (mixed) {
+      for (unsigned axis = 0; axis < 2; axis++) {
+         if (!mgc_host_texture_wrap_name(mgc_host_texture_wrap_for_axis(&ctx->options, axis))) {
+            mgc_error(ctx, "mgc: host texture wrap_%s is unsupported", axis ? "t" : "s");
+            return;
+         }
+      }
+   }
+   if (ctx->options.fragment_status_version &&
+       (hardware || ctx->options.fragment_status_version != MGC_FRAGMENT_STATUS_VERSION)) {
+      mgc_error(ctx, "mgc: fragment completion status version is unsupported for this target");
+      return;
+   }
+   if (hardware && ctx->options.schedule) {
+      mgc_error(ctx, "mgc: hardware target has no verified scheduling policy");
+      return;
+   }
+   uint64_t region_size = (uint64_t)MGC_ABI_REGION_WORDS * (hardware ? 4 : 1);
+   uint32_t bases[] = { ctx->options.input_base, ctx->options.uniform_base,
+                        ctx->options.vertex_output_base, ctx->options.fragment_output_base,
+                        ctx->options.texture_base };
+   for (unsigned region = 0; region < (ctx->options.host_features_version ? 5 : 4); region++) {
+      if (hardware && bases[region] % 4) {
+         mgc_error(ctx, "mgc: hardware host ABI bases must be aligned byte addresses");
+         return;
+      }
+      uint64_t end = (uint64_t)bases[region] + region_size;
+      if (end > (uint64_t)UINT32_MAX + 1) {
+         mgc_error(ctx, "mgc: ABI region exceeds 32-bit address space");
+         return;
+      }
+      for (unsigned previous = 0; previous < region; previous++) {
+         if ((uint64_t)bases[region] < (uint64_t)bases[previous] + region_size &&
+             (uint64_t)bases[previous] < end) {
+            mgc_error(ctx, "mgc: ABI memory regions overlap");
+            return;
+         }
+      }
+   }
+}
+
+static void
+mgc_validate_host_instancing(struct mgc_ctx *ctx, nir_shader *nir)
+{
+   if (ctx->options.host_features_version)
+      return;
+   bool host_instancing = ctx->options.host_instancing_version == MGC_HOST_INSTANCING_VERSION;
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic == nir_intrinsic_load_instance_id) {
+            if (!host_instancing || ctx->options.target != MGC_TARGET_LEGACY ||
+                nir->info.stage != MESA_SHADER_VERTEX ||
+                intr->def.num_components != 1 || intr->def.bit_size != 32) {
+               mgc_error(ctx, "mgc: load_instance_id requires scalar raw32 host instancing version 1 in a legacy vertex shader");
+               return;
+            }
+         } else if (host_instancing &&
+                    (intr->intrinsic == nir_intrinsic_load_input ||
+                     intr->intrinsic == nir_intrinsic_load_interpolated_input)) {
+            unsigned offset_source = intr->intrinsic == nir_intrinsic_load_input ? 0 : 1;
+            uint32_t offset;
+            if (!mgc_constant_offset(ctx, intr->src[offset_source], &offset))
+               return;
+            uint64_t word_offset = ((uint64_t)nir_intrinsic_base(intr) + offset) * 4 +
+               nir_intrinsic_component(intr);
+            if (word_offset <= MGC_HOST_INSTANCE_ID_WORD &&
+                word_offset + intr->num_components > MGC_HOST_INSTANCE_ID_WORD) {
+               mgc_error(ctx, "mgc: ordinary input aliases the reserved host instance ID word");
+               return;
+            }
+         } else if (host_instancing &&
+                    (intr->intrinsic == nir_intrinsic_load_base_instance ||
+                     intr->intrinsic == nir_intrinsic_load_vertex_id ||
+                     intr->intrinsic == nir_intrinsic_load_vertex_id_zero_base ||
+                     intr->intrinsic == nir_intrinsic_load_first_vertex ||
+                     intr->intrinsic == nir_intrinsic_load_base_vertex ||
