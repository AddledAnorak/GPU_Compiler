+static void
+mgc_layout_add_edge(struct mgc_layout *layout, unsigned source, unsigned destination)
+{
+   if (layout->num_edges == MGC_LAYOUT_MAX_EDGES) {
+      layout->errors |= MGC_LAYOUT_LIMIT;
+      return;
+   }
+   unsigned edge = layout->num_edges++;
+   layout->edges[edge] = (struct mgc_layout_edge){destination, layout->heads[source]};
+   layout->heads[source] = edge;
+}
+
+static void
+mgc_layout_connect(struct mgc_layout *layout, nir_src source, nir_def *destination)
+{
+   mgc_layout_add_edge(layout, destination->index, source.ssa->index);
+   if (!nir_src_is_const(source) && !nir_src_is_undef(source))
+      mgc_layout_add_edge(layout, source.ssa->index, destination->index);
+}
+
+static bool
+mgc_layout_gather_types(struct mgc_layout *layout, nir_function_impl *impl)
+{
+   if (impl->ssa_alloc > MGC_ABI_REGION_WORDS) {
+      layout->errors |= MGC_LAYOUT_LIMIT;
+      return false;
+   }
+   unsigned count = MAX2(impl->ssa_alloc, 1);
+   layout->types = rzalloc_array(layout->mem_ctx, unsigned, count);
+   layout->heads = ralloc_array(layout->mem_ctx, int, count);
+   layout->edges = ralloc_array(layout->mem_ctx, struct mgc_layout_edge, MGC_LAYOUT_MAX_EDGES);
+   unsigned *queue = ralloc_array(layout->mem_ctx, unsigned, count * 5);
+   if (!layout->types || !layout->heads || !layout->edges || !queue)
+      return false;
+   for (unsigned index = 0; index < count; index++)
+      layout->heads[index] = -1;
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type == nir_instr_type_alu) {
+            nir_alu_instr *alu = nir_instr_as_alu(instr);
+            const nir_op_info *info = &nir_op_infos[alu->op];
+            if (alu->op == nir_op_mov || alu->op == nir_op_bcsel || alu->op == nir_op_b32csel) {
+               unsigned first = alu->op == nir_op_mov ? 0 : 1;
+               if (first)
+                  layout->types[alu->src[0].src.ssa->index] |= 8;
+               for (unsigned source = first; source < info->num_inputs; source++)
+                  mgc_layout_connect(layout, alu->src[source].src, &alu->def);
+            } else {
+               layout->types[alu->def.index] |= mgc_layout_type_mask(info->output_type);
+               for (unsigned source = 0; source < info->num_inputs; source++)
+                  layout->types[alu->src[source].src.ssa->index] |= mgc_layout_type_mask(info->input_types[source]);
+            }
+         } else if (instr->type == nir_instr_type_phi) {
+            nir_phi_instr *phi = nir_instr_as_phi(instr);
+            nir_foreach_phi_src(source, phi)
+               mgc_layout_connect(layout, source->src, &phi->def);
+         } else if (instr->type == nir_instr_type_intrinsic) {
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (nir_intrinsic_infos[intr->intrinsic].has_dest)
+               layout->types[intr->def.index] |= mgc_layout_type_mask(nir_intrinsic_instr_dest_type(intr));
+            for (unsigned source = 0; source < nir_intrinsic_infos[intr->intrinsic].num_srcs; source++)
+               layout->types[intr->src[source].ssa->index] |=
+                  mgc_layout_type_mask(nir_intrinsic_instr_src_type(intr, source));
+         }
+      }
+   }
+   if (layout->errors & MGC_LAYOUT_LIMIT)
+      return false;
+   unsigned tail = 0;
+   for (unsigned index = 0; index < count; index++) {
+      if (layout->types[index])
+         queue[tail++] = index;
+   }
+   for (unsigned head = 0; head < tail; head++) {
+      unsigned source = queue[head];
+      for (int edge = layout->heads[source]; edge >= 0; edge = layout->edges[edge].next) {
+         unsigned destination = layout->edges[edge].destination;
+         unsigned types = layout->types[destination] | layout->types[source];
+         if (types != layout->types[destination]) {
+            layout->types[destination] = types;
+            queue[tail++] = destination;
+         }
+      }
+   }
+   return true;
+}
+
+static void
+mgc_layout_record(struct mgc_layout *layout, nir_intrinsic_instr *intr,
+                  gl_shader_stage stage, const struct mgc_layout_hints *hints,
+                  bool host_instancing, bool host_features)
+{
+   unsigned domain;
+   uint32_t offset, block = 0;
+   uint64_t word_offset;
+   bool output = intr->intrinsic == nir_intrinsic_store_output;
+   if (output && !nir_intrinsic_write_mask(intr))
+      return;
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_input:
+   case nir_intrinsic_store_output:
+      domain = output ? 1 : 0;
+      if (!mgc_layout_offset(intr->src[output ? 1 : 0], &offset))
+         goto invalid_address;
+      word_offset = ((uint64_t)nir_intrinsic_base(intr) + offset) * 4 + nir_intrinsic_component(intr);
+      break;
+   case nir_intrinsic_load_uniform:
+      domain = 2;
+      if (!mgc_layout_offset(intr->src[0], &offset))
+         goto invalid_address;
+      word_offset = (uint64_t)nir_intrinsic_base(intr) + offset;
+      break;
+   case nir_intrinsic_load_ubo_vec4:
+   case nir_intrinsic_load_ubo:
+      domain = 2;
+      if (!mgc_layout_offset(intr->src[0], &block) ||
+          !mgc_layout_offset(intr->src[1], &offset))
+         goto invalid_address;
+      if (intr->intrinsic == nir_intrinsic_load_ubo) {
+         if (offset % 4 || intr->def.bit_size != 32)
+            goto invalid_address;
+         word_offset = offset / 4;
+      } else {
+         word_offset = ((uint64_t)nir_intrinsic_base(intr) + offset) * 4 + nir_intrinsic_component(intr);
+      }
+      if (word_offset >= MGC_UBO_STRIDE_WORDS ||
+          block >= MGC_ABI_REGION_WORDS / MGC_UBO_STRIDE_WORDS)
+         goto invalid_address;
+      word_offset += (uint64_t)block * MGC_UBO_STRIDE_WORDS;
+      break;
+   case nir_intrinsic_demote:
+   case nir_intrinsic_demote_if:
+   case nir_intrinsic_terminate:
+   case nir_intrinsic_terminate_if:
+      layout->uses_discard = true;
+      return;
+   case nir_intrinsic_ddx:
+   case nir_intrinsic_ddy:
+   case nir_intrinsic_ddx_fine:
+   case nir_intrinsic_ddy_fine:
+      if (!host_features)
+         layout->errors |= MGC_LAYOUT_INTRINSIC;
+      return;
+   default:
+      layout->errors |= MGC_LAYOUT_INTRINSIC;
+      return;
+   }
+   if (word_offset >= MGC_ABI_REGION_WORDS || intr->num_components != 1)
+      goto invalid_address;
+   if (host_instancing && domain == 0 && word_offset == MGC_HOST_INSTANCE_ID_WORD)
+      goto invalid_address;
+   if (host_features && ((domain == 0 && (word_offset >= MGC_HOST_FEATURES_INPUT_RESERVED ||
+                                         word_offset == MGC_HOST_DERIVATIVE_RESPONSE_WORD)) ||
+                         (domain == 1 && word_offset >= MGC_HOST_FEATURES_OUTPUT_RESERVED)))
+      goto invalid_address;
+   struct mgc_layout_entry entry = {
+      .present = true,
+      .location = -1,
+      .bit_size = output ? intr->src[0].ssa->bit_size : intr->def.bit_size,
+      .types = layout->types[output ? intr->src[0].ssa->index : intr->def.index],
+   };
+   nir_alu_type declared_type = output ? nir_intrinsic_instr_src_type(intr, 0) :
+                                        nir_intrinsic_instr_dest_type(intr);
+   if (declared_type != nir_type_invalid)
+      entry.types = mgc_layout_type_mask(declared_type);
+   if (domain != 2) {
+      nir_io_semantics semantics = nir_intrinsic_io_semantics(intr);
+      uint64_t location = (uint64_t)semantics.location + offset;
+      unsigned limit = stage == MESA_SHADER_VERTEX && !output ? VERT_ATTRIB_MAX :
+                       stage == MESA_SHADER_FRAGMENT && output ? FRAG_RESULT_MAX : NUM_TOTAL_VARYING_SLOTS;
+      entry.component = nir_intrinsic_component(intr);
+      if (!semantics.num_slots || offset >= semantics.num_slots || location >= limit ||
+          entry.component >= 4 || semantics.high_16bits || semantics.high_dvec2 ||
+          semantics.dual_source_blend_index || semantics.per_view) {
+         layout->errors |= MGC_LAYOUT_SEMANTIC;
+      } else {
+         entry.location = location;
+         unsigned semantic_component = location * 4 + entry.component;
+         int *previous_offset = &layout->semantic_offsets[domain][semantic_component];
+         if (*previous_offset >= 0 && (unsigned)*previous_offset != word_offset) {
+            layout->entries[domain][*previous_offset].location = -1;
+            entry.location = -1;
+            layout->errors |= MGC_LAYOUT_SEMANTIC | MGC_LAYOUT_CONFLICT;
+         } else {
+            *previous_offset = word_offset;
+         }
+         bool generic = location >= VARYING_SLOT_VAR0 && location < VARYING_SLOT_MAX;
+         if ((stage == MESA_SHADER_FRAGMENT && !output && !generic) ||
+             (stage == MESA_SHADER_VERTEX && output && !generic && location != VARYING_SLOT_POS) ||
+             (stage == MESA_SHADER_FRAGMENT && output && location != FRAG_RESULT_COLOR &&
+              location < FRAG_RESULT_DATA0))
+            layout->errors |= MGC_LAYOUT_BUILTIN;
+         entry.interpolation = hints->interpolation[domain][location * 4 + entry.component];
+         if (entry.interpolation != 1 && entry.interpolation != 2 && entry.interpolation != 4)
+            layout->errors |= MGC_LAYOUT_INTERPOLATION;
+      }
+   }
+   struct mgc_layout_entry *previous = &layout->entries[domain][word_offset];
+   if (previous->present) {
+      if (previous->location != entry.location || previous->component != entry.component) {
+         previous->location = -1;
+         layout->errors |= MGC_LAYOUT_SEMANTIC | MGC_LAYOUT_CONFLICT;
+      }
+      if (previous->bit_size != entry.bit_size) {
+         previous->bit_size = 0;
+         layout->errors |= MGC_LAYOUT_TYPE | MGC_LAYOUT_CONFLICT;
+      }
+      previous->types |= entry.types;
+      previous->interpolation |= entry.interpolation;
+   } else {
+      if (layout->count == MGC_ABI_REGION_WORDS) {
+         layout->errors |= MGC_LAYOUT_LIMIT;
+         return;
+      }
+      *previous = entry;
+      layout->count++;
+   }
+   return;
+
+invalid_address:
+   layout->errors |= MGC_LAYOUT_ADDRESS;
+}
+
+static void
+mgc_layout_append(struct mgc_layout *layout, const char *format, ...)
+{
+   if (layout->allocation_failed)
+      return;
+   va_list arguments;
+   va_start(arguments, format);
+   layout->allocation_failed = !ralloc_vasprintf_rewrite_tail(&layout->json, &layout->length,
+                                                             format, arguments);
+   va_end(arguments);
+}
