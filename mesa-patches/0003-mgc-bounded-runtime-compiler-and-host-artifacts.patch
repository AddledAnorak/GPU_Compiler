+static bool
+mgc_json_metadata(struct mgc_layout_reader *reader, const char *key,
+                  const char *key_end, const char *value, const char *value_end)
+{
+   unsigned bit = 0;
+   bool matches = true;
+   if (mgc_json_text_equal(key, key_end, "\"program_format\"")) {
+      bit = 1;
+      matches = value_end - value >= 2 && value[0] == '"' &&
+         value_end[-1] == '"' &&
+         mgc_json_text_equal(value + 1, value_end - 1, reader->program_format);
+   } else if (mgc_json_text_equal(key, key_end, "\"shader_abi_version\"") ||
+              mgc_json_text_equal(key, key_end, "\"abi_version\"")) {
+      bit = 2;
+      matches = value_end - value == 1 && *value == '0' + reader->abi_version;
+   } else if (mgc_json_text_equal(key, key_end, "\"stage\"")) {
+      bit = 4;
+      matches = mgc_json_text_equal(value, value_end,
+                                   reader->stage ? "\"fragment\"" : "\"vertex\"") ||
+         mgc_json_text_equal(value, value_end, reader->stage ? "\"fs\"" : "\"vs\"");
+   } else if (mgc_json_text_equal(key, key_end, "\"supported\"")) {
+      bit = 8;
+      matches = mgc_json_text_equal(value, value_end, "true");
+   } else if (mgc_json_text_equal(key, key_end, "\"version\"")) {
+      bit = 16;
+      matches = mgc_json_text_equal(value, value_end, "1") ||
+         mgc_json_text_equal(value, value_end, "2") ||
+         mgc_json_text_equal(value, value_end, "3") ||
+         mgc_json_text_equal(value, value_end, "4");
+      if (matches)
+         reader->layout_version = *value - '0';
+   } else if (mgc_json_text_equal(key, key_end, "\"address_units\"")) {
+      bit = 32;
+      matches = mgc_json_text_equal(value, value_end,
+                                    reader->abi_version == MGC_HARDWARE_ABI_VERSION ? "\"bytes\"" : "\"words\"");
+   } else if (mgc_json_text_equal(key, key_end, "\"inputs\"")) {
+      bit = 64;
+      matches = reader->abi->host_features_version ? mgc_json_features_io(value, value_end, 0) :
+         value < value_end && *value == '[';
+   } else if (mgc_json_text_equal(key, key_end, "\"outputs\"")) {
+      bit = 128;
+      matches = reader->abi->host_features_version ? mgc_json_features_io(value, value_end, 1) :
+         value < value_end && *value == '[';
+   } else if (mgc_json_text_equal(key, key_end, "\"uniforms\"")) {
+      bit = 256;
+      matches = reader->abi->host_features_version ? mgc_json_features_io(value, value_end, 2) :
+         value < value_end && *value == '[';
+   } else if (mgc_json_text_equal(key, key_end, "\"errors\"")) {
+      bit = 512;
+      matches = value < value_end && *value++ == '[';
+      while (value < value_end && strchr(" \t\r\n", *value))
+         value++;
+      matches = matches && value_end - value == 1 && *value == ']';
+   } else if (mgc_json_text_equal(key, key_end, "\"bases\"")) {
+      bit = 1024;
+      matches = reader->base_metadata == (reader->abi->host_features_version ? 31u : 15u);
+   } else if (mgc_json_text_equal(key, key_end, "\"host_texture\"")) {
+      bit = 2048;
+      unsigned version = reader->abi->host_texture_version;
+      unsigned expected = (version == MGC_HOST_TEXTURE_MIPMAP_VERSION ||
+                           version == MGC_HOST_TEXTURE_LINEAR_MIPMAP_VERSION) ? 4095 :
+         (version == MGC_HOST_TEXTURE_MIXED_VERSION ||
+          version == MGC_HOST_TEXTURE_LINEAR_MIXED_VERSION) ? 511 : 255;
+      matches = reader->abi->host_features_version ?
+         mgc_json_features_metadata(reader, value, value_end, true) :
+         value < value_end && *value == '{' && reader->texture_metadata == expected;
+   } else if (mgc_json_text_equal(key, key_end, "\"fragment_status\"")) {
+      bit = 4096;
+      matches = value < value_end && *value == '{' && reader->status_metadata == 31;
+   } else if (mgc_json_text_equal(key, key_end, "\"host_instancing\"")) {
+      bit = 8192;
+      matches = reader->abi->host_instancing_version == MGC_HOST_INSTANCING_VERSION &&
+         value < value_end && *value == '{' && reader->instancing_metadata == 31;
+   } else if (mgc_json_text_equal(key, key_end, "\"uses_discard\"")) {
+      if (reader->abi->host_features_version)
+         bit = 32768;
+      matches = mgc_json_text_equal(value, value_end, "true") ||
+         mgc_json_text_equal(value, value_end, "false");
+      reader->uses_discard |= mgc_json_text_equal(value, value_end, "true");
+   } else if (mgc_json_text_equal(key, key_end, "\"host_features\"")) {
+      bit = 16384;
+      matches = reader->abi->host_features_version == MGC_HOST_FEATURES_VERSION &&
+         mgc_json_features_metadata(reader, value, value_end, false);
+   } else if (reader->abi->host_features_version) {
+      return false;
+   }
+   if (!matches || (reader->metadata & bit))
+      return false;
+   reader->metadata |= bit;
+   return true;
+}
