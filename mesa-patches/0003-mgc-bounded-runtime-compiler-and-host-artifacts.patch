+          shader->abi_version != (features ? MGC_HOST_FEATURES_ABI_VERSION :
+                                  ctx->host_instancing_version ? MGC_HOST_INSTANCING_ABI_VERSION :
+                                  hardware ? MGC_HARDWARE_ABI_VERSION : MGC_ABI_VERSION) ||
+          shader->abi.host_instancing_version != ctx->host_instancing_version ||
+          shader->abi.host_features_version != ctx->host_features_version ||
