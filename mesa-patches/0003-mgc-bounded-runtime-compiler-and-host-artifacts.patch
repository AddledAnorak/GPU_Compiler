+      mgc_capture_printf(&json, "%s\"%s\":{\"assembly\":", stage ? "," : "", stage ? "fs" : "vs");
+      mgc_capture_string(&json, artifact->assembly[stage], assembly_sizes[stage]);
+      mgc_capture_printf(&json, ",\"layout\":");
+      mgc_capture_append(&json, artifact->layout[stage], layout_sizes[stage]);
