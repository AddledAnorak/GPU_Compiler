+static unsigned
+mgc_layout_interp_mode(unsigned mode)
+{
+   switch (mode) {
+   case INTERP_MODE_SMOOTH: return 1;
+   case INTERP_MODE_FLAT: return 2;
+   case INTERP_MODE_NOPERSPECTIVE: return 4;
+   default: return 8;
+   }
+}
+
+static void
+mgc_layout_capture_hints(nir_shader *nir, struct mgc_layout_hints *hints)
+{
+   nir_foreach_variable_with_modes(var, nir, nir_var_shader_in | nir_var_shader_out) {
+      if (var->data.location < 0 || var->data.location >= 128)
+         continue;
+      unsigned mode = var->data.interpolation;
+      bool varying = (nir->info.stage == MESA_SHADER_VERTEX && var->data.mode == nir_var_shader_out) ||
+                     (nir->info.stage == MESA_SHADER_FRAGMENT && var->data.mode == nir_var_shader_in);
+      if (mode == INTERP_MODE_NONE && (!varying ||
+          (var->data.location != VARYING_SLOT_COL0 && var->data.location != VARYING_SLOT_COL1 &&
+           var->data.location != VARYING_SLOT_BFC0 && var->data.location != VARYING_SLOT_BFC1)))
+         mode = INTERP_MODE_SMOOTH;
+      unsigned slots = glsl_count_attribute_slots(var->type, false);
+      unsigned domain = var->data.mode == nir_var_shader_out;
+      for (unsigned slot = 0; slot < MIN2(slots, 128 - var->data.location); slot++) {
+         unsigned first = slot == 0 ? var->data.location_frac : 0;
+         unsigned end = glsl_type_is_vector_or_scalar(var->type) ?
+                        MIN2(first + glsl_get_vector_elements(var->type), 4) : 4;
+         for (unsigned component = first; component < end; component++)
+            hints->interpolation[domain][(var->data.location + slot) * 4 + component] |=
+               mgc_layout_interp_mode(mode);
+      }
+   }
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic != nir_intrinsic_load_interpolated_input)
+               continue;
+            nir_io_semantics semantics = nir_intrinsic_io_semantics(intr);
+            uint32_t offset;
+            if (!semantics.num_slots || !mgc_layout_offset(intr->src[1], &offset))
+               continue;
+            unsigned mode = 8;
+            nir_instr *parent = intr->src[0].ssa->parent_instr;
+            if (parent->type == nir_instr_type_intrinsic &&
+                nir_intrinsic_has_interp_mode(nir_instr_as_intrinsic(parent)))
+               mode = mgc_layout_interp_mode(nir_intrinsic_interp_mode(nir_instr_as_intrinsic(parent)));
+            for (unsigned component = 0; component < MIN2(intr->num_components, 16); component++) {
+               uint64_t index = ((uint64_t)semantics.location + offset) * 4 +
+                                nir_intrinsic_component(intr) + component;
+               if (index < MGC_LAYOUT_SEMANTIC_COMPONENTS)
+                  hints->interpolation[0][index] |= mode;
+            }
+         }
+      }
+   }
+}
