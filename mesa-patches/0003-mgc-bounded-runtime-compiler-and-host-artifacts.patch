+static bool
+mgc_json_texture_metadata(struct mgc_layout_reader *reader, const char *key,
+                           const char *key_end, const char *value, const char *value_end)
+{
+   unsigned version = reader->abi->host_texture_version;
+   bool mipmap = version == MGC_HOST_TEXTURE_MIPMAP_VERSION ||
+      version == MGC_HOST_TEXTURE_LINEAR_MIPMAP_VERSION;
+   bool mixed = mipmap || version == MGC_HOST_TEXTURE_MIXED_VERSION ||
+      version == MGC_HOST_TEXTURE_LINEAR_MIXED_VERSION;
