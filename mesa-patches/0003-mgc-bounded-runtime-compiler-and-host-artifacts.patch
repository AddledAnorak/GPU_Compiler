+static bool
+mgc_capture_publish(struct mgc_context *ctx, const struct mgc_draw_artifact *artifact,
+                     const struct mgc_capture_json *json)
+{
+   static atomic_uint_fast64_t next_temporary;
+   char temporary[128];
+   char filename[128];
+   int length = snprintf(filename, sizeof(filename), "draw-%" PRIu64 "-%u.json",
+                         artifact->sequence, artifact->drawid);
+   if (length < 0 || (size_t)length >= sizeof(filename))
+      return false;
+   int descriptor = -1;
+   for (unsigned attempt = 0; attempt < 32; attempt++) {
+      uint64_t nonce = atomic_fetch_add_explicit(&next_temporary, 1, memory_order_relaxed);
+      length = snprintf(temporary, sizeof(temporary), ".mgc-draw-%ld-%" PRIu64 ".tmp",
+                         (long)getpid(), nonce);
+      if (length < 0 || (size_t)length >= sizeof(temporary))
+         return false;
+      descriptor = openat(ctx->capture_dir_fd, temporary,
+                           O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+      if (descriptor >= 0 || errno != EEXIST)
+         break;
+   }
+   if (descriptor < 0)
+      return false;
+   struct stat storage;
+   bool success = !fstat(descriptor, &storage) && S_ISREG(storage.st_mode);
+   size_t offset = 0;
+   while (success && offset < json->size) {
+      ssize_t written = write(descriptor, json->data + offset, json->size - offset);
+      if (written < 0 && errno == EINTR)
+         continue;
+      if (written <= 0)
+         success = false;
+      else
+         offset += written;
+   }
+   if (success && fsync(descriptor))
+      success = false;
+   if (close(descriptor))
+      success = false;
+   if (success && linkat(ctx->capture_dir_fd, temporary,
+                        ctx->capture_dir_fd, filename, 0))
+      success = false;
+   unlinkat(ctx->capture_dir_fd, temporary, 0);
+   return success;
+}
+
+static bool
+mgc_draw_instancing_valid(const struct mgc_context *ctx,
+                           const struct pipe_draw_info *info)
+{
+   bool features = ctx && ctx->host_features_version == MGC_HOST_FEATURES_VERSION;
+   if (ctx->host_features_version && !features)
+      return false;
+   if (features || ctx->host_instancing_version == MGC_HOST_INSTANCING_VERSION) {
+      if (!info->instance_count || info->instance_count >
+          (features ? MGC_HOST_FEATURES_MAX_INSTANCES : MGC_HOST_INSTANCING_MAX_INSTANCES) ||
+          (!features && info->start_instance > MGC_HOST_INSTANCING_MAX_INDEX) ||
+          info->mode != MESA_PRIM_TRIANGLES || info->primitive_restart)
+         return false;
