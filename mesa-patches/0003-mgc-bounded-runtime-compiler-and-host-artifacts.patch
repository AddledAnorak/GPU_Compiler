+static void
+mgc_emit_derivative(struct mgc_ctx *ctx, nir_intrinsic_instr *intr)
+{
+   if (!ctx->options.host_features_version || ctx->stage != MESA_SHADER_FRAGMENT ||
+       intr->num_components != 1 || intr->def.bit_size != 32) {
+      mgc_error(ctx, "mgc: fine quad derivatives require scalar FP32 ABI4 legacy fragment shaders");
+      return;
+   }
+   struct mgc_val operand = mgc_float_val(ctx, intr->src[0].ssa);
+   char source[8];
+   mgc_val_str(operand, source);
+   int address = mgc_alloc_reg(ctx);
+   int operation = mgc_alloc_reg(ctx);
+   int destination = mgc_alloc_destination(ctx, &intr->def);
+   unsigned op = intr->intrinsic == nir_intrinsic_ddx || intr->intrinsic == nir_intrinsic_ddx_fine ? 1 : 2;
+   ralloc_asprintf_append(&ctx->asm_text,
+      "movi_i32 %u, r%d\nstore %s, r%d\nwait_short\n"
+      "movi_i32 %u, r%d\nmovi_i32 %u, r%d\nstore r%d, r%d\nwait_short\n"
+      "movi_i32 %u, r%d\nload r%d, r%d\nwait_load\n",
+      ctx->options.fragment_output_base + MGC_HOST_DERIVATIVE_OPERAND_WORD, address, source, address,
+      op, operation, ctx->options.fragment_output_base + MGC_HOST_DERIVATIVE_REQUEST_WORD,
+      address, operation, address,
+      ctx->options.input_base + MGC_HOST_DERIVATIVE_RESPONSE_WORD, address, address, destination);
+   mgc_free_reg(ctx, operation);
+   mgc_free_reg(ctx, address);
+   ctx->uses_derivatives = true;
+   ctx->vals[intr->def.index] = (struct mgc_val){.kind = MGC_VAL_REG, .index = destination};
+}
