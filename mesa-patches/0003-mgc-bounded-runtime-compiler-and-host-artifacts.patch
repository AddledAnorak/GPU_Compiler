+
+static bool
+mgc_executor_error(struct mgc_context *ctx, const char *message)
+{
+   mgc_context_error(&ctx->base, PIPE_ERROR_BAD_INPUT, message);
+   fprintf(stderr, "MGC_HOST_EXECUTOR_FAILURE message=%s\n", message);
+   return false;
+}
+
+void
+mgc_host_executor_init(struct mgc_context *ctx)
+{
+   const char *path = getenv("MGC_HOST_EXECUTOR_SOCKET");
+   ctx->host_executor_enabled = path != NULL;
+   if (!path)
+      return;
+   size_t length = strnlen(path, MGC_HOST_EXECUTOR_SOCKET_BYTES);
+   if (!length || path[0] != '/' || length >= MGC_HOST_EXECUTOR_SOCKET_BYTES)
+      return;
+   memcpy(ctx->host_executor_socket, path, length + 1);
+   ctx->host_executor_valid = true;
+}
+
+static bool
+mgc_executor_resource_valid(struct mgc_context *ctx, struct pipe_resource *resource,
+                             const struct pipe_surface *surface, enum pipe_format format,
+                             unsigned blocksize, unsigned expected_executions)
+{
+   const struct pipe_framebuffer_state *framebuffer = &ctx->framebuffer;
+   unsigned required_bind = (format == PIPE_FORMAT_Z16_UNORM || format == PIPE_FORMAT_Z24_UNORM_S8_UINT) ?
+      PIPE_BIND_DEPTH_STENCIL : PIPE_BIND_RENDER_TARGET;
+   if (!resource || surface->texture != resource ||
+       surface->format != format || surface->nr_samples > 1 ||
+       surface->level || surface->first_layer || surface->last_layer ||
+       resource->screen != &ctx->screen->base || resource->target != PIPE_TEXTURE_2D ||
+       resource->format != format ||
+       !resource->width0 || resource->width0 > MGC_HOST_EXECUTOR_MAX_SIZE ||
+       !resource->height0 || resource->height0 > MGC_HOST_EXECUTOR_MAX_SIZE ||
+       framebuffer->width != resource->width0 || framebuffer->height != resource->height0 ||
+       resource->depth0 != 1 || resource->array_size != 1 || resource->last_level ||
+       resource->nr_samples > 1 || resource->nr_storage_samples > 1 || resource->next ||
+       !(resource->bind & required_bind) ||
+       (resource->bind & (PIPE_BIND_SHARED | PIPE_BIND_SCANOUT | PIPE_BIND_DISPLAY_TARGET)) ||
+       (resource->flags & (PIPE_RESOURCE_FLAG_MAP_PERSISTENT | PIPE_RESOURCE_FLAG_MAP_COHERENT |
+                           PIPE_RESOURCE_FLAG_SPARSE | PIPE_RESOURCE_FLAG_ENCRYPTED |
+                           PIPE_RESOURCE_FLAG_UNMAPPABLE | PIPE_RESOURCE_FLAG_FRONTEND_VM)) ||
+       resource->nr_sparse_levels || resource->compression_rate)
+      return false;
+   const struct mgc_resource *storage = mgc_resource(resource);
+   const struct mgc_resource_level *level = &storage->levels[0];
+   uint64_t row_bytes = (uint64_t)resource->width0 * blocksize;
+   uint64_t span = (uint64_t)(resource->height0 - 1) * level->stride + row_bytes;
+   if (!storage->data || storage->active_maps ||
+       storage->active_host_executions != expected_executions || level->width != resource->width0 ||
