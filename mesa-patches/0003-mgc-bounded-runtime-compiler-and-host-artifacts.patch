+static bool
+mgc_scalarize_uniform(nir_builder *builder, nir_instr *instr, void *data)
+{
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+   nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+   bool derivative = intr->intrinsic == nir_intrinsic_ddx || intr->intrinsic == nir_intrinsic_ddy ||
+      intr->intrinsic == nir_intrinsic_ddx_fine || intr->intrinsic == nir_intrinsic_ddy_fine;
+   if (intr->num_components <= 1 ||
+       (!derivative && intr->intrinsic != nir_intrinsic_load_uniform &&
+        intr->intrinsic != nir_intrinsic_load_ubo_vec4))
+      return false;
+   builder->cursor = nir_before_instr(instr);
+   nir_def *channels[NIR_MAX_VEC_COMPONENTS];
+   for (unsigned component = 0; component < intr->num_components; component++) {
+      nir_intrinsic_instr *scalar = nir_intrinsic_instr_create(builder->shader, intr->intrinsic);
+      scalar->num_components = 1;
+      nir_def_init(&scalar->instr, &scalar->def, 1, intr->def.bit_size);
+      nir_intrinsic_copy_const_indices(scalar, intr);
+      for (unsigned source = 0; source < nir_intrinsic_infos[intr->intrinsic].num_srcs; source++)
+         scalar->src[source] = nir_src_for_ssa(intr->src[source].ssa);
+      if (derivative) {
+         scalar->src[0] = nir_src_for_ssa(nir_channel(builder, intr->src[0].ssa, component));
+      } else if (intr->intrinsic == nir_intrinsic_load_ubo_vec4) {
+         unsigned channel = nir_intrinsic_component(intr) + component;
+         nir_intrinsic_set_component(scalar, channel % 4);
+         nir_intrinsic_set_base(scalar, nir_intrinsic_base(intr) + channel / 4);
+      } else {
+         nir_intrinsic_set_base(scalar, nir_intrinsic_base(intr) + component);
+      }
+      nir_builder_instr_insert(builder, &scalar->instr);
+      channels[component] = &scalar->def;
+   }
+   nir_def_replace(&intr->def, nir_vec(builder, channels, intr->num_components));
+   return true;
+}
