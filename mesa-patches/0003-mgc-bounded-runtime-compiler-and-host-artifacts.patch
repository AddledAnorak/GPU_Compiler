+static bool
+mgc_layout_offset(nir_src source, uint32_t *offset)
+{
+   if (!source.ssa || source.ssa->num_components != 1 ||
+       !nir_src_is_const(source) || nir_src_as_uint(source) > UINT32_MAX)
+      return false;
+   *offset = nir_src_as_uint(source);
+   return true;
+}
