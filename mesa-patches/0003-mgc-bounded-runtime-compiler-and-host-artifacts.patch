+
+static void
+mgc_executor_reserve_target(struct mgc_executor_target *target, struct pipe_resource *resource)
+{
+   mgc_resource(resource)->active_host_executions++;
+   pipe_resource_reference(&target->resource, resource);
+   target->level = mgc_resource(resource)->levels[0];
+   target->data = mgc_resource(resource)->data;
+   target->size = mgc_resource(resource)->size;
+   target->width = resource->width0;
+   target->height = resource->height0;
+}
+
+static bool
+mgc_executor_target_unchanged(const struct mgc_executor_target *target)
+{
+   if (!target->resource)
+      return true;
+   const struct mgc_resource *storage = mgc_resource(target->resource);
+   return target->resource->width0 == target->width && target->resource->height0 == target->height &&
+      storage->data == target->data && storage->size == target->size &&
+      !memcmp(&storage->levels[0], &target->level, sizeof(target->level));
+}
+
+static void
+mgc_executor_release_targets(struct mgc_executor_target *color, struct mgc_executor_target *depth)
+{
+   struct mgc_screen *screen = mgc_screen(color->resource->screen);
+   simple_mtx_lock(&screen->lock);
+   mgc_resource(color->resource)->active_host_executions--;
+   if (depth->resource)
+      mgc_resource(depth->resource)->active_host_executions--;
+   simple_mtx_unlock(&screen->lock);
+   pipe_resource_reference(&color->resource, NULL);
+   pipe_resource_reference(&depth->resource, NULL);
+}
+
+static bool
+mgc_executor_state_error(const char **reason, const char *message)
+{
+   if (reason)
+      *reason = message;
+   return false;
+}
