+static const char *
+mgc_capture_format(enum pipe_format format)
+{
+   switch (format) {
+   case PIPE_FORMAT_R32_FLOAT: return "R32_FLOAT";
+   case PIPE_FORMAT_R32G32_FLOAT: return "R32G32_FLOAT";
+   case PIPE_FORMAT_R32G32B32_FLOAT: return "R32G32B32_FLOAT";
+   case PIPE_FORMAT_R32G32B32A32_FLOAT: return "R32G32B32A32_FLOAT";
+   default: return NULL;
+   }
+}
+
+struct mgc_features_texture_level {
+   unsigned width;
+   unsigned height;
+   size_t size;
+   uint8_t data[MGC_HOST_FEATURES_TEXTURE_MAX_SIZE * MGC_HOST_FEATURES_TEXTURE_MAX_SIZE * 4];
+};
+
+struct mgc_features_texture {
+   unsigned binding;
+   unsigned texture_index;
+   unsigned sampler_index;
+   unsigned last_level;
+   const char *format;
+   const char *filter;
+   const char *mip_filter;
+   const char *wrap_s;
+   const char *wrap_t;
+   unsigned max_anisotropy;
+   struct mgc_features_texture_level levels[MGC_HOST_FEATURES_TEXTURE_MAX_LEVELS];
+};
+
+static const char *
+mgc_features_texture_format(enum pipe_format format)
+{
+   switch (format) {
+   case PIPE_FORMAT_R8G8B8A8_UNORM: return "R8G8B8A8_UNORM";
+   case PIPE_FORMAT_B8G8R8A8_UNORM: return "B8G8R8A8_UNORM";
+   case PIPE_FORMAT_R8G8B8_UNORM: return "R8G8B8_UNORM";
+   case PIPE_FORMAT_R8_UNORM: return "R8_UNORM";
+   default: return NULL;
+   }
+}
+
+static bool
+mgc_features_texture_swizzle(const struct pipe_sampler_view *view)
+{
+   if (view->swizzle_r == PIPE_SWIZZLE_X && view->swizzle_g == PIPE_SWIZZLE_Y &&
+       view->swizzle_b == PIPE_SWIZZLE_Z && view->swizzle_a == PIPE_SWIZZLE_W)
+      return true;
+   if (view->format == PIPE_FORMAT_R8_UNORM)
+      return view->swizzle_r == PIPE_SWIZZLE_X && view->swizzle_g == PIPE_SWIZZLE_0 &&
+         view->swizzle_b == PIPE_SWIZZLE_0 && view->swizzle_a == PIPE_SWIZZLE_1;
+   if (view->format == PIPE_FORMAT_R8G8B8_UNORM)
+      return view->swizzle_r == PIPE_SWIZZLE_X && view->swizzle_g == PIPE_SWIZZLE_Y &&
+         view->swizzle_b == PIPE_SWIZZLE_Z && view->swizzle_a == PIPE_SWIZZLE_1;
+   return false;
+}
+
+static bool
+mgc_features_texture_snapshot_locked(struct mgc_context *ctx, unsigned binding,
+                                      struct mgc_features_texture *texture)
+{
+   const struct mgc_compile_options *abi = &ctx->shaders[1]->shader->abi;
+   const struct mgc_host_texture_binding *pair = &ctx->shaders[1]->shader->host_texture_binding[binding];
+   if (pair->texture >= MGC_HOST_FEATURES_TEXTURE_MAX_BINDINGS ||
+       pair->sampler >= MGC_HOST_FEATURES_TEXTURE_MAX_BINDINGS)
+      return false;
+   const struct pipe_sampler_view *view = ctx->sampler_views[1][pair->texture];
+   const struct pipe_sampler_state *sampler = &ctx->sampler_states[1][pair->sampler];
+   unsigned version = abi->host_texture_version;
+   unsigned filter = version == MGC_HOST_TEXTURE_DYNAMIC_VERSION ?
+      PIPE_TEX_FILTER_NEAREST : PIPE_TEX_FILTER_LINEAR;
+   unsigned mip_filter = version >= MGC_HOST_TEXTURE_TRILINEAR_VERSION ?
+      PIPE_TEX_MIPFILTER_LINEAR : PIPE_TEX_MIPFILTER_NEAREST;
+   bool anisotropic = version == MGC_HOST_TEXTURE_ANISOTROPIC_VERSION;
+   if (!view || !view->texture || !ctx->sampler_state_valid[1][pair->sampler] ||
+       view->context != &ctx->base || view->target != PIPE_TEXTURE_2D ||
+       view->is_tex2d_from_buf || view->format != view->texture->format ||
+       view->u.tex.first_level || view->u.tex.last_level != view->texture->last_level ||
+       view->u.tex.first_layer || view->u.tex.last_layer ||
+       !mgc_features_texture_swizzle(view) ||
+       sampler->unnormalized_coords || sampler->min_img_filter != filter ||
+       sampler->mag_img_filter != filter || sampler->min_mip_filter != mip_filter ||
+       sampler->compare_mode != PIPE_TEX_COMPARE_NONE ||
+       (anisotropic ? sampler->max_anisotropy != MGC_HOST_FEATURES_TEXTURE_MAX_ANISOTROPY :
+                      sampler->max_anisotropy > 1) ||
+       sampler->seamless_cube_map || sampler->border_color_is_integer ||
+       sampler->reduction_mode != PIPE_TEX_REDUCTION_WEIGHTED_AVERAGE ||
+       !isfinite(sampler->lod_bias) || sampler->lod_bias != 0 ||
+       !isfinite(sampler->min_lod) || sampler->min_lod != 0 ||
+       !isfinite(sampler->max_lod))
+      return false;
+   texture->format = mgc_features_texture_format(view->format);
+   texture->wrap_s = mgc_capture_sampler_wrap_name(sampler->wrap_s);
+   texture->wrap_t = mgc_capture_sampler_wrap_name(sampler->wrap_t);
+   const char *wrap_s = mgc_host_texture_wrap_name(abi->host_texture_wrap_s);
+   const char *wrap_t = mgc_host_texture_wrap_name(abi->host_texture_wrap_t);
+   if (!texture->format || !texture->wrap_s || !texture->wrap_t || !wrap_s || !wrap_t ||
+       strcmp(texture->wrap_s, wrap_s) || strcmp(texture->wrap_t, wrap_t))
+      return false;
+   struct pipe_resource *resource = view->texture;
+   if (resource->screen != &ctx->screen->base || resource->target != PIPE_TEXTURE_2D ||
+       !resource->width0 || resource->width0 > MGC_HOST_FEATURES_TEXTURE_MAX_SIZE ||
+       !resource->height0 || resource->height0 > MGC_HOST_FEATURES_TEXTURE_MAX_SIZE ||
+       resource->depth0 != 1 || resource->array_size != 1 || resource->nr_samples > 1 ||
+       resource->nr_storage_samples > 1 || resource->next ||
+       MAX2(1, resource->nr_samples) != MAX2(1, resource->nr_storage_samples) ||
+       !(resource->bind & PIPE_BIND_SAMPLER_VIEW) ||
+       (resource->bind & (PIPE_BIND_SHARED | PIPE_BIND_SCANOUT | PIPE_BIND_DISPLAY_TARGET)) ||
+       (resource->flags & (PIPE_RESOURCE_FLAG_MAP_PERSISTENT | PIPE_RESOURCE_FLAG_MAP_COHERENT |
+                           PIPE_RESOURCE_FLAG_SPARSE | PIPE_RESOURCE_FLAG_ENCRYPTED |
+                           PIPE_RESOURCE_FLAG_UNMAPPABLE | PIPE_RESOURCE_FLAG_FRONTEND_VM)) ||
+       resource->nr_sparse_levels || resource->compression_rate ||
+       ctx->framebuffer.nr_cbufs > ARRAY_SIZE(ctx->framebuffer.cbufs) ||
+       ctx->framebuffer.zsbuf.texture == resource || ctx->framebuffer.resolve == resource)
+      return false;
+   for (unsigned index = 0; index < ctx->framebuffer.nr_cbufs; index++) {
+      if (ctx->framebuffer.cbufs[index].texture == resource)
+         return false;
+   }
+   unsigned last_level = util_logbase2(MAX2(resource->width0, resource->height0));
+   if (last_level >= MGC_HOST_FEATURES_TEXTURE_MAX_LEVELS ||
+       resource->last_level != last_level || sampler->max_lod < last_level)
+      return false;
+   struct mgc_resource *storage = mgc_resource(resource);
+   if (!storage->data || storage->active_maps || storage->active_host_executions)
+      return false;
+   unsigned blocksize = util_format_get_blocksize(resource->format);
+   texture->binding = pair->texture;
+   texture->texture_index = pair->texture;
+   texture->sampler_index = pair->sampler;
+   texture->last_level = last_level;
+   texture->filter = filter == PIPE_TEX_FILTER_NEAREST ? "nearest" : "linear";
+   texture->mip_filter = mip_filter == PIPE_TEX_MIPFILTER_LINEAR ? "linear" : "nearest";
+   texture->max_anisotropy = anisotropic ? MGC_HOST_FEATURES_TEXTURE_MAX_ANISOTROPY : 0;
+   for (unsigned index = 0; index <= last_level; index++) {
+      const struct mgc_resource_level *level = &storage->levels[index];
+      struct mgc_features_texture_level *snapshot = &texture->levels[index];
+      snapshot->width = u_minify(resource->width0, index);
+      snapshot->height = u_minify(resource->height0, index);
+      size_t row_bytes = snapshot->width * blocksize;
+      uint64_t span = (uint64_t)(snapshot->height - 1) * level->stride + row_bytes;
+      snapshot->size = row_bytes * snapshot->height;
+      if (snapshot->size > sizeof(snapshot->data) || level->width != snapshot->width ||
+          level->height != snapshot->height || level->layers != 1 ||
+          level->stride < row_bytes || level->layer_stride < span ||
+          level->offset > storage->size || span > storage->size - level->offset)
+         return false;
+      for (unsigned row = 0; row < snapshot->height; row++) {
+         memcpy(snapshot->data + row * row_bytes,
+                (const uint8_t *)storage->data + level->offset + (size_t)row * level->stride,
+                row_bytes);
+      }
+   }
+   return true;
+}
+
+static bool
+mgc_features_textures_snapshot(struct mgc_context *ctx,
+                                struct mgc_features_texture *textures, unsigned *count)
+{
+   const struct mgc_shader *shader = ctx->shaders[1]->shader;
+   unsigned bindings = shader->host_texture_bindings;
+   if (bindings > MGC_HOST_FEATURES_TEXTURE_MAX_BINDINGS)
+      return false;
+   struct pipe_resource *references[MGC_HOST_FEATURES_TEXTURE_MAX_BINDINGS] = {0};
+   bool valid = true;
+   *count = 0;
+   simple_mtx_lock(&ctx->screen->lock);
+   for (unsigned binding = 0; valid && binding < bindings; binding++) {
+      unsigned slot = shader->host_texture_binding[binding].texture;
+      if (slot >= MGC_HOST_FEATURES_TEXTURE_MAX_BINDINGS) {
+         valid = false;
+         break;
+      }
+      const struct pipe_sampler_view *view = ctx->sampler_views[1][slot];
+      if (view && view->texture)
+         pipe_resource_reference(&references[binding], view->texture);
+      valid = mgc_features_texture_snapshot_locked(ctx, binding, &textures[*count]);
+      if (valid)
+         (*count)++;
+   }
+   simple_mtx_unlock(&ctx->screen->lock);
+   for (unsigned binding = 0; binding < ARRAY_SIZE(references); binding++)
+      pipe_resource_reference(&references[binding], NULL);
+   return valid;
+}
