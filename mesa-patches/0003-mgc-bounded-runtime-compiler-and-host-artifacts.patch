+static bool
+mgc_json_base_metadata(struct mgc_layout_reader *reader, const char *key,
+                        const char *key_end, const char *value, const char *value_end)
+{
+   const char *names[] = {"\"input\"", "\"uniform\"", "\"vertex\"", "\"fragment\"", "\"texture\""};
+   const uint32_t bases[] = {reader->abi->input_base, reader->abi->uniform_base,
+                            reader->abi->vertex_output_base, reader->abi->fragment_output_base,
+                            reader->abi->texture_base};
+   unsigned count = reader->abi->host_features_version ? ARRAY_SIZE(names) : ARRAY_SIZE(names) - 1;
+   for (unsigned index = 0; index < count; index++) {
+      if (!mgc_json_text_equal(key, key_end, names[index]))
+         continue;
+      unsigned bit = 1u << index;
+      char expected[32];
+      int length = snprintf(expected, sizeof(expected), "%" PRIu32, bases[index]);
+      if (length < 0 || (size_t)length >= sizeof(expected) ||
+          (reader->base_metadata & bit) || !mgc_json_text_equal(value, value_end, expected))
+         return false;
+      reader->base_metadata |= bit;
+   }
+   return true;
+}
