+
+static bool
+mgc_executor_targets_valid(struct mgc_context *ctx, struct pipe_resource *color,
+                            struct pipe_resource *depth, unsigned expected_executions)
+{
+   const struct pipe_framebuffer_state *framebuffer = &ctx->framebuffer;
+   if (framebuffer->nr_cbufs != 1 || framebuffer->resolve || framebuffer->viewmask ||
+       framebuffer->layers > 1 || framebuffer->samples > 1 ||
+       framebuffer->zsbuf.texture != depth || (depth && depth == color))
+      return false;
+   return mgc_executor_resource_valid(ctx, color, &framebuffer->cbufs[0],
+      PIPE_FORMAT_R8G8B8A8_UNORM, 4, expected_executions) &&
+      (!depth || mgc_executor_resource_valid(ctx, depth, &framebuffer->zsbuf,
+         PIPE_FORMAT_Z16_UNORM, 2, expected_executions));
